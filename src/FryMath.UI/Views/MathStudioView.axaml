<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:FryMath.UI.ViewModels"
              xmlns:controls="using:FryMath.UI.Controls"
              xmlns:presets="using:FryMath.Core.Presets"
              xmlns:cas="using:FryMath.Core.CAS"
              xmlns:calc="using:FryMath.Core.Calculus"
              xmlns:millennium="using:FryMath.Core.Millennium"
              xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
              x:Class="FryMath.UI.Views.MathStudioView"
              x:DataType="vm:MainWindowViewModel"
              Background="{DynamicResource MathBgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FryMath.UI/Styles/Tokens/MathPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://FryMath.UI/Styles/MathStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 1. Top Ribbon & Wolfram Omnibar Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource MathSurfaceBrush}"
                BorderBrush="{DynamicResource MathBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- Row 1: Studio Identity, Centered Omnibar, Quick Save -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,8">

                    <!-- Studio Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                BorderBrush="{DynamicResource MathBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Width="30" Height="30">
                            <TextBlock Text="∑"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MathTextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FRYMATH"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{DynamicResource MathTextPrimaryBrush}" />
                            <TextBlock Text="Interactive Studio &amp; CAS"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource MathTextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Centered Spacious Wolfram-Style Omnibar Input -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" Width="520" ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Classes="omnibar"
                                 Text="{Binding OmnibarQuery, Mode=TwoWay}"
                                 PlaceholderText="Enter equation or command (e.g. x^3 - 3*x, sin(x), poincare)...">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding ExecuteOmnibarCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Classes="mathaction"
                                Command="{Binding ExecuteOmnibarCommand}"
                                Margin="8,0,0,0"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                <TextBlock Text="Compute &amp; Plot" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Quick Utilities -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Classes="mathaction"
                                Command="{Binding SaveCurrentStateAsPresetCommand}"
                                ToolTip.Tip="Save current configuration as custom preset"
                                Padding="8,6">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <material:MaterialIcon Kind="StarOutline" Width="14" Height="14" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                <TextBlock Text="Save Preset" FontSize="11" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Secondary Navigation Strip (Math Chips + Scrollable Lab Tabs) -->
                <Border Background="{DynamicResource MathBgBrush}"
                        BorderBrush="{DynamicResource MathBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,4">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <!-- Quick Math Symbol Chips -->
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="π" Content="π" ToolTip.Tip="Pi constant" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="e" Content="e" ToolTip.Tip="Euler's constant" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="sqrt()" Content="√x" ToolTip.Tip="Square root" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="^2" Content="x²" ToolTip.Tip="Square power" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="sin()" Content="sin" ToolTip.Tip="Sine" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="cos()" Content="cos" ToolTip.Tip="Cosine" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="exp()" Content="eˣ" ToolTip.Tip="Exponential" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="ln()" Content="ln" ToolTip.Tip="Natural log" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="z = " Content="z=" ToolTip.Tip="3D Surface" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="&lt;-y, x&gt;" Content="&lt;P,Q&gt;" ToolTip.Tip="Vector Field" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="[[1, 0], [0, 1]]" Content="[[M]]" ToolTip.Tip="2x2 Matrix" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="mandelbrot" Content="Mandelbrot" ToolTip.Tip="Fractals" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="chladni" Content="Chladni" ToolTip.Tip="Wave PDE" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="helix" Content="Helix" ToolTip.Tip="Space Curves 3D" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="zeta" Content="ζ(s)" ToolTip.Tip="Riemann Zeta &amp; Primes" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="heat" Content="Heat" ToolTip.Tip="2D Heat Diffusion" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="psi" Content="ψ(x)" ToolTip.Tip="Quantum Wave Mechanics" />
                                <Button Classes="mathchip" Command="{Binding InsertSymbolCommand}" CommandParameter="millennium" Content="👑 $7M" ToolTip.Tip="Clay Millennium Problems" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Vertical Divider -->
                        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource MathBorderBrush}" Margin="4,2,8,2" />

                        <!-- Horizontal Scrollable Laboratory Navigation Tabs -->
                        <ScrollViewer Grid.Column="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Visual Calculus">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="ChartBellCurve" Width="14" Height="14" />
                            <TextBlock Text="Calculus" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Linear Algebra">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="VectorRectangle" Width="14" Height="14" />
                            <TextBlock Text="Matrices" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Fourier &amp; Waves">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Waveform" Width="14" Height="14" />
                            <TextBlock Text="Waves" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Probability &amp; Stats">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="DotsGrid" Width="14" Height="14" />
                            <TextBlock Text="Plinko" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Dynamical Chaos">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="WeatherHurricane" Width="14" Height="14" />
                            <TextBlock Text="Chaos" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Vector Fields &amp; ODEs">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="WeatherWindy" Width="14" Height="14" />
                            <TextBlock Text="Flow &amp; ODEs" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Complex &amp; Conformal">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="CircleDouble" Width="14" Height="14" />
                            <TextBlock Text="Complex" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Surfaces &amp; 3D">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="CubeOutline" Width="14" Height="14" />
                            <TextBlock Text="3D Surfaces" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Fractals &amp; Chaos">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="ShapePlus" Width="14" Height="14" />
                            <TextBlock Text="Fractals" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="PDE &amp; Waves">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Waves" Width="14" Height="14" />
                            <TextBlock Text="PDE Waves" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Space Curves 3D">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="VectorPolyline" Width="14" Height="14" />
                            <TextBlock Text="Curves 3D" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Zeta &amp; Primes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Sigma" Width="14" Height="14" />
                            <TextBlock Text="Zeta &amp; Primes" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Heat &amp; Diffusion">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Fire" Width="14" Height="14" />
                            <TextBlock Text="Heat &amp; Diffusion" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Quantum &amp; Waves">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Atom" Width="14" Height="14" />
                            <TextBlock Text="Quantum" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Relativity &amp; Spacetime">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="RocketLaunch" Width="14" Height="14" />
                            <TextBlock Text="Relativity" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Fluid Dynamics">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="WeatherWindy" Width="14" Height="14" />
                            <TextBlock Text="Fluids" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Topology &amp; 4D Manifolds">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="CubeOutline" Width="14" Height="14" />
                            <TextBlock Text="4D Topology" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Celestial &amp; N-Body">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Orbit" Width="14" Height="14" />
                            <TextBlock Text="Celestial" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Hyperbolic Geometry">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="AngleAcute" Width="14" Height="14" />
                            <TextBlock Text="Hyperbolic" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Information &amp; Entropy">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="InformationOutline" Width="14" Height="14" />
                            <TextBlock Text="Information" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Classical Mechanics">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="AxisArrow" Width="14" Height="14" />
                            <TextBlock Text="Lagrangian" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Cryptography &amp; Finite Fields">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="KeyOutline" Width="14" Height="14" />
                            <TextBlock Text="Crypto" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Discrete Dynamics &amp; Chaos">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="ChartTimelineVariant" Width="14" Height="14" />
                            <TextBlock Text="Dynamics" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Bifurcation &amp; Catastrophe Theory">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="ChartBellCurveCumulative" Width="14" Height="14" />
                            <TextBlock Text="Catastrophe" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Clifford Geometric Algebra">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="VectorPolygon" Width="14" Height="14" />
                            <TextBlock Text="Clifford Algebra" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Differential Geometry">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Earth" Width="14" Height="14" />
                            <TextBlock Text="Differential Geometry" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Knot Theory &amp; Invariants">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="VectorPolyline" Width="14" Height="14" />
                            <TextBlock Text="Knot Theory" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Symplectic &amp; Hamiltonian">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="WeatherHurricane" Width="14" Height="14" />
                            <TextBlock Text="Symplectic &amp; Hamiltonian" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Algebraic Topology &amp; Homology">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="ShapePolygonPlus" Width="14" Height="14" />
                            <TextBlock Text="Algebraic Topology" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Lie Algebras &amp; Dynkin">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="AtomVariant" Width="14" Height="14" />
                            <TextBlock Text="Lie Algebras &amp; Dynkin" />
                        </StackPanel>
                    </Button>

                    <Button Classes="labtab"
                            Command="{Binding SelectLaboratoryCommand}"
                            CommandParameter="Millennium Problems">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="ShieldCrown" Width="14" Height="14" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                            <TextBlock Text="Millennium Problems" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</StackPanel>
</Border>

        <!-- 2. Main Studio Body -->
        <Grid Grid.Row="1" ColumnDefinitions="260,*,360">

            <!-- Left: Curated Lesson Presets Explorer -->
            <Border Grid.Column="0"
                    Background="{DynamicResource MathSurfaceBrush}"
                    BorderBrush="{DynamicResource MathBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,0,8">
                        <TextBlock Text="INTERACTIVE LESSONS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MathTextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="mathaction"
                                Command="{Binding SaveCurrentStateAsPresetCommand}"
                                ToolTip.Tip="Save current configuration as custom preset"
                                Padding="6,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <material:MaterialIcon Kind="Star" Width="12" Height="12" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                <TextBlock Text="Save State" FontSize="10" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Filter Search Box -->
                    <TextBox Grid.Row="1"
                             Text="{Binding PresetSearchFilter, Mode=TwoWay}"
                             PlaceholderText="Search lessons &amp; presets..."
                             FontSize="11"
                             Padding="8,5"
                             Margin="0,0,0,10"
                             CornerRadius="6"
                             Background="{DynamicResource MathSurfaceHighBrush}"
                             BorderBrush="{DynamicResource MathBorderBrush}" />

                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding FilteredPresets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="presets:MathPreset">
                                    <Border Classes="lessoncard" Margin="0,0,0,8">
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).LoadPresetCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <material:MaterialIcon Kind="{Binding IconKind}"
                                                                          Width="14" Height="14"
                                                                          Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MathTextMutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Center: Interactive Canvas (Swapped dynamically based on ActiveLaboratory) -->
            <Grid Grid.Column="1">

                <!-- Mode 1: Visual Calculus Canvas -->
                <controls:MathCanvas2D IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Visual Calculus'}"
                                       Functions="{Binding Functions}"
                                       ShowProbe="{Binding ShowProbe}"
                                       ShowTangent="{Binding ShowTangent}"
                                       ShowOsculating="{Binding ShowOsculating}"
                                       ShowRiemann="{Binding ShowRiemann}"
                                       ShowSecant="{Binding ShowSecant}"
                                       SecantDeltaX="{Binding SecantDeltaX}"
                                       ShowCriticalPoints="{Binding ShowCriticalPoints}"
                                       ShowSlopeField="{Binding ShowSlopeField}"
                                       ShowAreaBetweenCurves="{Binding ShowAreaBetweenCurves}"
                                       ShowTaylorSeries="{Binding ShowTaylorSeries}"
                                       TaylorDegree="{Binding TaylorDegree}"
                                       TaylorCenter="{Binding TaylorCenter}"
                                       ParamA="{Binding DynamicParamA}"
                                       ParamB="{Binding DynamicParamB}"
                                       ParamC="{Binding DynamicParamC}"
                                       RiemannN="{Binding RiemannN}"
                                       RiemannRule="{Binding RiemannRule}"
                                       IntegrationA="{Binding IntegrationA, Mode=TwoWay}"
                                       IntegrationB="{Binding IntegrationB, Mode=TwoWay}" />

                <!-- Mode 2: Linear Algebra Matrix Canvas -->
                <controls:MatrixTransformCanvas IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Linear Algebra'}"
                                               Matrix="{Binding Matrix, Mode=TwoWay}"
                                               MorphProgress="{Binding MorphProgress, Mode=TwoWay}"
                                               ShowUnitCircle="{Binding ShowUnitCircle}"
                                               ShowTestVector="{Binding ShowTestVector}"
                                               TestVector="{Binding TestVector, Mode=TwoWay}" />

                <!-- Mode 3: Fourier Epicycles Canvas -->
                <controls:EpicycleCanvas IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Fourier &amp; Waves'}"
                                        PresetName="{Binding FourierPreset}"
                                        HarmonicCount="{Binding Harmonics}"
                                        IsPlaying="{Binding IsWavePlaying}" />

                <!-- Mode 4: Galton Board Probability Canvas -->
                <controls:GaltonBoardCanvas x:Name="GaltonCanvas"
                                           IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Probability &amp; Stats'}"
                                           ProbabilityP="{Binding ProbabilityP}"
                                           IsContinuousDropping="{Binding IsPlinkoDropping}" />

                <!-- Mode 5: Dynamical Chaos 3D Canvas -->
                <controls:ChaosCanvas x:Name="ChaosCanvasVisual"
                                     IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Dynamical Chaos'}"
                                     ShowDualTrajectories="{Binding ShowChaosDualTrajectories}"
                                     Sigma="{Binding ChaosSigma}"
                                     Rho="{Binding ChaosRho}"
                                     Beta="{Binding ChaosBeta}" />

                <!-- Mode 6: Vector Fields & ODEs Canvas -->
                <controls:VectorFieldCanvas x:Name="VectorCanvas"
                                           IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Vector Fields &amp; ODEs'}"
                                           ExprP="{Binding VectorFieldP}"
                                           ExprQ="{Binding VectorFieldQ}"
                                           ShowArrows="{Binding VectorFieldShowArrows}"
                                           ShowParticles="{Binding VectorFieldShowParticles}"
                                           ParticleSpeed="{Binding VectorFieldParticleSpeed}" />

                <!-- Mode 7: Complex Analysis & Conformal Mapping Canvas -->
                <controls:ComplexDomainCanvas x:Name="ComplexCanvas"
                                             IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Complex &amp; Conformal'}"
                                             Preset="{Binding SelectedComplexPreset}"
                                             CustomFormula="{Binding ComplexCustomFormula}"
                                             ShowModulusContours="{Binding ComplexShowModulusContours}"
                                             ShowConformalGrid="{Binding ComplexShowConformalGrid}" />

                <!-- Mode 8: 3D Multivariable Calculus & Surfaces Canvas -->
                <controls:Surface3DCanvas x:Name="SurfaceCanvas"
                                         IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Surfaces &amp; 3D'}"
                                         Preset="{Binding SelectedSurfacePreset}"
                                         CustomFormula="{Binding SurfaceFormula}"
                                         ProbeX="{Binding SurfaceProbeX}"
                                         ProbeY="{Binding SurfaceProbeY}"
                                         ShowTangentPlane="{Binding SurfaceShowTangentPlane}"
                                         ShowWireframe="{Binding SurfaceShowWireframe}"
                                         ShowNormalVector="{Binding SurfaceShowNormalVector}" />

                <!-- Mode 9: Fractal Geometry & Complex Dynamics Canvas -->
                <controls:FractalCanvas x:Name="FractalCanvasCtrl"
                                        IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Fractals &amp; Chaos'}"
                                        FractalType="{Binding SelectedFractalType}"
                                        MaxIterations="{Binding FractalMaxIterations}"
                                        Palette="{Binding SelectedFractalPalette}"
                                        JuliaCr="{Binding FractalJuliaCr}"
                                        JuliaCi="{Binding FractalJuliaCi}"
                                        NewtonDegree="{Binding FractalNewtonDegree}" />

                <!-- Mode 10: 2D Wave Mechanics & Chladni Resonance Canvas -->
                <controls:WaveCanvas x:Name="WaveCanvasCtrl"
                                     IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='PDE &amp; Waves'}"
                                     SimulationMode="{Binding SelectedWaveMode}"
                                     ModeN="{Binding WaveModeN}"
                                     ModeM="{Binding WaveModeM}"
                                     Damping="{Binding WaveDamping}"
                                     ShowSandParticles="{Binding WaveShowSand}" />

                <!-- Mode 11: Differential Geometry & 3D Space Curves Canvas -->
                <controls:SpaceCurveCanvas x:Name="SpaceCurveCanvasCtrl"
                                           IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Space Curves 3D'}"
                                           Preset="{Binding SelectedSpaceCurvePreset}"
                                           ParamT="{Binding CurveParamT}"
                                           ShowFrenetFrame="{Binding CurveShowFrenetFrame}"
                                           ShowOsculatingPlane="{Binding CurveShowOsculatingPlane}"
                                           ShowOsculatingCircle="{Binding CurveShowOsculatingCircle}" />

                <!-- Mode 12: Riemann Zeta Function & Prime Distribution Canvas -->
                <controls:ZetaCanvas x:Name="ZetaCanvasCtrl"
                                     IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Zeta &amp; Primes'}"
                                     ViewMode="{Binding SelectedZetaMode}"
                                     ProbeT="{Binding ZetaProbeT, Mode=TwoWay}"
                                     ZeroCount="{Binding ZetaZeroCount}"
                                     XMax="{Binding ZetaXMax}"
                                     ShowZetaZeros="{Binding ZetaShowZeros}"
                                     ShowSmoothLi="{Binding ZetaShowSmoothLi}"
                                     ShowExplicitWave="{Binding ZetaShowExplicitWave}" />

                <!-- Mode 13: 2D Heat Diffusion & Laplace PDE Canvas -->
                <controls:HeatCanvas x:Name="HeatCanvasCtrl"
                                     IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Heat &amp; Diffusion'}"
                                     PresetName="{Binding HeatPreset}"
                                     Diffusivity="{Binding HeatDiffusivity}"
                                     ShowHeatFlux="{Binding HeatShowFlux}"
                                     ShowIsotherms="{Binding HeatShowIsotherms}"
                                     IsSimulating="{Binding HeatIsSimulating}" />

                <!-- Mode 14: Quantum Wave Mechanics & Schrödinger Equation Canvas -->
                <controls:QuantumCanvas x:Name="QuantumCanvasCtrl"
                                        IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Quantum &amp; Waves'}"
                                        PresetName="{Binding QuantumPreset}"
                                        ShowPhaseColoring="{Binding QuantumShowPhaseColoring}"
                                        ShowProbabilityDensity="{Binding QuantumShowProbabilityDensity}"
                                        ShowWaveComponents="{Binding QuantumShowWaveComponents}"
                                        ShowPotential="{Binding QuantumShowPotential}"
                                        TimeStep="{Binding QuantumTimeStep}"
                                        IsSimulating="{Binding QuantumIsSimulating}" />

                <!-- Mode 15: Special Relativity & Spacetime Minkowski Canvas -->
                <controls:MinkowskiCanvas x:Name="MinkowskiCanvasCtrl"
                                          IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Relativity &amp; Spacetime'}"
                                          PresetName="{Binding RelativityPreset}"
                                          Beta="{Binding RelativityBeta, Mode=TwoWay}"
                                          ShowHyperbolas="{Binding RelativityShowHyperbolas}"
                                          ShowLightCone="{Binding RelativityShowLightCone}"
                                          ShowSimultaneityGrid="{Binding RelativityShowSimultaneityGrid}"
                                          ShowWorldlines="{Binding RelativityShowWorldlines}"
                                          IsSimulating="{Binding RelativityIsSimulating}" />

                <!-- Mode 16: Fluid Dynamics & 2D Navier-Stokes Vorticity Canvas -->
                <controls:FluidCanvas x:Name="FluidCanvasCtrl"
                                      IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Fluid Dynamics'}"
                                      PresetName="{Binding FluidPreset}"
                                      Viscosity="{Binding FluidViscosity, Mode=TwoWay}"
                                      ShowVorticity="{Binding FluidShowVorticity}"
                                      ShowVelocityArrows="{Binding FluidShowVelocityArrows}"
                                      ShowStreamlines="{Binding FluidShowStreamlines}"
                                      ShowParticles="{Binding FluidShowParticles}"
                                      IsSimulating="{Binding FluidIsSimulating}" />

                <!-- Mode 17: Topology & 4D Hypersurface Manifolds Canvas -->
                <controls:Manifold4DCanvas x:Name="Manifold4DCanvasCtrl"
                                          IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Topology &amp; 4D Manifolds'}"
                                          PresetName="{Binding TopologyPreset}"
                                          RotationSpeed="{Binding TopologyRotationSpeed, Mode=TwoWay}"
                                          ShowVertices="{Binding TopologyShowVertices}"
                                          ShowDepthColoring="{Binding TopologyShowDepthColoring}"
                                          ShowStereographicSphere="{Binding TopologyShowStereographicSphere}"
                                          IsRotating="{Binding TopologyIsRotating}" />

                <!-- Mode 18: Celestial Mechanics & Gravitational N-Body Chaos Canvas -->
                <controls:CelestialCanvas x:Name="CelestialCanvasCtrl"
                                         IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Celestial &amp; N-Body'}"
                                         PresetName="{Binding CelestialPreset}"
                                         TimeStep="{Binding CelestialTimeStep, Mode=TwoWay}"
                                         ShowTrails="{Binding CelestialShowTrails}"
                                         ShowVelocityVectors="{Binding CelestialShowVelocityVectors}"
                                         ShowCenterOfMass="{Binding CelestialShowCenterOfMass}"
                                         ShowPotentialGrid="{Binding CelestialShowPotentialGrid}"
                                         IsSimulating="{Binding CelestialIsSimulating}" />

                <!-- Mode 19: Non-Euclidean Hyperbolic & Elliptic Geometry Canvas -->
                <controls:HyperbolicCanvas x:Name="HyperbolicCanvasCtrl"
                                          IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Hyperbolic Geometry'}"
                                          PresetName="{Binding HyperbolicPreset}"
                                          ModelName="{Binding HyperbolicModel}"
                                          TilingDepth="{Binding HyperbolicTilingDepth, Mode=TwoWay}"
                                          ShowTessellation="{Binding HyperbolicShowTessellation}"
                                          ShowVertices="{Binding HyperbolicShowVertices}"
                                          ShowInteractiveTriangle="{Binding HyperbolicShowInteractiveTriangle}" />

                <!-- Mode 20: Information Theory, Entropy & Signal Encoding Canvas -->
                <controls:InformationCanvas x:Name="InformationCanvasCtrl"
                                          IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Information &amp; Entropy'}"
                                          PresetName="{Binding InformationPreset}"
                                          ModeName="{Binding InformationMode}"
                                          SourceText="{Binding InformationSourceText, Mode=TwoWay}"
                                          ModulationName="{Binding InformationModulation}"
                                          SnrDb="{Binding InformationSnrDb, Mode=TwoWay}"
                                          CrossoverProbability="{Binding InformationCrossoverProbability, Mode=TwoWay}"
                                          ShowTreeBranches="{Binding InformationShowTreeBranches}"
                                          ShowProbabilityBars="{Binding InformationShowProbabilityBars}"
                                          ShowConstellationCloud="{Binding InformationShowConstellationCloud}" />

                <!-- Mode 21: Classical Mechanics, Lagrangian & Double Pendulum Chaos Canvas -->
                <controls:LagrangianCanvas x:Name="LagrangianCanvasCtrl"
                                          IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Classical Mechanics'}"
                                          PresetName="{Binding LagrangianPreset}"
                                          L1="{Binding LagrangianL1, Mode=TwoWay}"
                                          L2="{Binding LagrangianL2, Mode=TwoWay}"
                                          M1="{Binding LagrangianM1, Mode=TwoWay}"
                                          M2="{Binding LagrangianM2, Mode=TwoWay}"
                                          Gravity="{Binding LagrangianGravity, Mode=TwoWay}"
                                          Damping="{Binding LagrangianDamping, Mode=TwoWay}"
                                          ShowShadow="{Binding LagrangianShowShadow}"
                                          ShowTrails="{Binding LagrangianShowTrails}"
                                          ShowPhasePortrait="{Binding LagrangianShowPhasePortrait}"
                                          IsSimulating="{Binding LagrangianIsSimulating}" />

                <!-- Mode 22: Modern Cryptography, Elliptic Curves & Finite Fields Canvas -->
                <controls:EllipticCurveCanvas x:Name="EllipticCurveCanvasCtrl"
                                              IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Cryptography &amp; Finite Fields'}"
                                              DisplayMode="{Binding CryptoDisplayMode}"
                                              PresetName="{Binding CryptoPreset}"
                                              ParamA="{Binding CryptoParamA, Mode=TwoWay}"
                                              ParamB="{Binding CryptoParamB, Mode=TwoWay}"
                                              PrimeP="{Binding CryptoPrimeP, Mode=TwoWay}"
                                              FiniteA="{Binding CryptoFiniteA, Mode=TwoWay}"
                                              FiniteB="{Binding CryptoFiniteB, Mode=TwoWay}"
                                              ShowTangentSecant="{Binding CryptoShowTangentSecant, Mode=TwoWay}"
                                              ShowReflectionLines="{Binding CryptoShowReflectionLines, Mode=TwoWay}"
                                              AlicePrivateKey="{Binding CryptoAlicePrivateKey, Mode=TwoWay}"
                                              BobPrivateKey="{Binding CryptoBobPrivateKey, Mode=TwoWay}"
                                              ScalarK="{Binding CryptoScalarK, Mode=TwoWay}" />

                <!-- Mode 23: Discrete Dynamical Systems, Arnold's Cat Map & IFS Canvas -->
                <controls:DiscreteDynamicsCanvas x:Name="DiscreteDynamicsCanvasCtrl"
                                                 IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Discrete Dynamics &amp; Chaos'}"
                                                 DisplayMode="{Binding DiscreteDynamicsDisplayMode}"
                                                 PresetName="{Binding DiscreteDynamicsPreset}"
                                                 LogisticR="{Binding DiscreteDynamicsLogisticR, Mode=TwoWay}"
                                                 LogisticX0="{Binding DiscreteDynamicsLogisticX0, Mode=TwoWay}"
                                                 CobwebSteps="{Binding DiscreteDynamicsCobwebSteps, Mode=TwoWay}"
                                                 IfsPreset="{Binding DiscreteDynamicsIfsPreset, Mode=TwoWay}"
                                                 CatStep="{Binding DiscreteDynamicsCatStep, Mode=TwoWay}"
                                                 ShowEigenvectorRays="{Binding DiscreteDynamicsShowEigenvectors, Mode=TwoWay}" />

                <!-- Mode 24: Bifurcation & Catastrophe Theory Canvas -->
                <controls:CatastropheCanvas x:Name="CatastropheCanvasCtrl"
                                            IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Bifurcation &amp; Catastrophe Theory'}"
                                            CatastropheMode="{Binding CatastropheMode}"
                                            PresetName="{Binding CatastrophePreset}"
                                            ParamA="{Binding CatastropheParamA, Mode=TwoWay}"
                                            ParamB="{Binding CatastropheParamB, Mode=TwoWay}"
                                            StateX="{Binding CatastropheStateX, Mode=TwoWay}"
                                            ShowBifurcationSet="{Binding CatastropheShowBifurcationSet, Mode=TwoWay}"
                                            ShowPotentialWell="{Binding CatastropheShowPotentialWell, Mode=TwoWay}"
                                            ShowEquilibriumSurface="{Binding CatastropheShowEquilibriumSurface, Mode=TwoWay}" />

                <!-- Mode 25: Clifford Geometric Algebra & Multivector Calculus Canvas -->
                <controls:CliffordCanvas x:Name="CliffordCanvasCtrl"
                                         IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Clifford Geometric Algebra'}"
                                         CliffordMode="{Binding CliffordMode}"
                                         PresetName="{Binding CliffordPreset}"
                                         VectorAX="{Binding CliffordVectorAX, Mode=TwoWay}"
                                         VectorAY="{Binding CliffordVectorAY, Mode=TwoWay}"
                                         VectorAZ="{Binding CliffordVectorAZ, Mode=TwoWay}"
                                         VectorBX="{Binding CliffordVectorBX, Mode=TwoWay}"
                                         VectorBY="{Binding CliffordVectorBY, Mode=TwoWay}"
                                         VectorBZ="{Binding CliffordVectorBZ, Mode=TwoWay}"
                                         RotorAngle="{Binding CliffordRotorAngle, Mode=TwoWay}"
                                         ReflectionAngle="{Binding CliffordReflectionAngle, Mode=TwoWay}"
                                         ShowBivectorDisk="{Binding CliffordShowBivectorDisk, Mode=TwoWay}"
                                         ShowDualNormal="{Binding CliffordShowDualNormal, Mode=TwoWay}"
                                         ShowMultivectorGrades="{Binding CliffordShowMultivectorGrades, Mode=TwoWay}"
                                         ShowRotorArc="{Binding CliffordShowRotorArc, Mode=TwoWay}" />

                <!-- Mode 26: Differential Geometry, Geodesics & Curvature Canvas -->
                <controls:GeodesicCanvas x:Name="GeodesicCanvasCtrl"
                                         IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Differential Geometry'}"
                                         SurfaceType="{Binding DiffGeomSurfaceType}"
                                         PresetName="{Binding DiffGeomPreset}"
                                         StartU="{Binding DiffGeomStartU, Mode=TwoWay}"
                                         StartV="{Binding DiffGeomStartV, Mode=TwoWay}"
                                         HeadingAngle="{Binding DiffGeomHeadingAngle, Mode=TwoWay}"
                                         DeformationAngle="{Binding DiffGeomDeformationAngle, Mode=TwoWay}"
                                         ShowCurvatureHeatmap="{Binding DiffGeomShowCurvatureHeatmap, Mode=TwoWay}"
                                         ShowGeodesicRay="{Binding DiffGeomShowGeodesicRay, Mode=TwoWay}"
                                         ShowNormalVector="{Binding DiffGeomShowNormalVector, Mode=TwoWay}"
                                         ShowChristoffelMatrix="{Binding DiffGeomShowChristoffelMatrix, Mode=TwoWay}" />

                <!-- Mode 27: Knot Theory, Braids & 3D Topological Invariants Canvas -->
                <controls:KnotCanvas x:Name="KnotCanvasCtrl"
                                     IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Knot Theory &amp; Invariants'}"
                                     KnotType="{Binding KnotType}"
                                     PresetName="{Binding KnotPreset}"
                                     TubeRadius="{Binding KnotTubeRadius, Mode=TwoWay}"
                                     TorusP="{Binding KnotTorusP, Mode=TwoWay}"
                                     TorusQ="{Binding KnotTorusQ, Mode=TwoWay}"
                                     BraidWord="{Binding KnotBraidWord, Mode=TwoWay}"
                                     Show3DTube="{Binding KnotShow3DTube, Mode=TwoWay}"
                                     ShowPlanarProjection="{Binding KnotShowPlanarProjection, Mode=TwoWay}"
                                     ShowPolynomialCard="{Binding KnotShowPolynomialCard, Mode=TwoWay}"
                                     ShowBraidDiagram="{Binding KnotShowBraidDiagram, Mode=TwoWay}" />

                <!-- Mode 28: Symplectic Geometry, Hamiltonian Mechanics & Phase Space Invariants Canvas -->
                <controls:HamiltonianCanvas x:Name="HamiltonianCanvasCtrl"
                                            IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Symplectic &amp; Hamiltonian'}"
                                            SystemType="{Binding HamiltonSystemType}"
                                            PresetName="{Binding HamiltonPreset}"
                                            EnergyLevel="{Binding HamiltonEnergyLevel, Mode=TwoWay}"
                                            IntegratorMode="{Binding HamiltonIntegratorMode, Mode=TwoWay}"
                                            TimeStep="{Binding HamiltonTimeStep, Mode=TwoWay}"
                                            ShowPoincareSection="{Binding HamiltonShowPoincareSection, Mode=TwoWay}"
                                            ShowPotentialContours="{Binding HamiltonShowPotentialContours, Mode=TwoWay}"
                                            ShowEnergyErrorGraph="{Binding HamiltonShowEnergyErrorGraph, Mode=TwoWay}"
                                            ShowLiouvilleDroplet="{Binding HamiltonShowLiouvilleDroplet, Mode=TwoWay}" />

                <!-- Mode 29: Algebraic Topology, Simplicial Homology & Persistent Betti Numbers Canvas -->
                <controls:HomologyCanvas x:Name="HomologyCanvasCtrl"
                                         IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Algebraic Topology &amp; Homology'}"
                                         ComplexType="{Binding HomologyComplexType}"
                                         PresetName="{Binding HomologyPreset}"
                                         FiltrationRadius="{Binding HomologyFiltrationRadius, Mode=TwoWay}"
                                         ShowGeneratorCycles="{Binding HomologyShowGeneratorCycles, Mode=TwoWay}"
                                         ShowBoundaryMatrix="{Binding HomologyShowBoundaryMatrix, Mode=TwoWay}"
                                         ShowPersistenceBarcodes="{Binding HomologyShowPersistenceBarcodes, Mode=TwoWay}"
                                         ShowVertexLabels="{Binding HomologyShowVertexLabels, Mode=TwoWay}" />

                <!-- Mode 30: Lie Algebras, Root Systems & Dynkin Diagrams Canvas -->
                <controls:LieAlgebraCanvas x:Name="LieAlgebraCanvasCtrl"
                                           IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Lie Algebras &amp; Dynkin'}"
                                           LieType="{Binding LieType}"
                                           ShowDynkinDiagram="{Binding LieShowDynkinDiagram, Mode=TwoWay}"
                                           ShowCartanMatrix="{Binding LieShowCartanMatrix, Mode=TwoWay}"
                                           ShowCoxeterCircles="{Binding LieShowCoxeterCircles, Mode=TwoWay}"
                                           ShowRootLabels="{Binding LieShowRootLabels, Mode=TwoWay}"
                                           CameraYaw="{Binding LieCameraYaw, Mode=TwoWay}"
                                           CameraPitch="{Binding LieCameraPitch, Mode=TwoWay}" />

                <!-- Mode 31: Clay Millennium Prize Problems & Solutions Canvas -->
                <controls:MillenniumCanvas x:Name="MillenniumCanvasCtrl"
                                           IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Millennium Problems'}"
                                           ProblemType="{Binding SelectedMillenniumProblem}"
                                           RicciTime="{Binding MillenniumRicciTime, Mode=TwoWay}"
                                           BsdParamA="{Binding MillenniumBsdParamA, Mode=TwoWay}"
                                           BsdParamB="{Binding MillenniumBsdParamB, Mode=TwoWay}"
                                           NavierViscosity="{Binding MillenniumNavierViscosity, Mode=TwoWay}"
                                           NavierTime="{Binding MillenniumNavierTime, Mode=TwoWay}"
                                           YangMillsBeta="{Binding MillenniumYangMillsBeta, Mode=TwoWay}"
                                           SatAlpha="{Binding MillenniumSatAlpha, Mode=TwoWay}"
                                           SatVars="{Binding MillenniumSatVars, Mode=TwoWay}"
                                           HodgeVariety="{Binding MillenniumHodgeVariety, Mode=TwoWay}"
                                           ShowTheoryOverlay="{Binding MillenniumShowTheoryOverlay, Mode=TwoWay}"
                                           ShowInvariantTelemetry="{Binding MillenniumShowInvariantTelemetry, Mode=TwoWay}"
                                           RiemannAttack="{Binding SelectedRiemannAttack, Mode=TwoWay}"
                                           RiemannDeBruijnT="{Binding RiemannDeBruijnT, Mode=TwoWay}"
                                           RiemannLiMaxN="{Binding RiemannLiMaxN, Mode=TwoWay}"
                                           RiemannHunterTMin="{Binding RiemannHunterTMin, Mode=TwoWay}"
                                           RiemannHunterTMax="{Binding RiemannHunterTMax, Mode=TwoWay}" />
            </Grid>

            <!-- Right: Dynamic Mode-Specific Inspector & Textbook Derivations Drawer -->
            <Border Grid.Column="2"
                    Background="{DynamicResource MathSurfaceBrush}"
                    BorderBrush="{DynamicResource MathBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="14">
                <ScrollViewer>
                    <StackPanel Spacing="16">

                        <!-- ======================================================== -->
                        <!-- DRAWER 1: VISUAL CALCULUS INSPECTOR                      -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Visual Calculus'}" Spacing="14">

                            <!-- Multi-Function Manager -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="FUNCTIONS &amp; CURVES"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <Button Grid.Column="1"
                                                Classes="mathaction"
                                                Padding="6,3"
                                                Command="{Binding AddFunctionCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <material:MaterialIcon Kind="Plus" Width="12" Height="12" />
                                                <TextBlock Text="Add" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Functions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FunctionItemViewModel">
                                                <Border Background="{DynamicResource MathSurfaceBrush}"
                                                        BorderBrush="{DynamicResource MathBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource MathRadiusSm}"
                                                        Padding="8"
                                                        Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" Margin="0,0,6,0" />
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding ExpressionText, Mode=TwoWay}"
                                                                 FontSize="12"
                                                                 Padding="6,4"
                                                                 Background="{DynamicResource MathSurfaceHighBrush}"
                                                                 BorderThickness="1"
                                                                 BorderBrush="{DynamicResource MathBorderBrush}" />
                                                        <CheckBox Grid.Column="2"
                                                                  IsChecked="{Binding ShowDerivative}"
                                                                  ToolTip.Tip="Show Derivative Curve (Dashed)"
                                                                  Margin="6,0,0,0">
                                                            <TextBlock Text="d/dx" FontSize="10" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                                        </CheckBox>
                                                        <Button Grid.Column="3"
                                                                Classes="mathaction"
                                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveFunctionCommand}"
                                                                CommandParameter="{Binding}"
                                                                Margin="6,0,0,0"
                                                                Padding="4,2">
                                                            <material:MaterialIcon Kind="Close" Width="10" Height="10" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <CheckBox IsChecked="{Binding ShowAreaBetweenCurves}" Content="Shade Area Between Curves" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <!-- Dynamic Parameter Explorer (a, b, c) -->
                            <Border Classes="builderbox">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="DYNAMIC PARAMETER EXPLORER"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Real-time CAS"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MathTextMutedBrush}" />
                                    </Grid>

                                    <!-- Parameter a -->
                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Parameter a:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DynamicParamA, StringFormat='{}a = {0:F2}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </Grid>
                                        <Slider Minimum="-5.0" Maximum="5.0" Value="{Binding DynamicParamA}" />
                                    </StackPanel>

                                    <!-- Parameter b -->
                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Parameter b:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DynamicParamB, StringFormat='{}b = {0:F2}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </Grid>
                                        <Slider Minimum="-5.0" Maximum="5.0" Value="{Binding DynamicParamB}" />
                                    </StackPanel>

                                    <!-- Quick Formula Symbol Chips -->
                                    <TextBlock Text="QUICK INSERT CHIPS (PRIMARY CURVE)"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               Margin="0,4,0,0" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="quickchip" Command="{Binding InsertSymbolIntoPrimaryCurveCommand}" CommandParameter="x" Content="x" />
                                        <Button Classes="quickchip" Command="{Binding InsertSymbolIntoPrimaryCurveCommand}" CommandParameter="a" Content="a" />
                                        <Button Classes="quickchip" Command="{Binding InsertSymbolIntoPrimaryCurveCommand}" CommandParameter="x^2" Content="x²" />
                                        <Button Classes="quickchip" Command="{Binding InsertSymbolIntoPrimaryCurveCommand}" CommandParameter="sin(x)" Content="sin(x)" />
                                        <Button Classes="quickchip" Command="{Binding InsertSymbolIntoPrimaryCurveCommand}" CommandParameter="cos(x)" Content="cos(x)" />
                                        <Button Classes="quickchip" Command="{Binding InsertSymbolIntoPrimaryCurveCommand}" CommandParameter="exp(x)" Content="eˣ" />
                                        <Button Classes="quickchip" Command="{Binding InsertSymbolIntoPrimaryCurveCommand}" CommandParameter="ln(x)" Content="ln(x)" />
                                        <Button Classes="quickchip" Command="{Binding InsertSymbolIntoPrimaryCurveCommand}" CommandParameter="sqrt(x)" Content="√x" />
                                        <Button Classes="quickchip" Command="{Binding InsertSymbolIntoPrimaryCurveCommand}" CommandParameter="1/x" Content="1/x" />
                                    </WrapPanel>

                                    <!-- Curve Preset Gallery -->
                                    <TextBlock Text="CURVE PRESET GALLERY"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               Margin="0,4,0,0" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="actionpill" Command="{Binding AddPresetCurveCommand}" CommandParameter="x^3 - 3*x" Content="Cubic x³-3x" Margin="0,0,4,4" />
                                        <Button Classes="actionpill" Command="{Binding AddPresetCurveCommand}" CommandParameter="exp(-x^2)" Content="Gaussian e^(-x²)" Margin="0,0,4,4" />
                                        <Button Classes="actionpill" Command="{Binding AddPresetCurveCommand}" CommandParameter="exp(-0.2*x)*sin(5*x)" Content="Damped Osc" Margin="0,0,4,4" />
                                        <Button Classes="actionpill" Command="{Binding AddPresetCurveCommand}" CommandParameter="1 / (1 + 25*x^2)" Content="Runge 1/(1+25x²)" Margin="0,0,4,4" />
                                        <Button Classes="actionpill" Command="{Binding AddPresetCurveCommand}" CommandParameter="a * sin(b * x)" Content="Param a·sin(bx)" Margin="0,0,4,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Textbook Definite Integral Card -->
                            <controls:TextbookFormulaCard Mode="Integral" IntegralInfo="{Binding IntegralInfo}" />

                            <!-- Textbook Derivative Leibniz Card -->
                            <controls:TextbookFormulaCard Mode="Derivative" DerivativeInfo="{Binding DerivativeInfo}" />

                            <!-- CAS Symbolic Antiderivative Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="CAS SYMBOLIC ANTIDERIVATIVE"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="CLOSED FORM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="∫ f(x) dx =" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AnalyticalAntiderivative}"
                                                   FontSize="13"
                                                   FontFamily="Consolas,Menlo,Monospace"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="Fundamental Theorem of Calculus: d/dx [∫ f(t) dt] = f(x)"
                                               FontSize="9"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Secant to Tangent Limiting Tool -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="SECANT-TO-TANGENT MORPHING"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <CheckBox IsChecked="{Binding ShowSecant}" Content="Show Secant Line &amp; Slope Triangle" FontSize="11" />

                                    <StackPanel IsVisible="{Binding ShowSecant}" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Limit Step (Δx → 0):" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SecantDeltaX, StringFormat='{}{0:F3}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </Grid>
                                        <Slider Minimum="0.01" Maximum="2.5" Value="{Binding SecantDeltaX}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Dynamic Parameter Sliders with Animation -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="DYNAMIC PARAMETER SLIDERS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <ItemsControl ItemsSource="{Binding Parameters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DynamicParameterViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name, StringFormat='{}{0} ='}" FontWeight="Bold" FontSize="11" Width="24" VerticalAlignment="Center" />
                                                    <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay}" Margin="6,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat='{}{0:F2}'}" FontSize="10" Width="36" VerticalAlignment="Center" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                                    <Button Grid.Column="3"
                                                            Classes="mathaction"
                                                            Command="{Binding ToggleAnimationCommand}"
                                                            Padding="4,2"
                                                            Margin="4,0,0,0">
                                                        <material:MaterialIcon Kind="{Binding PlayPauseIcon}" Width="12" Height="12" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Visualization Toggles -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="ANALYSIS OVERLAYS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               Margin="0,0,0,4" />

                                    <CheckBox IsChecked="{Binding ShowTangent}" Content="Tangent Line &amp; Slope Angle" FontSize="11" />
                                    <CheckBox IsChecked="{Binding ShowOsculating}" Content="Osculating Curvature Circle" FontSize="11" />
                                    <CheckBox IsChecked="{Binding ShowCriticalPoints}" Content="Roots, Extrema &amp; Inflection Badges" FontSize="11" />
                                    <CheckBox IsChecked="{Binding ShowSlopeField}" Content="Directional Slope Field (y' = f(x))" FontSize="11" />
                                    <CheckBox IsChecked="{Binding ShowRiemann}" Content="Riemann Darboux Partitions" FontSize="11" />

                                    <StackPanel IsVisible="{Binding ShowRiemann}" Spacing="6" Margin="0,4,0,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Partitions (N):" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding RiemannN}" FontSize="10" FontWeight="Bold" />
                                        </Grid>
                                        <Slider Minimum="2" Maximum="100" Value="{Binding RiemannN}" />
                                    </StackPanel>

                                    <CheckBox IsChecked="{Binding ShowTaylorSeries}" Content="Taylor Series Polynomial Pₙ(x)" FontSize="11" />

                                    <StackPanel IsVisible="{Binding ShowTaylorSeries}" Spacing="6" Margin="0,4,0,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Degree (N):" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TaylorDegree}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </Grid>
                                        <Slider Minimum="0" Maximum="8" Value="{Binding TaylorDegree}" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Expansion Center (x₀):" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TaylorCenter, StringFormat='{}{0:F1}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        </Grid>
                                        <Slider Minimum="-5" Maximum="5" Value="{Binding TaylorCenter}" />

                                        <TextBlock Text="{Binding TaylorFormula}"
                                                   FontSize="10"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Step-by-Step Derivation Breakdown -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="STEP-BY-STEP DERIVATION"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <ItemsControl ItemsSource="{Binding DerivationSteps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="cas:DerivationStep">
                                                <Border Background="{DynamicResource MathSurfaceBrush}"
                                                        BorderBrush="{DynamicResource MathBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource MathRadiusSm}"
                                                        Padding="8"
                                                        Margin="0,0,0,6">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding RuleName}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding ExpressionAfter}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Rationale}"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource MathTextMutedBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 2: LINEAR ALGEBRA INSPECTOR                       -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Linear Algebra'}" Spacing="14">

                            <!-- Textbook Matrix Card -->
                            <controls:TextbookFormulaCard Mode="Matrix" MatrixInfo="{Binding MatrixInfo}" />

                            <!-- Interactive Matrix Construction Studio -->
                            <Border Classes="builderbox">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="INTERACTIVE MATRIX BUILDER (A ∈ ℝ²ˣ²)"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding MatrixInfo.Determinant, StringFormat='{}det(A) = {0:F2}'}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>

                                    <!-- 2x2 Numeric Inputs Matrix Grid -->
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,2">
                                        <Border Grid.Row="0" Grid.Column="0" Classes="matrixcell" Margin="0,0,3,3">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="a₁₁:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                                                <NumericUpDown Grid.Column="1" Value="{Binding MatrixM11}" Increment="0.25" FormatString="F2" Padding="4,2" FontSize="11" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Classes="matrixcell" Margin="3,0,0,3">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="a₁₂:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                                                <NumericUpDown Grid.Column="1" Value="{Binding MatrixM12}" Increment="0.25" FormatString="F2" Padding="4,2" FontSize="11" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Classes="matrixcell" Margin="0,3,3,0">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="a₂₁:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                                                <NumericUpDown Grid.Column="1" Value="{Binding MatrixM21}" Increment="0.25" FormatString="F2" Padding="4,2" FontSize="11" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Classes="matrixcell" Margin="3,3,0,0">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="a₂₂:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" VerticalAlignment="Center" Margin="4,0" />
                                                <NumericUpDown Grid.Column="1" Value="{Binding MatrixM22}" Increment="0.25" FormatString="F2" Padding="4,2" FontSize="11" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Matrix Algebra Operations -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="actionpill" Command="{Binding TransposeMatrixCommand}" Content="Transpose (Aᵀ)" Margin="0,0,4,4" />
                                        <Button Classes="actionpill" Command="{Binding InvertMatrixCommand}" Content="Invert (A⁻¹)" Margin="0,0,4,4" />
                                        <Button Classes="actionpill" Command="{Binding NegateMatrixCommand}" Content="Negate (-A)" Margin="0,0,4,4" />
                                        <Button Classes="actionpill" Command="{Binding ResetIdentityMatrixCommand}" Content="Reset (I)" Margin="0,0,4,4" />
                                        <Button Classes="actionpill" Command="{Binding SetSymmetricSqueezeCommand}" Content="Squeeze" Margin="0,0,4,4" />
                                    </WrapPanel>

                                    <!-- Test Vector Transformation Calculator -->
                                    <Border Background="#120E22" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="VECTOR TRANSFORMATION: v = A u" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="0,2">
                                                <TextBlock Text="u₁:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <NumericUpDown Grid.Column="1" Value="{Binding TestVectorU1}" Increment="0.2" FormatString="F2" Padding="4,2" FontSize="10" Margin="0,0,6,0" />
                                                <TextBlock Grid.Column="2" Text="u₂:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <NumericUpDown Grid.Column="3" Value="{Binding TestVectorU2}" Increment="0.2" FormatString="F2" Padding="4,2" FontSize="10" />
                                            </Grid>
                                            <TextBlock Text="{Binding TransformedVectorV1, StringFormat='{}Result: v = [{0:F2}, {1:F2}]'}"
                                                       FontSize="10" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 3Blue1Brown Grid Morphing Controls -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="GRID MORPH INTERPOLATION (I → A)"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Slider Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding MorphProgress, Mode=TwoWay}" />
                                        <Button Grid.Column="1"
                                                Classes="mathaction"
                                                Command="{Binding ToggleMorphAnimationCommand}"
                                                Margin="8,0,0,0"
                                                Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <material:MaterialIcon Kind="{Binding MorphPlayPauseIcon}" Width="14" Height="14" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding MorphPlayPauseIcon}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Watch the Cartesian grid smoothly morph into Matrix A's column space."
                                               FontSize="10"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Transformation Presets -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="TRANSFORMATION PRESETS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="mathaction" Command="{Binding SetMatrixPresetCommand}" CommandParameter="rotation45" Content="45° Rotate" Margin="0,0,6,6" />
                                        <Button Classes="mathaction" Command="{Binding SetMatrixPresetCommand}" CommandParameter="rotation90" Content="90° Rotate" Margin="0,0,6,6" />
                                        <Button Classes="mathaction" Command="{Binding SetMatrixPresetCommand}" CommandParameter="shearX" Content="Horizontal Shear" Margin="0,0,6,6" />
                                        <Button Classes="mathaction" Command="{Binding SetMatrixPresetCommand}" CommandParameter="shearY" Content="Vertical Shear" Margin="0,0,6,6" />
                                        <Button Classes="mathaction" Command="{Binding SetMatrixPresetCommand}" CommandParameter="scale" Content="Anisotropic Scale" Margin="0,0,6,6" />
                                        <Button Classes="mathaction" Command="{Binding SetMatrixPresetCommand}" CommandParameter="reflection" Content="Diagonal Reflect" Margin="0,0,6,6" />
                                        <Button Classes="mathaction" Command="{Binding SetMatrixPresetCommand}" CommandParameter="singular" Content="Singular Collapse" Margin="0,0,6,6" />
                                        <Button Classes="mathaction" Command="{Binding SetMatrixPresetCommand}" CommandParameter="identity" Content="Reset Identity" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Overlays -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="6">
                                    <CheckBox IsChecked="{Binding ShowUnitCircle}" Content="Show Unit Circle &amp; SVD Ellipse" FontSize="11" />
                                    <CheckBox IsChecked="{Binding ShowTestVector}" Content="Show Draggable Test Vector (u → Au)" FontSize="11" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 3: FOURIER WAVES INSPECTOR                        -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Fourier &amp; Waves'}" Spacing="14">

                            <!-- Waveform & Epicycle Presets -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="FOURIER EPICYCLE PRESETS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel Margin="0,0,0,4">
                                        <Button Classes="mathaction" Margin="0,0,4,4" Command="{Binding SetFourierPresetCommand}" CommandParameter="heart">
                                            <TextBlock Text="❤️ Heart" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Command="{Binding SetFourierPresetCommand}" CommandParameter="star">
                                            <TextBlock Text="⭐ Star" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Command="{Binding SetFourierPresetCommand}" CommandParameter="infinity">
                                            <TextBlock Text="♾️ Infinity" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Command="{Binding SetFourierPresetCommand}" CommandParameter="square">
                                            <TextBlock Text="🔲 Square" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Command="{Binding SetFourierPresetCommand}" CommandParameter="sawtooth">
                                            <TextBlock Text="📐 Sawtooth" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Command="{Binding SetFourierPresetCommand}" CommandParameter="triangle">
                                            <TextBlock Text="🔺 Triangle" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Command="{Binding SetFourierPresetCommand}" CommandParameter="trefoil">
                                            <TextBlock Text="🪢 Trefoil" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Command="{Binding SetFourierPresetCommand}" CommandParameter="pi">
                                            <TextBlock Text="π Pi Glyph" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Command="{Binding SetFourierPresetCommand}" CommandParameter="fhole">
                                            <TextBlock Text="🎻 F-Hole" FontSize="11" />
                                        </Button>
                                    </WrapPanel>

                                    <!-- Freehand Pen Instruction -->
                                    <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource MathBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource MathRadiusSm}"
                                            Padding="8">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="✏️ FREEHAND PEN DRAWING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            <TextBlock Text="Click &amp; drag on the canvas to draw any shape or closed contour. Upon mouse release, the DFT decomposes it into rotating epicycles!"
                                                       FontSize="9" Foreground="{DynamicResource MathTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Harmonics Control -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="HARMONIC COEFFICIENTS (N):" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Harmonics}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="45" Value="{Binding Harmonics}" />
                                </StackPanel>
                            </Border>

                            <!-- Harmonic Series Synthesizer & Spectral Invariant Monitor -->
                            <Border Classes="builderbox">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="SPECTRUM &amp; THD"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource MathSurfaceBrush}"
                                                CornerRadius="{DynamicResource MathRadiusSm}"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding FourierThdStatus}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding FourierWaveformSynthesis}"
                                               FontSize="11"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <Grid ColumnDefinitions="*,*" Margin="0,2">
                                        <Border Grid.Column="0" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="8,4" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding FourierTotalHarmonicDistortion}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextLightBrush}" />
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="8,4" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding FourierSpectralEnergy}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Quick Waveform Filter Pills -->
                                    <TextBlock Text="HARMONIC SELECTIVITY &amp; FILTERING:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,4,0,0" />
                                    <WrapPanel>
                                        <Button Classes="quickchip" Content="Odd (Square)" Command="{Binding SetHarmonicFilterCommand}" CommandParameter="odd" />
                                        <Button Classes="quickchip" Content="All (Sawtooth)" Command="{Binding SetHarmonicFilterCommand}" CommandParameter="even" />
                                        <Button Classes="quickchip" Content="1/n² (Triangle)" Command="{Binding SetHarmonicFilterCommand}" CommandParameter="triangle" />
                                        <Button Classes="quickchip" Content="Low-Pass (N=5)" Command="{Binding SetHarmonicFilterCommand}" CommandParameter="lowpass" />
                                        <Button Classes="quickchip" Content="Full Band (N=35)" Command="{Binding SetHarmonicFilterCommand}" CommandParameter="all" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Audio Synthesizer -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="LIVE PCM AUDIO SYNTHESIS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Button Classes="mathaction"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding ToggleAudioPlaybackCommand}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <material:MaterialIcon Kind="VolumeHigh" Width="16" Height="16" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            <TextBlock Text="Play Waveform Audio (220 Hz)" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 4: PROBABILITY & STATS INSPECTOR                  -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Probability &amp; Stats'}" Spacing="14">

                            <!-- Plinko Controls -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CENTRAL LIMIT THEOREM (PLINKO)"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Success Probability (p):" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProbabilityP, StringFormat='{}{0:F2}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.1" Maximum="0.9" Value="{Binding ProbabilityP}" />

                                    <CheckBox IsChecked="{Binding IsPlinkoDropping}" Content="Continuous Gravity Drop" FontSize="11" />

                                    <Grid ColumnDefinitions="*,*">
                                        <Button Grid.Column="0"
                                                Classes="mathaction"
                                                Command="{Binding DropPlinkoBurstCommand}"
                                                Margin="0,0,4,0"
                                                Padding="6,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                                <material:MaterialIcon Kind="WaterPercent" Width="14" Height="14" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                                <TextBlock Text="Drop 35 Balls" FontSize="10" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Classes="mathaction"
                                                Command="{Binding ResetPlinkoCommand}"
                                                Margin="4,0,0,0"
                                                Padding="6,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                                <material:MaterialIcon Kind="Restart" Width="14" Height="14" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                                <TextBlock Text="Reset Board" FontSize="10" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Distribution Parameter Explorer & Information Invariants -->
                            <Border Classes="builderbox">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="DISTRIBUTION INVARIANTS"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource MathSurfaceBrush}"
                                                CornerRadius="{DynamicResource MathRadiusSm}"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding StatSkewnessStatus}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Invariant Metric Badges (Mean, Variance, StdDev, Entropy) -->
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,2">
                                        <Border Grid.Column="0" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="6,3" Margin="0,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="EXPECTATION" FontSize="8" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding StatDistMean, StringFormat='μ = {0:F2}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="6,3" Margin="3,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="VARIANCE" FontSize="8" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding StatVariance, StringFormat='σ² = {0:F2}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="6,3" Margin="3,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="STD DEV" FontSize="8" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding StatDistStdDev, StringFormat='σ = {0:F2}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="8,4">
                                        <TextBlock Text="{Binding StatEntropyNats}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Border>

                                    <!-- Quick Preset Pills -->
                                    <TextBlock Text="BERNOULLI BIAS PRESETS:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,4,0,0" />
                                    <WrapPanel>
                                        <Button Classes="quickchip" Content="Fair Coin (p=0.5)" Command="{Binding SetDistributionPresetCommand}" CommandParameter="symmetric" />
                                        <Button Classes="quickchip" Content="Right-Skew (p=0.2)" Command="{Binding SetDistributionPresetCommand}" CommandParameter="skew_right" />
                                        <Button Classes="quickchip" Content="Left-Skew (p=0.8)" Command="{Binding SetDistributionPresetCommand}" CommandParameter="skew_left" />
                                        <Button Classes="quickchip" Content="Quarter (p=0.25)" Command="{Binding SetDistributionPresetCommand}" CommandParameter="quarter" />
                                        <Button Classes="quickchip" Content="Three-Quarter (p=0.75)" Command="{Binding SetDistributionPresetCommand}" CommandParameter="threequarters" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Statistical Theory Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="DE MOIVRE–LAPLACE CONVERGENCE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="Binomial B(n, p)  →  Normal 𝒩(μ, σ²)"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}" />

                                    <TextBlock Text="• Mean: μ = n · p&#x0a;• Variance: σ² = n · p · (1 - p)&#x0a;• Gaussian: f(x) = (1 / σ√(2π)) e^(-(x-μ)²/2σ²)"
                                               FontSize="10"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="Each ball takes 12 independent binary steps (left or right with probability p). As thousands of balls settle in the bins, the discrete distribution converges exactly to the continuous Gaussian bell curve shown in gold."
                                               FontSize="10"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 5: DYNAMICAL CHAOS INSPECTOR                      -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Dynamical Chaos'}" Spacing="14">

                            <!-- Attractor Constructor & Lyapunov Monitor -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="ATTRACTOR &amp; LYAPUNOV"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceHighBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding ChaosLyapunovStatus}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Prandtl Number Sigma -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="PRANDTL NUMBER (σ)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ChaosSigma, StringFormat='σ = {0:F1}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="1.0" Maximum="30.0" Value="{Binding ChaosSigma, Mode=TwoWay}" />

                                    <!-- Rayleigh Number Rho -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="RAYLEIGH NUMBER (ρ)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ChaosRho, StringFormat='ρ = {0:F1}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.5" Maximum="180.0" Value="{Binding ChaosRho, Mode=TwoWay}" />

                                    <!-- Beta Aspect Ratio -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="GEOMETRIC RATIO (β)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ChaosBeta, StringFormat='β = {0:F2}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.5" Maximum="8.0" Value="{Binding ChaosBeta, Mode=TwoWay}" />

                                    <!-- Live Invariant Badges -->
                                    <Grid ColumnDefinitions="*,*">
                                        <Border Grid.Column="0" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="CONTRACTION RATE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding ChaosContractionRate}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="4,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="HOPF RATIO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding ChaosRayleighRatio}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Regime Presets Palette -->
                                    <TextBlock Text="DYNAMICAL REGIMES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,4,0,0" />
                                    <WrapPanel>
                                        <Button Classes="actionpill" Margin="0,0,4,4"
                                                Command="{Binding SetChaosAttractorPresetCommand}" CommandParameter="butterfly">
                                            <TextBlock Text="🦋 Butterfly (ρ=28)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4"
                                                Command="{Binding SetChaosAttractorPresetCommand}" CommandParameter="subcritical">
                                            <TextBlock Text="🎯 Subcritical (ρ=22)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4"
                                                Command="{Binding SetChaosAttractorPresetCommand}" CommandParameter="transient">
                                            <TextBlock Text="⚡ Transient (ρ=24.5)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4"
                                                Command="{Binding SetChaosAttractorPresetCommand}" CommandParameter="periodic">
                                            <TextBlock Text="🔁 Periodic (ρ=100)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4"
                                                Command="{Binding SetChaosAttractorPresetCommand}" CommandParameter="intermittent">
                                            <TextBlock Text="🌊 Intermittent (ρ=166)" FontSize="10" />
                                        </Button>
                                    </WrapPanel>

                                    <Separator Background="{DynamicResource MathBorderBrush}" Margin="0,4" />

                                    <CheckBox IsChecked="{Binding ShowChaosDualTrajectories, Mode=TwoWay}" Content="Dual Trajectories (Butterfly Divergence)" FontSize="11" />
                                    <Button Classes="mathaction" Command="{Binding PerturbChaosTrajectoryCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="Atom" Width="14" Height="14" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            <TextBlock Text="Inject ε = 10⁻⁵ Perturbation" FontSize="11" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Textbook Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="LORENZ 1963 CONVECTION THEORY"
                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <TextBlock Text="• Differential System:&#x0a;  dx/dt = σ(y - x)&#x0a;  dy/dt = x(ρ - z) - y&#x0a;  dz/dt = xy - βz&#x0a;&#x0a;• Hopf Bifurcation at ρ_c = 24.74:&#x0a;  Fixed points C± lose stability.&#x0a;&#x0a;• Sensitive Dependence (Butterfly Effect):&#x0a;  |Δx(t)| ≈ |Δx(0)| e^{λ₁ t}, λ₁ ≈ +0.905 nats/s&#x0a;&#x0a;• Dissipative Phase Volume:&#x0a;  div(F) = -(σ + 1 + β) &lt; 0 ⟹ V(t) = V(0) e^{-(σ+1+β)t}"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 6: VECTOR FIELDS & ODEs INSPECTOR                 -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Vector Fields &amp; ODEs'}" Spacing="14">

                            <!-- Phase Plane Topology & Invariant Flow Probe -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="TOPOLOGY &amp; PROBE"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceHighBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding VectorFieldFixedPointType}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Probe Invariants Readout -->
                                    <Grid ColumnDefinitions="*,*">
                                        <Border Grid.Column="0" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="DIVERGENCE ∇·F" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding VectorFieldDivergenceStatus}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="4,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="VORTICITY ∇×F" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding VectorFieldCurlStatus}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Probe Coordinate Scrubbers & Presets -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="STREAMLINE SEED (X₀, Y₀)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}">
                                            <TextBlock.Inlines>
                                                <Run Text="(" />
                                                <Run Text="{Binding VectorFieldSeedX, StringFormat='{}{0:F1}'}" />
                                                <Run Text=", " />
                                                <Run Text="{Binding VectorFieldSeedY, StringFormat='{}{0:F1}'}" />
                                                <Run Text=")" />
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                    </Grid>
                                    <WrapPanel>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetVectorFieldProbePointCommand}" CommandParameter="origin">
                                            <TextBlock Text="🎯 Origin (0,0)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetVectorFieldProbePointCommand}" CommandParameter="one">
                                            <TextBlock Text="↗ (1, 1)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetVectorFieldProbePointCommand}" CommandParameter="two_zero">
                                            <TextBlock Text="→ (2, 0)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetVectorFieldProbePointCommand}" CommandParameter="neg_one">
                                            <TextBlock Text="↖ (-1, 1)" FontSize="10" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Vector Field System -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="AUTONOMOUS DYNAMICAL SYSTEM"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="45,*" Margin="0,2">
                                        <TextBlock Text="dx/dt =" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        <TextBox Grid.Column="1" Text="{Binding VectorFieldP, Mode=TwoWay}" FontSize="11" Padding="6,4" />
                                    </Grid>
                                    <!-- Quick chips for P -->
                                    <WrapPanel Orientation="Horizontal" Margin="45,0,0,4">
                                        <Button Classes="quickchip" Command="{Binding InsertVectorFieldPCommand}" CommandParameter="-y" Content="-y" />
                                        <Button Classes="quickchip" Command="{Binding InsertVectorFieldPCommand}" CommandParameter="x" Content="x" />
                                        <Button Classes="quickchip" Command="{Binding InsertVectorFieldPCommand}" CommandParameter="sin(y)" Content="sin(y)" />
                                        <Button Classes="quickchip" Command="{Binding InsertVectorFieldPCommand}" CommandParameter="1 - x^2" Content="1-x²" />
                                        <Button Classes="quickchip" Command="{Binding InsertVectorFieldPCommand}" CommandParameter="x*(2 - y)" Content="x(2-y)" />
                                    </WrapPanel>

                                    <Grid ColumnDefinitions="45,*" Margin="0,2">
                                        <TextBlock Text="dy/dt =" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <TextBox Grid.Column="1" Text="{Binding VectorFieldQ, Mode=TwoWay}" FontSize="11" Padding="6,4" />
                                    </Grid>
                                    <!-- Quick chips for Q -->
                                    <WrapPanel Orientation="Horizontal" Margin="45,0,0,4">
                                        <Button Classes="quickchip" Command="{Binding InsertVectorFieldQCommand}" CommandParameter="x" Content="x" />
                                        <Button Classes="quickchip" Command="{Binding InsertVectorFieldQCommand}" CommandParameter="-x" Content="-x" />
                                        <Button Classes="quickchip" Command="{Binding InsertVectorFieldQCommand}" CommandParameter="cos(x)" Content="cos(x)" />
                                        <Button Classes="quickchip" Command="{Binding InsertVectorFieldQCommand}" CommandParameter="-0.2*y" Content="-0.2y" />
                                        <Button Classes="quickchip" Command="{Binding InsertVectorFieldQCommand}" CommandParameter="y*(x - 1)" Content="y(x-1)" />
                                    </WrapPanel>

                                    <Button Classes="actionpill" Command="{Binding ApplyCustomVectorFieldCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <material:MaterialIcon Kind="PlayCircle" Width="14" Height="14" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            <TextBlock Text="Compile &amp; Advect Custom ODE" FontSize="11" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{Binding VectorFieldSystemStatus}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="SYSTEM PRESETS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               Margin="0,4,0,0" />

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Vortex"
                                                Command="{Binding SetVectorFieldPresetCommand}" CommandParameter="Vortex" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Pendulum"
                                                Command="{Binding SetVectorFieldPresetCommand}" CommandParameter="Pendulum" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Predator-Prey"
                                                Command="{Binding SetVectorFieldPresetCommand}" CommandParameter="PredatorPrey" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Van der Pol"
                                                Command="{Binding SetVectorFieldPresetCommand}" CommandParameter="VanDerPol" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Saddle"
                                                Command="{Binding SetVectorFieldPresetCommand}" CommandParameter="Saddle" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Spiral Sink"
                                                Command="{Binding SetVectorFieldPresetCommand}" CommandParameter="Sink" />
                                    </WrapPanel>

                                    <Separator Background="{DynamicResource MathBorderBrush}" Margin="0,4" />

                                    <CheckBox IsChecked="{Binding VectorFieldShowArrows}" Content="Show Velocity Vectors (F)" FontSize="11" />
                                    <CheckBox IsChecked="{Binding VectorFieldShowParticles}" Content="Advect Fluid Particles (60 FPS)" FontSize="11" />

                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Flow Velocity Rate:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding VectorFieldParticleSpeed, StringFormat='{}{0:F1}x'}" FontSize="10" FontWeight="Bold" />
                                        </Grid>
                                        <Slider Minimum="0.1" Maximum="3.0" Value="{Binding VectorFieldParticleSpeed}" />
                                    </StackPanel>

                                    <TextBlock Text="Click anywhere on the vector field to launch a high-precision Runge-Kutta RK4 streamline trajectory. Hover to probe local Divergence ∇·F and Curl ∇×F."
                                               FontSize="10"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Vector Calculus Theory Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="VECTOR CALCULUS &amp; GAUSS / STOKES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Divergence: ∇·F = ∂P/∂x + ∂Q/∂y (Source &gt; 0, Sink &lt; 0)&#x0a;• Curl: ∇×F = ∂Q/∂x - ∂P/∂y (Microscopic rotation)&#x0a;• Streamlines: dy/dx = Q(x,y) / P(x,y)&#x0a;• Green's Theorem: ∮ (P dx + Q dy) = ∬ (∂Q/∂x - ∂P/∂y) dA"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 7: COMPLEX ANALYSIS & CONFORMAL MAPS INSPECTOR    -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Complex &amp; Conformal'}" Spacing="14">

                            <!-- Complex Map Details -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="COMPLEX MAPPING f(z): ℂ → ℂ"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="{Binding ComplexFormulaTitle}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding ComplexFormulaDetail}"
                                               FontSize="10"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}"
                                               TextWrapping="Wrap" />

                                    <Grid ColumnDefinitions="45,*" Margin="0,4,0,2">
                                        <TextBlock Text="f(z) =" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        <TextBox Grid.Column="1" Text="{Binding ComplexCustomFormula, Mode=TwoWay}" FontSize="11" Padding="6,4" />
                                    </Grid>

                                    <!-- Expression Symbol Chips -->
                                    <WrapPanel Margin="0,2,0,4">
                                        <Button Classes="quickchip" Content="z" Command="{Binding InsertComplexSymbolCommand}" CommandParameter="z" />
                                        <Button Classes="quickchip" Content="z²" Command="{Binding InsertComplexSymbolCommand}" CommandParameter="^2" />
                                        <Button Classes="quickchip" Content="z³" Command="{Binding InsertComplexSymbolCommand}" CommandParameter="^3" />
                                        <Button Classes="quickchip" Content="eᶻ" Command="{Binding InsertComplexSymbolCommand}" CommandParameter="exp(z)" />
                                        <Button Classes="quickchip" Content="sin(z)" Command="{Binding InsertComplexSymbolCommand}" CommandParameter="sin(z)" />
                                        <Button Classes="quickchip" Content="cos(z)" Command="{Binding InsertComplexSymbolCommand}" CommandParameter="cos(z)" />
                                        <Button Classes="quickchip" Content="1/z" Command="{Binding InsertComplexSymbolCommand}" CommandParameter="1/z" />
                                    </WrapPanel>

                                    <!-- Interactive Möbius Transformation Suite -->
                                    <Border Classes="builderbox">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="MÖBIUS TRANSFORMATION BUILDER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                                <Border Grid.Column="1" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="6,2">
                                                    <TextBlock Text="{Binding MobiusDeterminantStatus}" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="f(z) = (a·z + b) / (c·z + d)  [GL₂(ℂ) Projective Automorphisms]" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />

                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,2">
                                                <!-- a -->
                                                <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,4,4">
                                                    <TextBlock Text="a:" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                    <TextBox Grid.Column="1" Text="{Binding MobiusParamA, Mode=TwoWay}" FontSize="10" Padding="4,2" />
                                                </Grid>
                                                <!-- b -->
                                                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*" Margin="4,0,0,4">
                                                    <TextBlock Text="b:" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                    <TextBox Grid.Column="1" Text="{Binding MobiusParamB, Mode=TwoWay}" FontSize="10" Padding="4,2" />
                                                </Grid>
                                                <!-- c -->
                                                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,4,4,0">
                                                    <TextBlock Text="c:" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                    <TextBox Grid.Column="1" Text="{Binding MobiusParamC, Mode=TwoWay}" FontSize="10" Padding="4,2" />
                                                </Grid>
                                                <!-- d -->
                                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*" Margin="4,4,0,0">
                                                    <TextBlock Text="d:" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                    <TextBox Grid.Column="1" Text="{Binding MobiusParamD, Mode=TwoWay}" FontSize="10" Padding="4,2" />
                                                </Grid>
                                            </Grid>

                                            <WrapPanel Margin="0,4,0,0">
                                                <Button Classes="actionpill" Content="Apply f(z)" Command="{Binding ApplyMobiusTransformationCommand}" />
                                                <Button Classes="actionpill" Content="Cayley Map" Command="{Binding SetMobiusPresetCommand}" CommandParameter="cayley" />
                                                <Button Classes="actionpill" Content="Inversion 1/z" Command="{Binding SetMobiusPresetCommand}" CommandParameter="inversion" />
                                                <Button Classes="actionpill" Content="Dilation 2z" Command="{Binding SetMobiusPresetCommand}" CommandParameter="scaling" />
                                                <Button Classes="actionpill" Content="Joukowsky" Command="{Binding SetMobiusPresetCommand}" CommandParameter="joukowsky" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="TRANSFORM PRESETS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               Margin="0,4,0,0" />

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="z² (Quad)"
                                                Command="{Binding SetComplexPresetCommand}" CommandParameter="z2" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="z³ - 1 (Roots)"
                                                Command="{Binding SetComplexPresetCommand}" CommandParameter="roots" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="eᶻ (Euler)"
                                                Command="{Binding SetComplexPresetCommand}" CommandParameter="exp" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="sin(z)"
                                                Command="{Binding SetComplexPresetCommand}" CommandParameter="sin" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="1/z (Pole)"
                                                Command="{Binding SetComplexPresetCommand}" CommandParameter="pole" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Möbius"
                                                Command="{Binding SetComplexPresetCommand}" CommandParameter="mobius" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Joukowsky Wing"
                                                Command="{Binding SetComplexPresetCommand}" CommandParameter="joukowsky" />
                                    </WrapPanel>

                                    <Separator Background="{DynamicResource MathBorderBrush}" Margin="0,4" />

                                    <CheckBox IsChecked="{Binding ComplexShowModulusContours}" Content="Modulus |f(z)| Topographic Rings" FontSize="11" />
                                    <CheckBox IsChecked="{Binding ComplexShowConformalGrid}" Content="Orthogonal Conformal Grid (u, v)" FontSize="11" />

                                    <TextBlock Text="Hover mouse over the complex plane to inspect z = x + iy, mapped w = f(z), polar modulus |w|, argument arg(w), and complex dilation scale |f'(z)|."
                                               FontSize="10"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Cauchy-Riemann & Holomorphic Theory Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="CAUCHY-RIEMANN &amp; CONFORMAL RIGOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Cauchy-Riemann: ∂u/∂x = ∂v/∂y,  ∂u/∂y = -∂v/∂x&#x0a;• Conformal Angle Preservation: For any f'(z) ≠ 0, tangent intersection angles are identically preserved.&#x0a;• Domain Coloring: Hue = arg(f(z)), Lightness = log |f(z)|&#x0a;• Cauchy's Integral Formula: f(a) = (1/2πi) ∮ [f(z)/(z-a)] dz"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 8: 3D MULTIVARIABLE CALCULUS & SURFACES INSPECTOR -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Surfaces &amp; 3D'}" Spacing="14">

                            <!-- Surface Definition & Presets -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="MULTIVARIABLE SURFACE z = f(x, y)"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="{Binding SurfaceFormulaTitle}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding SurfaceFormulaDetail}"
                                               FontSize="10"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}"
                                               TextWrapping="Wrap" />

                                    <Grid ColumnDefinitions="45,*" Margin="0,4,0,2">
                                        <TextBlock Text="z =" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        <TextBox Grid.Column="1" Text="{Binding SurfaceFormula, Mode=TwoWay}" FontSize="11" Padding="6,4" />
                                    </Grid>

                                    <!-- Expression Symbol Chips -->
                                    <WrapPanel Margin="0,2,0,4">
                                        <Button Classes="quickchip" Content="x" Command="{Binding InsertSurfaceSymbolCommand}" CommandParameter="x" />
                                        <Button Classes="quickchip" Content="y" Command="{Binding InsertSurfaceSymbolCommand}" CommandParameter="y" />
                                        <Button Classes="quickchip" Content="x²" Command="{Binding InsertSurfaceSymbolCommand}" CommandParameter="x^2" />
                                        <Button Classes="quickchip" Content="y²" Command="{Binding InsertSurfaceSymbolCommand}" CommandParameter="y^2" />
                                        <Button Classes="quickchip" Content="xy" Command="{Binding InsertSurfaceSymbolCommand}" CommandParameter="x*y" />
                                        <Button Classes="quickchip" Content="sin(x)" Command="{Binding InsertSurfaceSymbolCommand}" CommandParameter="sin(x)" />
                                        <Button Classes="quickchip" Content="cos(y)" Command="{Binding InsertSurfaceSymbolCommand}" CommandParameter="cos(y)" />
                                        <Button Classes="quickchip" Content="e^(-r²)" Command="{Binding InsertSurfaceSymbolCommand}" CommandParameter="exp(-x^2-y^2)" />
                                    </WrapPanel>

                                    <!-- Interactive Quadric Surface Constructor -->
                                    <Border Classes="builderbox">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="QUADRIC SURFACE CONSTRUCTOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                                <Border Grid.Column="1" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="6,2">
                                                    <TextBlock Text="{Binding SurfaceCurvatureStatus}" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="z = A·x² + B·y² + C·x·y  [Hessian D = 4AB - C²]" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />

                                            <!-- A Slider -->
                                            <Grid ColumnDefinitions="30,*,40">
                                                <TextBlock Text="A:" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <Slider Grid.Column="1" Minimum="-2.0" Maximum="2.0" Value="{Binding SurfaceParamA, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="2" Text="{Binding SurfaceParamA, StringFormat='{}{0:F2}'}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </Grid>

                                            <!-- B Slider -->
                                            <Grid ColumnDefinitions="30,*,40">
                                                <TextBlock Text="B:" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <Slider Grid.Column="1" Minimum="-2.0" Maximum="2.0" Value="{Binding SurfaceParamB, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="2" Text="{Binding SurfaceParamB, StringFormat='{}{0:F2}'}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </Grid>

                                            <!-- C Slider -->
                                            <Grid ColumnDefinitions="30,*,40">
                                                <TextBlock Text="C:" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <Slider Grid.Column="1" Minimum="-2.0" Maximum="2.0" Value="{Binding SurfaceParamC, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="2" Text="{Binding SurfaceParamC, StringFormat='{}{0:F2}'}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </Grid>

                                            <!-- Action and Probe Readout -->
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                <Button Classes="actionpill" Content="Compile Quadric z(x,y)" Command="{Binding ApplyQuadricSurfaceCommand}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SurfaceEvalZ, StringFormat='z₀ = {0:F2}'}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="SURFACE PRESETS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               Margin="0,4,0,0" />

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Paraboloid"
                                                Command="{Binding SetSurfacePresetCommand}" CommandParameter="paraboloid" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Saddle"
                                                Command="{Binding SetSurfacePresetCommand}" CommandParameter="saddle" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Sombrero"
                                                Command="{Binding SetSurfacePresetCommand}" CommandParameter="sombrero" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Gaussian Hill"
                                                Command="{Binding SetSurfacePresetCommand}" CommandParameter="gaussian" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Monkey Saddle"
                                                Command="{Binding SetSurfacePresetCommand}" CommandParameter="monkeysaddle" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Wave Ripple"
                                                Command="{Binding SetSurfacePresetCommand}" CommandParameter="ripple" />
                                        <Button Classes="mathaction" Margin="0,0,4,4" Content="Egg Crate"
                                                Command="{Binding SetSurfacePresetCommand}" CommandParameter="eggcrate" />
                                    </WrapPanel>

                                    <Separator Background="{DynamicResource MathBorderBrush}" Margin="0,4" />

                                    <TextBlock Text="TANGENT PLANE PROBE POINT"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Probe X:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SurfaceProbeX, StringFormat='{}{0:F2}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="-2.5" Maximum="2.5" Value="{Binding SurfaceProbeX}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Probe Y:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SurfaceProbeY, StringFormat='{}{0:F2}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="-2.5" Maximum="2.5" Value="{Binding SurfaceProbeY}" />

                                    <CheckBox IsChecked="{Binding SurfaceShowTangentPlane}" Content="Render 3D Tangent Plane" FontSize="11" />
                                    <CheckBox IsChecked="{Binding SurfaceShowNormalVector}" Content="Render Surface Normal Vector n" FontSize="11" />
                                    <CheckBox IsChecked="{Binding SurfaceShowWireframe}" Content="Render Wireframe Grid Lines" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <!-- Multivariable Calculus Theory Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="MULTIVARIABLE CALCULUS RIGOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Tangent Plane: z - z₀ = f_x(x - x₀) + f_y(y - y₀)&#x0a;• Gradient Vector: ∇f = &lt;f_x, f_y&gt; (Steepest ascent direction)&#x0a;• Directional Derivative: D_u f = ∇f · u = ||∇f|| cos θ&#x0a;• Surface Normal: n = &lt;-f_x, -f_y, 1&gt;&#x0a;• Second Derivative Test: D = f_xx·f_yy - (f_xy)²&#x0a;  - D &gt; 0, f_xx &gt; 0: Local Minimum&#x0a;  - D &gt; 0, f_xx &lt; 0: Local Maximum&#x0a;  - D &lt; 0: Hyperbolic Saddle Point"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 9: FRACTALS & COMPLEX DYNAMICS INSPECTOR          -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Fractals &amp; Chaos'}" Spacing="14">

                            <!-- Formula Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="COMPLEX DYNAMICS RECURRENCE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="{Binding FractalFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding FractalFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Fractal Type Selector -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="FRACTAL ENGINE MODE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalTypeCommand}" CommandParameter="Mandelbrot">
                                            <TextBlock Text="Mandelbrot" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalTypeCommand}" CommandParameter="Julia">
                                            <TextBlock Text="Julia Set" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalTypeCommand}" CommandParameter="NewtonBasin">
                                            <TextBlock Text="Newton Basin" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalTypeCommand}" CommandParameter="BurningShip">
                                            <TextBlock Text="Burning Ship" FontSize="11" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Curated Preset Locations -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CURATED DEEP-ZOOM PRESETS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPresetCommand}" CommandParameter="mandelbrot">
                                            <TextBlock Text="Full Overview" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPresetCommand}" CommandParameter="seahorse">
                                            <TextBlock Text="Seahorse Valley" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPresetCommand}" CommandParameter="elephant">
                                            <TextBlock Text="Elephant Valley" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPresetCommand}" CommandParameter="douady">
                                            <TextBlock Text="Douady Rabbit" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPresetCommand}" CommandParameter="sanmarco">
                                            <TextBlock Text="San Marco" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPresetCommand}" CommandParameter="newton">
                                            <TextBlock Text="Newton z³ - 1" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPresetCommand}" CommandParameter="burningship">
                                            <TextBlock Text="Burning Ship" FontSize="11" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Color Palettes -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="COLOR PALETTES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPaletteCommand}" CommandParameter="ElectricNeon">
                                            <TextBlock Text="Electric Neon" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPaletteCommand}" CommandParameter="FireMagma">
                                            <TextBlock Text="Fire Magma" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPaletteCommand}" CommandParameter="OceanTurquoise">
                                            <TextBlock Text="Ocean Abyss" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPaletteCommand}" CommandParameter="PsychedelicRainbow">
                                            <TextBlock Text="Rainbow Cycle" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetFractalPaletteCommand}" CommandParameter="MonochromeGold">
                                            <TextBlock Text="Golden Glow" FontSize="11" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Precision & Iterations -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="MAX ESCAPE ITERATIONS"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FractalMaxIterations}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>

                                    <Slider Minimum="20" Maximum="400" Value="{Binding FractalMaxIterations}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="JULIA CONSTANT Re(c)"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FractalJuliaCr, StringFormat='{}{0:F3}'}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="-1.5" Maximum="1.5" Value="{Binding FractalJuliaCr}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="JULIA CONSTANT Im(c)"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FractalJuliaCi, StringFormat='{}{0:F3}'}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="-1.5" Maximum="1.5" Value="{Binding FractalJuliaCi}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="ESCAPE BAILOUT RADIUS R"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FractalEscapeRadius, StringFormat='R = {0:F1}'}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="2.0" Maximum="10.0" Value="{Binding FractalEscapeRadius}" />
                                </StackPanel>
                            </Border>

                            <!-- Famous Julia Sets Catalog -->
                            <Border Classes="builderbox">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="FAMOUS JULIA CONSTANTS c ∈ ℂ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    <WrapPanel>
                                        <Button Classes="actionpill" Content="Douady Rabbit" Command="{Binding SetFamousJuliaPresetCommand}" CommandParameter="douady" />
                                        <Button Classes="actionpill" Content="San Marco" Command="{Binding SetFamousJuliaPresetCommand}" CommandParameter="sanmarco" />
                                        <Button Classes="actionpill" Content="Dendrite (c=i)" Command="{Binding SetFamousJuliaPresetCommand}" CommandParameter="dendrite" />
                                        <Button Classes="actionpill" Content="Siegel Disk" Command="{Binding SetFamousJuliaPresetCommand}" CommandParameter="siegel" />
                                        <Button Classes="actionpill" Content="Cauliflower" Command="{Binding SetFamousJuliaPresetCommand}" CommandParameter="cauliflower" />
                                        <Button Classes="actionpill" Content="Airplane" Command="{Binding SetFamousJuliaPresetCommand}" CommandParameter="airplane" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Rigorous Complex Dynamics Theory Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="COMPLEX DYNAMICS RIGOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Douady-Hubbard Connectedness Theorem:&#x0a;  c ∈ M ⇔ J(c) is connected.&#x0a;  c ∉ M ⇔ J(c) is Cantor dust (totally disconnected).&#x0a;• Normalized Continuous Iteration:&#x0a;  ν = n + 1 - ln(ln |z|) / ln 2&#x0a;• Boundary Hausdorff Dimension:&#x0a;  dim_H(∂M) = 2 (Shishikura Theorem, 1998)&#x0a;• Newton Basins: Root attractors partition ℂ into fractal boundaries with sensitive dependence."
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 10: WAVE MECHANICS & CHLADNI RESONANCE INSPECTOR  -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='PDE &amp; Waves'}" Spacing="14">

                            <!-- Formula Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="WAVE EQUATION &amp; EIGENMODES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="{Binding WaveFormulaTitle}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding WaveFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Simulation Mode Selector -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="WAVE MEDIUM &amp; GEOMETRY"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetWaveModeCommand}" CommandParameter="ChladniPlate">
                                            <TextBlock Text="Chladni Plate" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetWaveModeCommand}" CommandParameter="CircularDrum">
                                            <TextBlock Text="Circular Drum" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetWaveModeCommand}" CommandParameter="InteractiveRippleTank">
                                            <TextBlock Text="2D Ripple Tank" FontSize="11" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Curated Resonance Presets -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="ACOUSTIC RESONANCE PRESETS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetWavePresetCommand}" CommandParameter="rosette">
                                            <TextBlock Text="Rosette (3,5)" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetWavePresetCommand}" CommandParameter="cross">
                                            <TextBlock Text="Cross (1,3)" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetWavePresetCommand}" CommandParameter="clover">
                                            <TextBlock Text="Clover (2,4)" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetWavePresetCommand}" CommandParameter="drum">
                                            <TextBlock Text="Bessel Drum" FontSize="11" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,6,6"
                                                Command="{Binding SetWavePresetCommand}" CommandParameter="ripple">
                                            <TextBlock Text="2D Water Tank" FontSize="11" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Mode Indices (N, M) -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="EIGENMODE INDEX n"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding WaveModeN}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="8" Value="{Binding WaveModeN}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="EIGENMODE INDEX m"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding WaveModeM}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="8" Value="{Binding WaveModeM}" />

                                    <CheckBox Content="Simulate Vibrating Sand Grains"
                                              IsChecked="{Binding WaveShowSand}"
                                              Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Wave Medium & CFL Stability Monitor -->
                            <Border Classes="builderbox">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="CFL STABILITY MONITOR"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource MathSurfaceBrush}"
                                                CornerRadius="{DynamicResource MathRadiusSm}"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding WaveCflStatus}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Wave Propagation Speed c Slider -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Phase Velocity (c):" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding WavePropagationSpeedC, StringFormat='{}{0:F2} m/s'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.2" Maximum="2.0" Value="{Binding WavePropagationSpeedC, Mode=TwoWay}" />

                                    <!-- Wave Excitation Mode Builder Pills -->
                                    <TextBlock Text="WAVE EXCITATION PROFILES:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,4,0,0" />
                                    <WrapPanel>
                                        <Button Classes="quickchip" Content="Point Impact (Dirac δ)" Command="{Binding SetWaveExcitationCommand}" CommandParameter="impulse" />
                                        <Button Classes="quickchip" Content="Gaussian Packet" Command="{Binding SetWaveExcitationCommand}" CommandParameter="gaussian" />
                                        <Button Classes="quickchip" Content="Pure Eigenmode" Command="{Binding SetWaveExcitationCommand}" CommandParameter="standing" />
                                        <Button Classes="quickchip" Content="Dipole Interference" Command="{Binding SetWaveExcitationCommand}" CommandParameter="dipole" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Textbook PDE Rigor Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="PARTIAL DIFFERENTIAL RIGOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• 2D Wave Equation:&#x0a;  ∂²u/∂t² = c² (∂²u/∂x² + ∂²u/∂y²) - γ ∂u/∂t&#x0a;• Helmholtz Spatial Eigenmodes:&#x0a;  ∇²ψ + k²ψ = 0  with  ψ|_{\partial \Omega} = 0&#x0a;• Square Plate Nodal Lines:&#x0a;  u(x, y) = cos(nπx/L)cos(mπy/L) - cos(mπx/L)cos(nπy/L) = 0&#x0a;• Courant Nodal Domain Theorem:&#x0a;  The k-th eigenfunction divides Ω into at most k nodal domains."
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 11: DIFFERENTIAL GEOMETRY & SPACE CURVES INSPECTOR -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Space Curves 3D'}" Spacing="14">

                            <!-- Active Space Curve Formula Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="ACTIVE 3D SPACE CURVE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <TextBlock Text="{Binding CurveFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding CurveFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Frenet-Serret Invariant & Osculating Probe -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="FRENET-SERRET PROBE"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceHighBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding CurveFrenetRegimeStatus}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Invariants 2x2 Grid -->
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,4,4">
                                            <StackPanel>
                                                <TextBlock Text="CURVATURE (κ)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding CurveCurvatureKappa}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="4,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="TORSION (τ)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding CurveTorsionTau}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,4,4,0">
                                            <StackPanel>
                                                <TextBlock Text="RADIUS R = 1/κ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding CurveRadiusOfCurvature}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="4,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="LANCRET RATIO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding CurveLancretRatio}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Space Curve Presets Palette -->
                            <TextBlock Text="CURVE TOPOLOGY PRESETS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MathTextMutedBrush}" />
                            <WrapPanel Margin="0,0,0,4">
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetSpaceCurvePresetCommand}" CommandParameter="helix">
                                    <TextBlock Text="🌀 Helix" FontSize="11" />
                                </Button>
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetSpaceCurvePresetCommand}" CommandParameter="trefoil">
                                    <TextBlock Text="🪢 Trefoil Knot" FontSize="11" />
                                </Button>
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetSpaceCurvePresetCommand}" CommandParameter="viviani">
                                    <TextBlock Text="♾️ Viviani Window" FontSize="11" />
                                </Button>
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetSpaceCurvePresetCommand}" CommandParameter="torus">
                                    <TextBlock Text="🍩 Torus Knot" FontSize="11" />
                                </Button>
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetSpaceCurvePresetCommand}" CommandParameter="twistedcubic">
                                    <TextBlock Text="📈 Twisted Cubic" FontSize="11" />
                                </Button>
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetSpaceCurvePresetCommand}" CommandParameter="conical">
                                    <TextBlock Text="📐 Conical Spiral" FontSize="11" />
                                </Button>
                            </WrapPanel>

                            <!-- Parameter t Scrubbing Slider -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="CURVE PARAMETER (t)"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurveParamT, StringFormat='t = {0:F2}'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="{Binding CurveTMin}"
                                            Maximum="{Binding CurveTMax}"
                                            Value="{Binding CurveParamT, Mode=TwoWay}" />
                                    <TextBlock Text="Drag slider to propel the Frenet-Serret frame and osculating circle along the curve."
                                               FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Visual Geometry Overlays Toggles -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="DIFFERENTIAL OVERLAYS"
                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <CheckBox IsChecked="{Binding CurveShowFrenetFrame, Mode=TwoWay}">
                                        <TextBlock Text="Frenet-Serret Trihedron ⟨T, N, B⟩" FontSize="11" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding CurveShowOsculatingPlane, Mode=TwoWay}">
                                        <TextBlock Text="Osculating Plane (Span ⟨T, N⟩)" FontSize="11" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding CurveShowOsculatingCircle, Mode=TwoWay}">
                                        <TextBlock Text="Osculating Curvature Circle (R = 1/κ)" FontSize="11" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- Textbook Frenet-Serret Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="FRENET-SERRET FORMULAS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Tangent: T = r' / ||r'||&#x0a;• Normal: N = (T' / ||T'||)&#x0a;• Binormal: B = T × N&#x0a;&#x0a;• Matrix Differential System:&#x0a;  d/ds [T]   [  0   κ   0 ] [T]&#x0a;  d/ds [N] = [ -κ   0   τ ] [N]&#x0a;  d/ds [B]   [  0  -τ   0 ] [B]&#x0a;&#x0a;• Curvature: κ = ||r' × r''|| / ||r'||³&#x0a;• Torsion:   τ = (r' × r'') · r''' / ||r' × r''||²"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 12: RIEMANN ZETA & PRIME DISTRIBUTION INSPECTOR     -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Zeta &amp; Primes'}" Spacing="14">

                            <!-- Active Zeta Formula Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="RIEMANN ZETA &amp; ANALYTIC NUMBER THEORY"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <TextBlock Text="{Binding ZetaFormulaTitle}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ZetaFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Critical Zeros & Explicit Prime Monitor -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="ZEROS &amp; EXPLICIT MONITOR"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceHighBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding ZetaGramIntervalStatus}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Invariants 2x2 Grid -->
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,4,4">
                                            <StackPanel>
                                                <TextBlock Text="NEAREST ZERO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding ZetaNearestZeroOrdinal}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="4,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="EXACT ZERO HEIGHT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding ZetaNearestZeroHeight}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,4,4,0">
                                            <StackPanel>
                                                <TextBlock Text="RIEMANN-SIEGEL Z(t)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding ZetaRiemannSiegelZVal}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="4,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="PRIME RESIDUAL ERROR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding ZetaPrimeLiResidual}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Zero Teleport Quick Chips -->
                                    <TextBlock Text="TELEPORT TO NON-TRIVIAL ZEROS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,2,0,0" />
                                    <WrapPanel>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetZetaZeroTeleportCommand}" CommandParameter="1">
                                            <TextBlock Text="γ₁ = 14.13" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetZetaZeroTeleportCommand}" CommandParameter="2">
                                            <TextBlock Text="γ₂ = 21.02" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetZetaZeroTeleportCommand}" CommandParameter="3">
                                            <TextBlock Text="γ₃ = 25.01" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetZetaZeroTeleportCommand}" CommandParameter="4">
                                            <TextBlock Text="γ₄ = 30.42" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetZetaZeroTeleportCommand}" CommandParameter="5">
                                            <TextBlock Text="γ₅ = 32.94" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetZetaZeroTeleportCommand}" CommandParameter="6">
                                            <TextBlock Text="γ₆ = 37.59" FontSize="10" />
                                        </Button>
                                    </WrapPanel>
                                    <Button Classes="mathaction" Margin="0,4,0,0" Padding="8,4"
                                            Command="{Binding PlayRiemannZeroCommand}" CommandParameter="{Binding ZetaProbeT}"
                                            ToolTip.Tip="Sonify non-trivial Riemann zero frequency (γ₁ = 14.1347 -> 220Hz A3 pitch)">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="🔊" FontSize="11" />
                                            <TextBlock Text="Sonify Current Zero (A3 = 220Hz @ γ₁)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- View Mode Switch -->
                            <TextBlock Text="EXPLORATION REGIME"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MathTextMutedBrush}" />
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Classes="mathaction" Margin="0,0,4,0"
                                        Command="{Binding SetZetaViewModeCommand}" CommandParameter="CriticalLine">
                                    <TextBlock Text="Critical Line Z(t)" FontSize="11" />
                                </Button>
                                <Button Grid.Column="1" Classes="mathaction" Margin="4,0,0,0"
                                        Command="{Binding SetZetaViewModeCommand}" CommandParameter="PrimeStaircase">
                                    <TextBlock Text="Prime Staircase π(x)" FontSize="11" />
                                </Button>
                            </Grid>

                            <!-- Zeta Presets -->
                            <TextBlock Text="PRESETS &amp; RIEMANN ZEROS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MathTextMutedBrush}" />
                            <WrapPanel Margin="0,0,0,4">
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetZetaPresetCommand}" CommandParameter="criticalline">
                                    <TextBlock Text="🌐 Critical Line" FontSize="11" />
                                </Button>
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetZetaPresetCommand}" CommandParameter="zero1">
                                    <TextBlock Text="① Zero γ₁ (14.13)" FontSize="11" />
                                </Button>
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetZetaPresetCommand}" CommandParameter="zero2">
                                    <TextBlock Text="② Zero γ₂ (21.02)" FontSize="11" />
                                </Button>
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetZetaPresetCommand}" CommandParameter="zero3">
                                    <TextBlock Text="③ Zero γ₃ (25.01)" FontSize="11" />
                                </Button>
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetZetaPresetCommand}" CommandParameter="primestaircase">
                                    <TextBlock Text="📊 Prime Staircase" FontSize="11" />
                                </Button>
                                <Button Classes="mathaction" Margin="0,0,6,6"
                                        Command="{Binding SetZetaPresetCommand}" CommandParameter="explicitprimes">
                                    <TextBlock Text="🌊 Zero Standing Waves" FontSize="11" />
                                </Button>
                            </WrapPanel>

                            <!-- Critical Line Probe Slider -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="CRITICAL LINE PROBE (t)"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ZetaProbeT, StringFormat='t = {0:F3}'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.0" Maximum="80.0" Value="{Binding ZetaProbeT, Mode=TwoWay}" />
                                    <TextBlock Text="Scrub t or click directly on the Z(t) graph to steer the polar phasor in the complex plane."
                                               FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Prime Superposition Slider -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="ACTIVE RIEMANN ZEROS (K)"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ZetaZeroCount, StringFormat='K = {0} zeros'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="20" Value="{Binding ZetaZeroCount, Mode=TwoWay}" />
                                    <TextBlock Text="Watch the smooth curve develop ripples that sharpen into discrete prime steps as K increases!"
                                               FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="RIEMANN'S EXPLICIT FORMULA"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Riemann Hypothesis (1859):&#x0a;  All non-trivial zeros satisfy Re(s) = 1/2.&#x0a;&#x0a;• Riemann-Siegel Z-Function:&#x0a;  Z(t) = e^{i θ(t)} ζ(1/2 + it) ∈ ℝ&#x0a;  θ(t) = arg(Γ(1/4 + it/2)) - (t/2)ln π&#x0a;&#x0a;• Harmonic Prime Superposition:&#x0a;  π₀(x) = R(x) - Σ_ρ 2 Re( x^ρ / (ρ ln x) )&#x0a;  R(x) = 1 + Σ_{n=1}^∞ (ln x)^n / (n! n ζ(n+1))"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 13: HEAT DIFFUSION & LAPLACE PDE INSPECTOR         -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Heat &amp; Diffusion'}" Spacing="14">

                            <!-- Formula Banner -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="PDE MODEL"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <TextBlock Text="{Binding HeatFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding HeatFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Boundary Value Problem & Conduction Monitor -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="BOUNDARY &amp; EQUILIBRIUM"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceHighBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding HeatStabilityCflStatus}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Invariants Grid -->
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,4,4">
                                            <StackPanel>
                                                <TextBlock Text="BOUNDARY REGIME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding HeatBoundaryStatus}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="4,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="MAX PRINCIPLE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding HeatMaximumPrincipleStatus}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Boundary Mode Toggle Pills -->
                                    <TextBlock Text="BOUNDARY CONDITIONS (BVP)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,2,0,0" />
                                    <WrapPanel>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetHeatBoundaryConditionCommand}" CommandParameter="dirichlet">
                                            <TextBlock Text="Dirichlet (Fixed T)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetHeatBoundaryConditionCommand}" CommandParameter="neumann">
                                            <TextBlock Text="Neumann (Insulated)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetHeatBoundaryConditionCommand}" CommandParameter="periodic">
                                            <TextBlock Text="Periodic (Torus)" FontSize="10" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Presets Selector -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CLASSICAL THERMAL CONFIGURATIONS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <WrapPanel>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetHeatPresetCommand}" CommandParameter="laplace">
                                            <TextBlock Text="Laplace (∇²T = 0)" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetHeatPresetCommand}" CommandParameter="dipole">
                                            <TextBlock Text="Thermal Dipole" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetHeatPresetCommand}" CommandParameter="insulated">
                                            <TextBlock Text="Adiabatic Cavity" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetHeatPresetCommand}" CommandParameter="corners">
                                            <TextBlock Text="4-Corner Chamber" />
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Text="Tip: Left-Click / Drag directly on canvas to paint heat flames (+100°C); Right-Click / Drag to paint ice sinks (-40°C)."
                                               FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Simulation Controls -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="PHYSICS CONTROLS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="THERMAL DIFFUSIVITY (α)"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding HeatDiffusivity, StringFormat='α = {0:F3}'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.01" Maximum="0.24" Value="{Binding HeatDiffusivity, Mode=TwoWay}" />
                                    <TextBlock Text="Bounded by α ≤ 0.25 for von Neumann numerical stability in 2D."
                                               FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <CheckBox IsChecked="{Binding HeatShowFlux, Mode=TwoWay}" Content="Show Fourier Heat Flux Vectors (q = -k ∇T)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding HeatShowIsotherms, Mode=TwoWay}" Content="Show Isothermal Contours (T = const)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding HeatIsSimulating, Mode=TwoWay}" Content="Run Live Simulation" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="FOURIER HEAT CONDUCTION THEORY"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Heat Diffusion Equation (Fourier 1822):&#x0a;  ∂T/∂t = α ∇²T + Q(x, y)&#x0a;  ∇²T = ∂²T/∂x² + ∂²T/∂y²&#x0a;&#x0a;• Fourier's Law of Conduction:&#x0a;  q = -k ∇T&#x0a;  Thermal energy flux points anti-parallel to the temperature gradient.&#x0a;&#x0a;• Laplace Steady-State:&#x0a;  As t → ∞, ∂T/∂t = 0 ⟹ ∇²T = 0&#x0a;  Solutions are harmonic functions satisfying the Mean Value Property.&#x0a;&#x0a;• Von Neumann Stability Criterion:&#x0a;  α Δt / (Δx)² ≤ 1/4 in 2D Cartesian grid."
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 14: QUANTUM WAVE MECHANICS & SCHRÖDINGER INSPECTOR -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Quantum &amp; Waves'}" Spacing="14">

                            <!-- Formula Banner -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="WAVE MECHANICS MODEL"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <TextBlock Text="{Binding QuantumFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding QuantumFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Presets Selector -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="QUANTUM SCENARIOS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <WrapPanel>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetQuantumPresetCommand}" CommandParameter="tunneling">
                                            <TextBlock Text="Barrier Tunneling" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetQuantumPresetCommand}" CommandParameter="harmonic">
                                            <TextBlock Text="Harmonic Oscillator" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetQuantumPresetCommand}" CommandParameter="doublewell">
                                            <TextBlock Text="Double Well Beats" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetQuantumPresetCommand}" CommandParameter="step">
                                            <TextBlock Text="Step Reflection" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetQuantumPresetCommand}" CommandParameter="free">
                                            <TextBlock Text="Free Dispersion" />
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Text="Tip: Click and drag anywhere on the canvas to paint potential barriers V(x) in real-time."
                                               FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Quantum Potential & Wavepacket Architect -->
                            <Border Classes="builderbox">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="POTENTIAL WELL &amp; WAVEPACKET ARCHITECT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    <TextBlock Text="Parameterize potential barriers V(x) and initial wavepacket ψ(x,0) without code" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <!-- Barrier Height V0 -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Barrier Height V₀:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding QuantumBarrierHeight, StringFormat='V₀ = {0:F1}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.5" Maximum="8.0" Value="{Binding QuantumBarrierHeight, Mode=TwoWay}" />

                                    <!-- Barrier Width W -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Barrier Width W:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding QuantumBarrierWidth, StringFormat='W = {0:F2}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.2" Maximum="3.0" Value="{Binding QuantumBarrierWidth, Mode=TwoWay}" />

                                    <!-- Momentum k0 -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Wavepacket Momentum (k₀):" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding QuantumWavepacketK0, StringFormat='k₀ = {0:F2}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="-6.0" Maximum="6.0" Value="{Binding QuantumWavepacketK0, Mode=TwoWay}" />

                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Classes="actionpill" Content="Inject Packet" Command="{Binding InjectCustomWavepacketCommand}" />
                                        <Button Classes="actionpill" Content="Harmonic Coherent" Command="{Binding SetQuantumPresetCommand}" CommandParameter="harmonic" />
                                        <Button Classes="actionpill" Content="Double-Well Beats" Command="{Binding SetQuantumPresetCommand}" CommandParameter="doublewell" />
                                        <Button Classes="actionpill" Content="Step Potential" Command="{Binding SetQuantumPresetCommand}" CommandParameter="step" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Visualization & Physics Controls -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="VISUALIZATION &amp; TIME"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="INTEGRATION TIME STEP (Δt)"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding QuantumTimeStep, StringFormat='Δt = {0:F3}'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.005" Maximum="0.08" Value="{Binding QuantumTimeStep, Mode=TwoWay}" />

                                    <CheckBox IsChecked="{Binding QuantumShowPhaseColoring, Mode=TwoWay}" Content="Color by Quantum Phase arg(ψ)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding QuantumShowProbabilityDensity, Mode=TwoWay}" Content="Show Probability Density |ψ(x)|²" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding QuantumShowWaveComponents, Mode=TwoWay}" Content="Show Real Re(ψ) &amp; Imaginary Im(ψ)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding QuantumShowPotential, Mode=TwoWay}" Content="Show Potential Barrier V(x)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding QuantumIsSimulating, Mode=TwoWay}" Content="Run Live Unitary Time Evolution" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="SCHRÖDINGER WAVE THEORY"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Time-Dependent Equation (1926):&#x0a;  iħ ∂ψ/∂t = Ĥψ = (-ħ²/2m ∇² + V)ψ&#x0a;&#x0a;• Born Rule (Probability Interpretation):&#x0a;  P(a ≤ x ≤ b) = ∫_a^b |ψ(x, t)|² dx&#x0a;  Unitarity: ∫_{-∞}^∞ |ψ|² dx ≡ 1&#x0a;&#x0a;• Quantum Tunneling Transmission:&#x0a;  T ≈ exp(-2 ∫_{x₁}^{x₂} √(2m(V(x)-E)/ħ²) dx)&#x0a;&#x0a;• Probability Current Density:&#x0a;  J(x) = (ħ/m) Im( ψ* ∂ψ/∂x )&#x0a;  ∂|ψ|²/∂t + ∂J/∂x = 0 (Continuity)&#x0a;&#x0a;• Crank-Nicolson Unitary Propagator:&#x0a;  (1 + i Ĥ Δt/2ħ) ψ^{n+1} = (1 - i Ĥ Δt/2ħ) ψ^n"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 15: SPECIAL RELATIVITY & SPACETIME MINKOWSKI       -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Relativity &amp; Spacetime'}" Spacing="14">

                            <!-- Formula Banner -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="RELATIVISTIC SPACETIME MODEL"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <TextBlock Text="{Binding RelativityFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding RelativityFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Presets Selector -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="RELATIVISTIC SCENARIOS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <WrapPanel>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetRelativityPresetCommand}" CommandParameter="boost">
                                            <TextBlock Text="Lorentz Boost" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetRelativityPresetCommand}" CommandParameter="twin">
                                            <TextBlock Text="Twin Paradox" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetRelativityPresetCommand}" CommandParameter="muon">
                                            <TextBlock Text="Muon Decay" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetRelativityPresetCommand}" CommandParameter="bell">
                                            <TextBlock Text="Bell's Spaceships" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetRelativityPresetCommand}" CommandParameter="doppler">
                                            <TextBlock Text="Doppler Shift" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Boost & Velocity Controls -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="BOOST VELOCITY &amp; VISUALS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="RELATIVE VELOCITY (β = v/c)"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding RelativityBeta, StringFormat='β = {0:F2} c'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="-0.95" Maximum="0.95" Value="{Binding RelativityBeta, Mode=TwoWay}" />

                                    <CheckBox IsChecked="{Binding RelativityShowLightCone, Mode=TwoWay}" Content="Show Invariant Light Cones (x = ±ct)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding RelativityShowHyperbolas, Mode=TwoWay}" Content="Show Calibration Hyperbolas (s² = const)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding RelativityShowSimultaneityGrid, Mode=TwoWay}" Content="Show Simultaneity Grid (ct' = const)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding RelativityShowWorldlines, Mode=TwoWay}" Content="Show Observer Worldlines &amp; Events" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding RelativityIsSimulating, Mode=TwoWay}" Content="Animate Worldline Traversal" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Relativistic Kinematics & Spacetime Invariant Card -->
                            <Border Classes="builderbox">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="KINEMATICS &amp; INVARIANTS"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource MathSurfaceBrush}"
                                                CornerRadius="{DynamicResource MathRadiusSm}"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding RelativitySpacetimeIntervalStatus}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Gamma, Dilation, Contraction Invariants Grid -->
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,2">
                                        <Border Grid.Column="0" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="6,3" Margin="0,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="LORENTZ FACTOR" FontSize="8" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding RelativityLorentzGamma}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="6,3" Margin="3,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="TIME DILATION" FontSize="8" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding RelativityTimeDilationFactor}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="6,3" Margin="3,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="CONTRACTION" FontSize="8" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding RelativityLengthContraction}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="8,4">
                                        <TextBlock Text="{Binding RelativityDopplerShift}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Border>

                                    <!-- Quick Velocity Beta Pills -->
                                    <TextBlock Text="BENCHMARK BOOST VELOCITIES:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,4,0,0" />
                                    <WrapPanel>
                                        <Button Classes="quickchip" Content="Rest (β=0)" Command="{Binding SetRelativityBetaPresetCommand}" CommandParameter="0.0" />
                                        <Button Classes="quickchip" Content="β = 0.50 c" Command="{Binding SetRelativityBetaPresetCommand}" CommandParameter="0.5" />
                                        <Button Classes="quickchip" Content="γ = 2.0 (0.866c)" Command="{Binding SetRelativityBetaPresetCommand}" CommandParameter="0.866" />
                                        <Button Classes="quickchip" Content="γ = 7.1 (0.99c)" Command="{Binding SetRelativityBetaPresetCommand}" CommandParameter="0.99" />
                                        <Button Classes="quickchip" Content="Ultra (0.999c)" Command="{Binding SetRelativityBetaPresetCommand}" CommandParameter="0.999" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="LORENTZ &amp; MINKOWSKI GEOMETRY"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Invariant Spacetime Interval:&#x0a;  s² = (cΔt)² - (Δx)² = inv under all boosts&#x0a;&#x0a;• Lorentz Transformation:&#x0a;  ct' = γ(ct - βx),  x' = γ(x - βct)&#x0a;  γ = 1 / √(1 - β²) ≥ 1&#x0a;&#x0a;• Causal Classification:&#x0a;  s² &gt; 0: Timelike (Δτ = √s²/c)&#x0a;  s² &lt; 0: Spacelike (Δσ = √(-s²))&#x0a;  s² = 0: Lightlike / Null (Photons)&#x0a;&#x0a;• Relativistic Velocity Addition:&#x0a;  u' = (u - v) / (1 - uv/c²)&#x0a;&#x0a;• Relativistic Doppler Factor:&#x0a;  f' = f √((1 - β) / (1 + β))"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 16: FLUID DYNAMICS & 2D NAVIER-STOKES VORTICITY    -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Fluid Dynamics'}" Spacing="14">

                            <!-- Formula Banner -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="FLUID DYNAMICS MODEL"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <TextBlock Text="{Binding FluidFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding FluidFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Reynolds Number & Enstrophy Monitor -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="REYNOLDS &amp; REGIME"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceHighBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding FluidFlowRegimeStatus}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Invariants Grid -->
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,4,4">
                                            <StackPanel>
                                                <TextBlock Text="REYNOLDS NUMBER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding FluidReynoldsNumber}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource MathCardBackgroundBrush}" BorderBrush="{DynamicResource MathBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="4,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="STROUHAL NUMBER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding FluidStrouhalNumber}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Quick Reynolds Preset Pills -->
                                    <TextBlock Text="REYNOLDS REGIME PRESETS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,2,0,0" />
                                    <WrapPanel>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetFluidReynoldsPresetCommand}" CommandParameter="creeping">
                                            <TextBlock Text="Creeping (Re≈330)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetFluidReynoldsPresetCommand}" CommandParameter="karman">
                                            <TextBlock Text="Kármán (Re≈1670)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetFluidReynoldsPresetCommand}" CommandParameter="wake">
                                            <TextBlock Text="Transitional (Re≈3330)" FontSize="10" />
                                        </Button>
                                        <Button Classes="actionpill" Margin="0,0,4,4" Command="{Binding SetFluidReynoldsPresetCommand}" CommandParameter="turbulent">
                                            <TextBlock Text="Turbulent (Re≈6670)" FontSize="10" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Presets Selector -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="HYDRODYNAMIC SCENARIOS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <WrapPanel>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetFluidPresetCommand}" CommandParameter="karman">
                                            <TextBlock Text="Von Kármán Street" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetFluidPresetCommand}" CommandParameter="dipole">
                                            <TextBlock Text="Vortex Dipole" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetFluidPresetCommand}" CommandParameter="kelvin">
                                            <TextBlock Text="Kelvin-Helmholtz" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetFluidPresetCommand}" CommandParameter="taylor">
                                            <TextBlock Text="Taylor-Green" />
                                        </Button>
                                        <Button Classes="actionbtn" Margin="0,0,6,6"
                                                Command="{Binding SetFluidPresetCommand}" CommandParameter="cavity">
                                            <TextBlock Text="Lid-Driven Cavity" />
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Text="Tip: Left-click &amp; drag to inject swirling vorticity; right-click &amp; drag to drop obstacle walls."
                                               FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Viscosity & Layer Controls -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="VISCOSITY &amp; VISUALIZATION"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="KINEMATIC VISCOSITY (ν)"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FluidViscosity, StringFormat='ν = {0:F5}'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.0001" Maximum="0.003" Value="{Binding FluidViscosity, Mode=TwoWay}" />

                                    <CheckBox IsChecked="{Binding FluidShowVorticity, Mode=TwoWay}" Content="Show Vorticity Field ω = ∇×u" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding FluidShowVelocityArrows, Mode=TwoWay}" Content="Show Velocity Vector Arrows" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding FluidShowStreamlines, Mode=TwoWay}" Content="Show Streamlines (Constant ψ)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding FluidShowParticles, Mode=TwoWay}" Content="Show Passive Dye Tracer Particles" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding FluidIsSimulating, Mode=TwoWay}" Content="Run Navier-Stokes Simulation" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="NAVIER-STOKES GOVERNING EQUATIONS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Vorticity Transport Equation:&#x0a;  ∂ω/∂t + (u·∇)ω = ν ∇²ω&#x0a;&#x0a;• Streamfunction Poisson Equation:&#x0a;  ∇²ψ = -ω  (SOR Accelerated)&#x0a;&#x0a;• Incompressibility (Identical):&#x0a;  u = ∂ψ/∂y,  v = -∂ψ/∂x&#x0a;  ∇·u = ∂²ψ/∂x∂y - ∂²ψ/∂y∂x ≡ 0&#x0a;&#x0a;• Reynolds Number:&#x0a;  Re = U L / ν (Inertia vs Viscous)&#x0a;&#x0a;• Semi-Lagrangian Advection:&#x0a;  ω^{n+1}(x) = ω^n(x - u Δt)"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 17: TOPOLOGY & 4D HYPERSURFACE MANIFOLDS          -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Topology &amp; 4D Manifolds'}" Spacing="14">

                            <!-- Mathematical Formulation Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="4D DIFFERENTIAL TOPOLOGY"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding TopologyFormulaTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding TopologyFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 4D Manifold Archetypes Selector -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="MANIFOLD ARCHETYPES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Classes="presetbtn"
                                                Content="Tesseract (8-Cell)"
                                                Command="{Binding SetTopologyPresetCommand}"
                                                CommandParameter="tesseract"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Clifford Flat Torus"
                                                Command="{Binding SetTopologyPresetCommand}"
                                                CommandParameter="clifford"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="4D Klein Bottle"
                                                Command="{Binding SetTopologyPresetCommand}"
                                                CommandParameter="klein"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Hopf Fibration"
                                                Command="{Binding SetTopologyPresetCommand}"
                                                CommandParameter="hopf"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="24-Cell Octaplex"
                                                Command="{Binding SetTopologyPresetCommand}"
                                                CommandParameter="cell24"
                                                Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Hyper-Rotation Controls -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="SO(4) HYPER-ROTATION PARAMETERS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Hyper-Rotation Speed:" FontSize="12" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TopologyRotationSpeed, StringFormat={}{0:F2}x}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.1" Maximum="3.0" Value="{Binding TopologyRotationSpeed, Mode=TwoWay}" />

                                    <Button Command="{Binding ToggleTopologyRotationCommand}"
                                            Background="{DynamicResource MathSurfaceBrush}"
                                            BorderBrush="{DynamicResource MathBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource MathRadiusSm}"
                                            Padding="10,6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center">
                                        <TextBlock Text="Pause / Resume SO(4) Rotation"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Visual Projection Toggles -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="VISUALIZATION MODES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <CheckBox IsChecked="{Binding TopologyShowVertices, Mode=TwoWay}" Content="Show 4D Vertices &amp; Depth Radii" />
                                    <CheckBox IsChecked="{Binding TopologyShowDepthColoring, Mode=TwoWay}" Content="Color by 4D Depth w (Cyan &gt; 0, Rose &lt; 0)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding TopologyShowStereographicSphere, Mode=TwoWay}" Content="Render Equator Projection Sphere" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding TopologyIsRotating, Mode=TwoWay}" Content="Auto-Animate Double Rotation in SO(4)" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="4D TOPOLOGY &amp; FIBER BUNDLES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Euler-Poincaré Characteristic:&#x0a;  χ = Σ (-1)ⁱ fᵢ = V - E + F - C = 0&#x0a;&#x0a;• Double Rotation in SO(4):&#x0a;  Lie algebra so(4) ≅ so(3) ⊕ so(3)&#x0a;  Isoclinic right- &amp; left-handed rotations&#x0a;&#x0a;• Stereographic Conformal Map:&#x0a;  P(x,y,z,w) = (x, y, z) / (R - w)&#x0a;  Preserves intersection angles strictly&#x0a;&#x0a;• Hopf Fibration (S³ → S²):&#x0a;  (z₁, z₂) ↦ z₁/z₂ ∈ ℂP¹ ≅ S²&#x0a;  Every point on S² pulls back to a Villarceau circle S¹&#x0a;&#x0a;• Interactive Navigation:&#x0a;  Left-drag = 3D camera yaw/pitch&#x0a;  Right-drag = 4D XW hyper-rotation plane"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 18: CELESTIAL MECHANICS & N-BODY GRAVITATION      -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Celestial &amp; N-Body'}" Spacing="14">

                            <!-- Mathematical Formulation Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="N-BODY GRAVITATIONAL DYNAMICS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding CelestialFormulaTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding CelestialFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Celestial Scenarios Selector -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="ORBITAL ARCHETYPES &amp; CHAOS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Classes="presetbtn"
                                                Content="Figure-8 Choreography"
                                                Command="{Binding SetCelestialPresetCommand}"
                                                CommandParameter="figure8"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Lagrange L4/L5 Trojans"
                                                Command="{Binding SetCelestialPresetCommand}"
                                                CommandParameter="lagrange"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Pythagorean 3-Body Chaos"
                                                Command="{Binding SetCelestialPresetCommand}"
                                                CommandParameter="pythagorean"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Sun-Earth-Moon System"
                                                Command="{Binding SetCelestialPresetCommand}"
                                                CommandParameter="sunearthmoon"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Galactic Collision &amp; Tides"
                                                Command="{Binding SetCelestialPresetCommand}"
                                                CommandParameter="galaxy"
                                                Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Symplectic Time-Step Controls -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="SYMPLECTIC INTEGRATOR PARAMETERS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Time Step (Δt):" FontSize="12" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CelestialTimeStep, StringFormat={}{0:F4}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.001" Maximum="0.015" Value="{Binding CelestialTimeStep, Mode=TwoWay}" />

                                    <Button Command="{Binding ToggleCelestialSimulationCommand}"
                                            Background="{DynamicResource MathSurfaceBrush}"
                                            BorderBrush="{DynamicResource MathBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource MathRadiusSm}"
                                            Padding="10,6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center">
                                        <TextBlock Text="Pause / Resume N-Body Simulation"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Visual Display Toggles -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="VISUALIZATION MODES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <CheckBox IsChecked="{Binding CelestialShowTrails, Mode=TwoWay}" Content="Show Fading Orbital Trajectory Trails" />
                                    <CheckBox IsChecked="{Binding CelestialShowVelocityVectors, Mode=TwoWay}" Content="Show Velocity Vectors (v)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding CelestialShowCenterOfMass, Mode=TwoWay}" Content="Show Center of Mass (R_cm)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding CelestialShowPotentialGrid, Mode=TwoWay}" Content="Render Gravitational Potential Well Grid" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding CelestialIsSimulating, Mode=TwoWay}" Content="Run Symplectic Leapfrog Integration" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="GRAVITATIONAL HAMILTONIAN &amp; INVARIANTS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Universal Gravitation Law:&#x0a;  a_i = Σ_{j≠i} G m_j (r_j - r_i) / (r_ij² + ε²)^{3/2}&#x0a;&#x0a;• Symplectic Störmer-Verlet (Leapfrog):&#x0a;  v^{n+1/2} = v^n + a(r^n) Δt/2&#x0a;  r^{n+1} = r^n + v^{n+1/2} Δt&#x0a;  v^{n+1} = v^{n+1/2} + a(r^{n+1}) Δt/2&#x0a;  Conserves shadow Hamiltonian (no secular drift)&#x0a;&#x0a;• Conservation Laws (Strict):&#x0a;  Total Energy E = T + V ≡ const&#x0a;  Linear Momentum P = Σ m_i v_i ≡ const&#x0a;  Angular Momentum L = Σ m_i (r_i × v_i) ≡ const&#x0a;&#x0a;• 3D Camera Controls:&#x0a;  Left-drag = orbit yaw/pitch&#x0a;  Right-drag = pan center&#x0a;  Scroll wheel = zoom distance&#x0a;  Hover = probe celestial body metrics"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 19: HYPERBOLIC & NON-EUCLIDEAN GEOMETRY           -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Hyperbolic Geometry'}" Spacing="14">

                            <!-- Mathematical Formulation Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="NON-EUCLIDEAN DIFFERENTIAL GEOMETRY"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding HyperbolicFormulaTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding HyperbolicFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Hyperbolic Archetypes & Tessellations -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="TESSELLATIONS &amp; IDEAL TRIANGLES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Classes="presetbtn"
                                                Content="Heptagonal {7, 3}"
                                                Command="{Binding SetHyperbolicPresetCommand}"
                                                CommandParameter="heptagonal"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Octagonal {8, 3}"
                                                Command="{Binding SetHyperbolicPresetCommand}"
                                                CommandParameter="octagonal"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Order-5 Square {4, 5}"
                                                Command="{Binding SetHyperbolicPresetCommand}"
                                                CommandParameter="square5"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Ideal Triangle (Area=π)"
                                                Command="{Binding SetHyperbolicPresetCommand}"
                                                CommandParameter="ideal"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Gauss-Bonnet Holonomy"
                                                Command="{Binding SetHyperbolicPresetCommand}"
                                                CommandParameter="holonomy"
                                                Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Model Selector: Poincaré Disk vs Klein-Beltrami -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="HYPERBOLIC PROJECTION MODEL"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,*">
                                        <Button Grid.Column="0"
                                                Content="Poincaré Conformal"
                                                Command="{Binding SetHyperbolicModelCommand}"
                                                CommandParameter="poincare"
                                                Margin="0,0,4,0" />
                                        <Button Grid.Column="1"
                                                Content="Klein-Beltrami Chords"
                                                Command="{Binding SetHyperbolicModelCommand}"
                                                CommandParameter="klein"
                                                Margin="4,0,0,0" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Tessellation Reflection Depth:" FontSize="12" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding HyperbolicTilingDepth}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="3" Value="{Binding HyperbolicTilingDepth, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Visual Display Toggles -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="VISUALIZATION MODES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <CheckBox IsChecked="{Binding HyperbolicShowTessellation, Mode=TwoWay}" Content="Show Tessellation Geodesics" />
                                    <CheckBox IsChecked="{Binding HyperbolicShowVertices, Mode=TwoWay}" Content="Show Hyperbolic Tiling Vertices" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding HyperbolicShowInteractiveTriangle, Mode=TwoWay}" Content="Interactive Gauss-Bonnet Triangle (Handles A, B, C)" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="GAUSS-BONNET &amp; HYPERBOLIC GEODESICS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Poincaré Conformal Metric:&#x0a;  ds² = 4 (dx² + dy²) / (1 - r²)²&#x0a;  Constant Gaussian curvature K = -1&#x0a;&#x0a;• Hyperbolic Distance:&#x0a;  d(z₁, z₂) = 2 artanh |(z₁ - z₂)/(1 - z₁ z̄₂)|&#x0a;&#x0a;• Gauss-Bonnet Theorem in ℍ²:&#x0a;  ∬_Δ K dA + Σ (π - αᵢ) = 2π&#x0a;  -Area(Δ) + 3π - (α + β + γ) = 2π&#x0a;  Area(Δ) = π - (α + β + γ)  (Angle Defect!)&#x0a;&#x0a;• Klein-Beltrami Projective Map:&#x0a;  w = 2z / (1 + |z|²)&#x0a;  Maps circular geodesics to straight lines&#x0a;&#x0a;• Interactive Navigation:&#x0a;  Left-drag handles A, B, C = reform triangle&#x0a;  Right-drag = pan Poincaré disk&#x0a;  Scroll wheel = zoom into boundary horizon"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- DRAWER 20: INFORMATION THEORY & ENTROPY          -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Information &amp; Entropy'}" Spacing="14">
                            <!-- Formula & Theory Badge -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="INFORMATION THEORY &amp; SIGNAL ENCODING"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding InformationFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextLightBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding InformationFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Information Theory Presets -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="SHANNON &amp; CHANNEL PRESETS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel>
                                        <Button Classes="presetbtn"
                                                Content="Shannon &amp; Huffman"
                                                Command="{Binding SetInformationPresetCommand}"
                                                CommandParameter="huffman"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="16-QAM Constellation"
                                                Command="{Binding SetInformationPresetCommand}"
                                                CommandParameter="qam16"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="QPSK Modulation"
                                                Command="{Binding SetInformationPresetCommand}"
                                                CommandParameter="qpsk"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="BSC Channel &amp; Hb(p)"
                                                Command="{Binding SetInformationPresetCommand}"
                                                CommandParameter="bsc"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="KL Relative Entropy"
                                                Command="{Binding SetInformationPresetCommand}"
                                                CommandParameter="kldiv"
                                                Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Interactive Source Text Input (for Huffman & Entropy) -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="TEXT SOURCE &amp; ALPHABET (REAL-TIME)"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <TextBox Text="{Binding InformationSourceText, Mode=TwoWay}"
                                             PlaceholderText="Type text to recompute Huffman tree..."
                                             FontSize="11"
                                             Padding="8,6" />
                                </StackPanel>
                            </Border>

                            <!-- Channel Modulation & SNR Slider -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CHANNEL &amp; MODULATION PARAMETERS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Text="Signal-to-Noise Ratio (SNR dB):" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding InformationSnrDb, StringFormat='{}{0:F1} dB'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="-5" Maximum="30" Value="{Binding InformationSnrDb, Mode=TwoWay}" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Text="BSC Crossover Probability (p):" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding InformationCrossoverProbability, StringFormat='{}{0:F3}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.0" Maximum="0.5" Value="{Binding InformationCrossoverProbability, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Visualization Layer Toggles -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="VISUALIZATION MODES"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <CheckBox IsChecked="{Binding InformationShowTreeBranches, Mode=TwoWay}" Content="Show Huffman Tree Branches &amp; Codes" />
                                    <CheckBox IsChecked="{Binding InformationShowProbabilityBars, Mode=TwoWay}" Content="Show Alphabet Spectrum &amp; Surprise" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding InformationShowConstellationCloud, Mode=TwoWay}" Content="Show Noisy Received Symbols Cloud" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="SHANNON'S FOUNDATIONAL LAWS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Shannon Information Entropy:&#x0a;  H(X) = -Σ pᵢ log₂(pᵢ)  [bits]&#x0a;  Lossless source compression limit&#x0a;&#x0a;• Source Coding Theorem:&#x0a;  H(X) ≤ L &lt; H(X) + 1&#x0a;  Huffman code achieves optimal prefix-free tree&#x0a;&#x0a;• Shannon-Hartley Capacity:&#x0a;  C = B · log₂(1 + S/N)  [bits/sec]&#x0a;  Max reliable rate over AWGN channel&#x0a;&#x0a;• Kullback-Leibler Relative Entropy:&#x0a;  D_KL(P ‖ Q) = Σ pᵢ log₂(pᵢ / qᵢ) ≥ 0&#x0a;  Information inefficiency penalty&#x0a;&#x0a;• Binary Entropy Function:&#x0a;  H_b(p) = -p log₂ p - (1-p) log₂(1-p)&#x0a;  BSC Capacity: C = 1 - H_b(p)"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- DRAWER 21: CLASSICAL MECHANICS & LAGRANGIAN DYNAMICS -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Classical Mechanics'}" Spacing="14">
                            <!-- Formula & Theory Badge -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="CLASSICAL MECHANICS &amp; LAGRANGIAN DYNAMICS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding LagrangianFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextLightBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LagrangianFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Presets -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="LAGRANGIAN &amp; CHAOS PRESETS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel>
                                        <Button Classes="presetbtn"
                                                Content="Double Pendulum Chaos"
                                                Command="{Binding SetLagrangianPresetCommand}"
                                                CommandParameter="double"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Poincaré Section &amp; KAM"
                                                Command="{Binding SetLagrangianPresetCommand}"
                                                CommandParameter="poincare"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Kapitza Inverted"
                                                Command="{Binding SetLagrangianPresetCommand}"
                                                CommandParameter="kapitza"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Spring Pendulum"
                                                Command="{Binding SetLagrangianPresetCommand}"
                                                CommandParameter="spring"
                                                Margin="0,0,6,6" />
                                        <Button Classes="presetbtn"
                                                Content="Foucault Precession"
                                                Command="{Binding SetLagrangianPresetCommand}"
                                                CommandParameter="foucault"
                                                Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Link Lengths & Masses -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="PENDULUM LINK &amp; MASS PARAMETERS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBlock Text="Link Length L₁:" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding LagrangianL1, StringFormat='{}{0:F2} m'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.4" Maximum="1.8" Value="{Binding LagrangianL1, Mode=TwoWay}" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Text="Link Length L₂:" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding LagrangianL2, StringFormat='{}{0:F2} m'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.3" Maximum="1.6" Value="{Binding LagrangianL2, Mode=TwoWay}" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Text="Bob Mass m₁:" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding LagrangianM1, StringFormat='{}{0:F2} kg'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.2" Maximum="3.0" Value="{Binding LagrangianM1, Mode=TwoWay}" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBlock Text="Bob Mass m₂:" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding LagrangianM2, StringFormat='{}{0:F2} kg'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="0.2" Maximum="3.0" Value="{Binding LagrangianM2, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Visualization & Simulation Toggles -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="VISUALIZATION &amp; SIMULATION"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <CheckBox IsChecked="{Binding LagrangianShowShadow, Mode=TwoWay}" Content="Show Shadow Trajectory (Lyapunov Divergence)" />
                                    <CheckBox IsChecked="{Binding LagrangianShowTrails, Mode=TwoWay}" Content="Show Phosphor Orbital Trails" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding LagrangianShowPhasePortrait, Mode=TwoWay}" Content="Show Poincaré Section &amp; Energy Gauge" Margin="0,4,0,0" />

                                    <Button Classes="presetbtn"
                                            Content="Play / Pause Simulation"
                                            Command="{Binding ToggleLagrangianSimulationCommand}"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Mechanical Energy & Action Invariant Card -->
                            <Border Classes="builderbox">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="ENERGY &amp; REGIME"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource MathSurfaceBrush}"
                                                CornerRadius="{DynamicResource MathRadiusSm}"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding LagrangianMotionRegime}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Kinetic, Potential, Total Energy Gauges -->
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,2">
                                        <Border Grid.Column="0" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="6,3" Margin="0,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="TOTAL E = T + V" FontSize="8" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding LagrangianTotalEnergy, StringFormat='{}{0:F2} J'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="6,3" Margin="3,0,3,0">
                                            <StackPanel>
                                                <TextBlock Text="KINETIC T" FontSize="8" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding LagrangianKineticEnergy, StringFormat='{}{0:F2} J'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="6,3" Margin="3,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="POTENTIAL V" FontSize="8" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding LagrangianPotentialEnergy, StringFormat='{}{0:F2} J'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Quick Motion Regime Triggers -->
                                    <TextBlock Text="DYNAMIC REGIME BUILDER:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,4,0,0" />
                                    <WrapPanel>
                                        <Button Classes="quickchip" Content="Regular (KAM Torus)" Command="{Binding SetLagrangianRegimeCommand}" CommandParameter="regular" />
                                        <Button Classes="quickchip" Content="Deterministic Chaos" Command="{Binding SetLagrangianRegimeCommand}" CommandParameter="chaotic" />
                                        <Button Classes="quickchip" Content="High-Inertia Regime" Command="{Binding SetLagrangianRegimeCommand}" CommandParameter="high_energy" />
                                        <Button Classes="quickchip" Content="Kapitza Dynamic Lock" Command="{Binding SetLagrangianRegimeCommand}" CommandParameter="inverted" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="HAMILTONIAN CHAOS &amp; EULER-LAGRANGE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Lagrangian Function:&#x0a;  ℒ = T - V = ½(m₁+m₂)L₁²θ̇₁² + ½m₂L₂²θ̇₂² + m₂L₁L₂θ̇₁θ̇₂ cos(θ₁-θ₂) + (m₁+m₂)gL₁ cos θ₁ + m₂gL₂ cos θ₂&#x0a;&#x0a;• Euler-Lagrange Motion:&#x0a;  d/dt(∂ℒ/∂θ̇ᵢ) - ∂ℒ/∂θᵢ = 0&#x0a;&#x0a;• Lyapunov Exponent:&#x0a;  ‖Δθ(t)‖ ≈ ‖Δθ(0)‖ · exp(λ t)  (λ &gt; 0)&#x0a;  Positive exponent implies exponential sensitivity to initial conditions (Butterfly Effect)&#x0a;&#x0a;• Poincaré Map &amp; KAM Torus:&#x0a;  Preserves symplectic phase-space volume via Liouville's theorem. Demonstrates transition from regular KAM tori to ergodic chaos."
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>


                        <!-- Mode 22 Controls: Cryptography, Elliptic Curves & Finite Fields -->
                        <StackPanel Spacing="16" IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Cryptography &amp; Finite Fields'}">

                            <!-- Formula and Derivation Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="MODERN CRYPTOGRAPHY &amp; FINITE FIELDS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}" />

                                    <TextBlock Text="{Binding CryptoFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding CryptoFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Presets -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="ELLIPTIC CURVE PRESETS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="secp256k1 (Bitcoin)"
                                                Command="{Binding SetCryptoPresetCommand}"
                                                CommandParameter="secp256k1"
                                                Classes="preset"
                                                Margin="0,0,6,6" />
                                        <Button Content="Two Components (Egg)"
                                                Command="{Binding SetCryptoPresetCommand}"
                                                CommandParameter="twocomponents"
                                                Classes="preset"
                                                Margin="0,0,6,6" />
                                        <Button Content="Singular Nodal (Δ = 0)"
                                                Command="{Binding SetCryptoPresetCommand}"
                                                CommandParameter="nodal"
                                                Classes="preset"
                                                Margin="0,0,6,6" />
                                        <Button Content="Singular Cusp"
                                                Command="{Binding SetCryptoPresetCommand}"
                                                CommandParameter="cusp"
                                                Classes="preset"
                                                Margin="0,0,6,6" />
                                        <Button Content="Finite Field Grid"
                                                Command="{Binding SetCryptoPresetCommand}"
                                                CommandParameter="finite"
                                                Classes="preset"
                                                Margin="0,0,6,6" />
                                        <Button Content="ECDH Key Exchange"
                                                Command="{Binding SetCryptoPresetCommand}"
                                                CommandParameter="ecdh"
                                                Classes="preset"
                                                Margin="0,0,6,6" />
                                        <Button Content="ECDLP Trapdoor Scatter"
                                                Command="{Binding SetCryptoPresetCommand}"
                                                CommandParameter="ecdlp"
                                                Classes="preset"
                                                Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Mode Selector Tabs -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="VISUALIZATION VIEW MODE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,*,*,*" Margin="0,4,0,0">
                                        <Button Grid.Column="0" Content="Real"
                                                Command="{Binding SetCryptoModeCommand}" CommandParameter="real"
                                                Classes="preset" HorizontalAlignment="Stretch" Margin="0,0,3,0" />
                                        <Button Grid.Column="1" Content="Finite"
                                                Command="{Binding SetCryptoModeCommand}" CommandParameter="finite"
                                                Classes="preset" HorizontalAlignment="Stretch" Margin="3,0,3,0" />
                                        <Button Grid.Column="2" Content="ECDH"
                                                Command="{Binding SetCryptoModeCommand}" CommandParameter="ecdh"
                                                Classes="preset" HorizontalAlignment="Stretch" Margin="3,0,3,0" />
                                        <Button Grid.Column="3" Content="ECDLP"
                                                Command="{Binding SetCryptoModeCommand}" CommandParameter="ecdlp"
                                                Classes="preset" HorizontalAlignment="Stretch" Margin="3,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Discriminant & Topology Probe Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="WEIERSTRASS DISCRIMINANT &amp; TOPOLOGY"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <Border Grid.Column="1" Background="#26A855F7" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding CryptoDiscriminantText}"
                                                       FontSize="10"
                                                       FontFamily="Consolas, Menlo, monospace"
                                                       Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Topology Badge -->
                                    <Border Background="{DynamicResource MathSurfaceBrush}"
                                            BorderBrush="{DynamicResource MathBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,6">
                                        <TextBlock Text="{Binding CryptoCurveTopologyBadge}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Border>

                                    <!-- Quick Curve Geometry Pills -->
                                    <TextBlock Text="Quick Curve Geometries:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,2,0,0" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="secp256k1 (a=0, b=7)" Command="{Binding SetCryptoCurveCoeffsCommand}" CommandParameter="bitcoin" Classes="quickchip" Margin="0,0,4,4" />
                                        <Button Content="Two Components (a=-3, b=1)" Command="{Binding SetCryptoCurveCoeffsCommand}" CommandParameter="twocomp" Classes="quickchip" Margin="0,0,4,4" />
                                        <Button Content="Cusp Degenerate (a=0, b=0)" Command="{Binding SetCryptoCurveCoeffsCommand}" CommandParameter="cusp" Classes="quickchip" Margin="0,0,4,4" />
                                        <Button Content="Node Singular (a=-3, b=2)" Command="{Binding SetCryptoCurveCoeffsCommand}" CommandParameter="node" Classes="quickchip" Margin="0,0,4,4" />
                                    </WrapPanel>

                                    <!-- Finite Field Modulus p Pills -->
                                    <TextBlock Text="Finite Field Prime Modulus 𝔽ₚ:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,2,0,0" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="p = 17" Command="{Binding SetCryptoPrimePCommand}" CommandParameter="17" Classes="quickchip" Margin="0,0,4,4" />
                                        <Button Content="p = 23" Command="{Binding SetCryptoPrimePCommand}" CommandParameter="23" Classes="quickchip" Margin="0,0,4,4" />
                                        <Button Content="p = 29" Command="{Binding SetCryptoPrimePCommand}" CommandParameter="29" Classes="quickchip" Margin="0,0,4,4" />
                                        <Button Content="p = 31" Command="{Binding SetCryptoPrimePCommand}" CommandParameter="31" Classes="quickchip" Margin="0,0,4,4" />
                                        <Button Content="p = 37" Command="{Binding SetCryptoPrimePCommand}" CommandParameter="37" Classes="quickchip" Margin="0,0,4,4" />
                                        <Button Content="p = 43" Command="{Binding SetCryptoPrimePCommand}" CommandParameter="43" Classes="quickchip" Margin="0,0,4,4" />
                                        <Button Content="p = 61" Command="{Binding SetCryptoPrimePCommand}" CommandParameter="61" Classes="quickchip" Margin="0,0,4,4" />
                                        <Button Content="p = 97" Command="{Binding SetCryptoPrimePCommand}" CommandParameter="97" Classes="quickchip" Margin="0,0,4,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Parameter Controls -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CURVE &amp; CRYPTO PARAMETERS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <!-- Param A Slider -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Weierstrass a:" FontSize="11" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CryptoParamA, StringFormat='{}{0:F1}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="-5.0" Maximum="5.0" Value="{Binding CryptoParamA, Mode=TwoWay}" />

                                    <!-- Param B Slider -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Weierstrass b:" FontSize="11" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CryptoParamB, StringFormat='{}{0:F1}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="-10.0" Maximum="10.0" Value="{Binding CryptoParamB, Mode=TwoWay}" />

                                    <!-- Alice Private Key -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Alice Private Key (d_A):" FontSize="11" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CryptoAlicePrivateKey}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="2" Maximum="25" Value="{Binding CryptoAlicePrivateKey, Mode=TwoWay}" />

                                    <!-- Bob Private Key -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Bob Private Key (d_B):" FontSize="11" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CryptoBobPrivateKey}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="2" Maximum="25" Value="{Binding CryptoBobPrivateKey, Mode=TwoWay}" />

                                    <!-- Scalar multiplier K -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="ECDLP Hopping Multiplier (k):" FontSize="11" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CryptoScalarK}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>
                                    <Slider Minimum="2" Maximum="50" Value="{Binding CryptoScalarK, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Display Toggles -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="VISUALIZATION OVERLAYS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <CheckBox IsChecked="{Binding CryptoShowTangentSecant, Mode=TwoWay}" Content="Show Chord / Tangent Line" />
                                    <CheckBox IsChecked="{Binding CryptoShowReflectionLines, Mode=TwoWay}" Content="Show Vertical Reflection (R' → R)" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ELLIPTIC CURVE CRYPTOGRAPHY RIGOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Weierstrass Normal Form:&#x0a;  y² = x³ + a x + b&#x0a;&#x0a;• Non-Singularity Condition:&#x0a;  Δ = -16(4a³ + 27b²) ≠ 0&#x0a;  Roots of x³ + ax + b are distinct&#x0a;&#x0a;• Hasse's Theorem on E(F_p):&#x0a;  |#E(F_p) - (p + 1)| ≤ 2√p&#x0a;&#x0a;• Diffie-Hellman Key Agreement:&#x0a;  Alice computes S = d_A · Q_B = d_A(d_B G)&#x0a;  Bob computes S = d_B · Q_A = d_B(d_A G)&#x0a;  Security relies on hardness of ECDLP: finding k from Q = k·G requires O(√n) group operations."
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Mode 23 Controls: Discrete Dynamical Systems, Arnold's Cat Map & IFS -->
                        <StackPanel Spacing="16" IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Discrete Dynamics &amp; Chaos'}">

                            <!-- Header Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="DISCRETE DYNAMICS &amp; CHAOS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DiscreteDynamicsFormulaTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextBrush}" />
                                    <TextBlock Text="{Binding DiscreteDynamicsFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Mode Selector Buttons -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="DYNAMICAL SYSTEM MODE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Arnold Cat"
                                                Classes="preset-chip"
                                                Command="{Binding SetDiscreteDynamicsPresetCommand}"
                                                CommandParameter="arnold"
                                                Margin="0,0,6,6" />
                                        <Button Content="Logistic Cobweb"
                                                Classes="preset-chip"
                                                Command="{Binding SetDiscreteDynamicsPresetCommand}"
                                                CommandParameter="cobweb"
                                                Margin="0,0,6,6" />
                                        <Button Content="Bifurcation Tree"
                                                Classes="preset-chip"
                                                Command="{Binding SetDiscreteDynamicsPresetCommand}"
                                                CommandParameter="bifurcation"
                                                Margin="0,0,6,6" />
                                        <Button Content="Barnsley Fern"
                                                Classes="preset-chip"
                                                Command="{Binding SetDiscreteDynamicsPresetCommand}"
                                                CommandParameter="barnsley"
                                                Margin="0,0,6,6" />
                                        <Button Content="Sierpinski"
                                                Classes="preset-chip"
                                                Command="{Binding SetDiscreteDynamicsPresetCommand}"
                                                CommandParameter="sierpinski"
                                                Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Arnold's Cat Map Specific Controls -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12"
                                    IsVisible="{Binding DiscreteDynamicsDisplayMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='arnold'}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="ARNOLD TORAL ITERATION"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="*,*">
                                        <Button Grid.Column="0" Content="Step (+1)"
                                                Classes="action"
                                                Command="{Binding StepArnoldCatCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Margin="0,0,4,0" />
                                        <Button Grid.Column="1" Content="Reset (0)"
                                                Classes="action"
                                                Command="{Binding ResetArnoldCatCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Margin="4,0,0,0" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Column="0" Text="Step:" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="48"
                                                Value="{Binding DiscreteDynamicsCatStep, Mode=TwoWay}"
                                                Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding DiscreteDynamicsCatStep, StringFormat='{}{0} / 48'}"
                                                   FontFamily="Consolas, monospace" FontSize="11" Width="50" TextAlignment="Right" />
                                    </Grid>

                                    <CheckBox IsChecked="{Binding DiscreteDynamicsShowEigenvectors, Mode=TwoWay}" Content="Show Unstable &amp; Stable Eigenspaces" />
                                </StackPanel>
                            </Border>

                            <!-- Logistic Map / Cobweb / Bifurcation Controls -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12"
                                    IsVisible="{Binding DiscreteDynamicsDisplayMode, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='arnold'}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="LOGISTIC PARAMETERS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="r (growth):" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" Width="70" />
                                        <Slider Grid.Column="1" Minimum="1.0" Maximum="4.0"
                                                Value="{Binding DiscreteDynamicsLogisticR, Mode=TwoWay}"
                                                Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding DiscreteDynamicsLogisticR, StringFormat='{}{0:F3}'}"
                                                   FontFamily="Consolas, monospace" FontSize="11" Width="44" TextAlignment="Right" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="x₀ (initial):" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" Width="70" />
                                        <Slider Grid.Column="1" Minimum="0.01" Maximum="0.99"
                                                Value="{Binding DiscreteDynamicsLogisticX0, Mode=TwoWay}"
                                                Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding DiscreteDynamicsLogisticX0, StringFormat='{}{0:F3}'}"
                                                   FontFamily="Consolas, monospace" FontSize="11" Width="44" TextAlignment="Right" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Steps (N):" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" Width="70" />
                                        <Slider Grid.Column="1" Minimum="10" Maximum="120"
                                                Value="{Binding DiscreteDynamicsCobwebSteps, Mode=TwoWay}"
                                                Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding DiscreteDynamicsCobwebSteps, StringFormat='{}{0}'}"
                                                   FontFamily="Consolas, monospace" FontSize="11" Width="44" TextAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="DISCRETE DYNAMICS &amp; CHAOS RIGOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Arnold's Toral Automorphism:&#x0a;  [x'; y'] = [2 1; 1 1] [x; y] mod 1&#x0a;  det(A) = 1 (Symplectic Area-Preserving)&#x0a;  λ₁ = (3+√5)/2 ≈ 2.6180 (Unstable)&#x0a;  λ₂ = (3-√5)/2 ≈ 0.3820 (Stable)&#x0a;  Lyapunov Exponent λ = ln λ₁ ≈ 0.9624&#x0a;  Recurrence on 64×64: T = 48 steps&#x0a;&#x0a;• Logistic 1D Quadratic Map:&#x0a;  x_{n+1} = r x_n (1 - x_n)&#x0a;  Bifurcation cascade: r_∞ ≈ 3.5699456&#x0a;  Feigenbaum δ = lim (r_n - r_{n-1})/(r_{n+1} - r_n) ≈ 4.6692&#x0a;  Feigenbaum α = lim d_n / d_{n+1} ≈ 2.5029&#x0a;&#x0a;• Iterated Function System (IFS):&#x0a;  Hutchinson operator: W(E) = ⋃ w_i(E)&#x0a;  Unique non-empty compact attractor E = W(E)"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Mode 24 Controls: Bifurcation & Catastrophe Theory (René Thom) -->
                        <StackPanel Spacing="16" IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Bifurcation &amp; Catastrophe Theory'}">

                            <!-- Header Card -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="BIFURCATION &amp; CATASTROPHE THEORY"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding CatastropheFormulaTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextBrush}" />
                                    <TextBlock Text="{Binding CatastropheFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Mode Selector Buttons -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ELEMENTARY CATASTROPHE TYPE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Cusp (A₃)"
                                                Classes="preset-chip"
                                                Command="{Binding SetCatastrophePresetCommand}"
                                                CommandParameter="cusp"
                                                Margin="0,0,6,6" />
                                        <Button Content="Fold (A₂)"
                                                Classes="preset-chip"
                                                Command="{Binding SetCatastrophePresetCommand}"
                                                CommandParameter="fold"
                                                Margin="0,0,6,6" />
                                        <Button Content="Butterfly (A₅)"
                                                Classes="preset-chip"
                                                Command="{Binding SetCatastrophePresetCommand}"
                                                CommandParameter="butterfly"
                                                Margin="0,0,6,6" />
                                        <Button Content="Zeeman Machine"
                                                Classes="preset-chip"
                                                Command="{Binding SetCatastrophePresetCommand}"
                                                CommandParameter="zeeman"
                                                Margin="0,0,6,6" />
                                        <Button Content="Swallowtail (A₄)"
                                                Classes="preset-chip"
                                                Command="{Binding SetCatastrophePresetCommand}"
                                                CommandParameter="swallowtail"
                                                Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Cusp Discriminant & Hysteresis Jump Controller -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="CUSP DISCRIMINANT &amp; STABILITY REGIME"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <Border Grid.Column="1" Background="#26F43F5E" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding CatastropheCuspDiscriminant, StringFormat='Δ = 4a³+27b² = {0:F2}'}"
                                                       FontSize="10"
                                                       FontFamily="Consolas, Menlo, monospace"
                                                       Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Status Badge -->
                                    <Border Background="{DynamicResource MathSurfaceBrush}"
                                            BorderBrush="{DynamicResource MathBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,6">
                                        <TextBlock Text="{Binding CatastropheCuspStatus}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Action Buttons -->
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                                        <Button Grid.Column="0" Content="Invert Normal b"
                                                Command="{Binding TriggerHysteresisSweepCommand}"
                                                Classes="preset-chip" Margin="0,0,3,0" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="Singular Origin"
                                                Command="{Binding SetCatastropheCriticalPointCommand}"
                                                Classes="preset-chip" Margin="3,0,3,0" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="2" Content="Maxwell Bimodal"
                                                Command="{Binding SetCatastropheMaxwellPointCommand}"
                                                Classes="preset-chip" Margin="3,0,0,0" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Parameters Inspector -->
                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CONTROL PARAMETERS &amp; STATE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="a (splitting):" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" Width="80" />
                                        <Slider Grid.Column="1" Minimum="-4.0" Maximum="1.5"
                                                Value="{Binding CatastropheParamA, Mode=TwoWay}"
                                                Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding CatastropheParamA, StringFormat='{}{0:F2}'}"
                                                   FontFamily="Consolas, monospace" FontSize="11" Width="44" TextAlignment="Right" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="b (normal):" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" Width="80" />
                                        <Slider Grid.Column="1" Minimum="-3.0" Maximum="3.0"
                                                Value="{Binding CatastropheParamB, Mode=TwoWay}"
                                                Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding CatastropheParamB, StringFormat='{}{0:F2}'}"
                                                   FontFamily="Consolas, monospace" FontSize="11" Width="44" TextAlignment="Right" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="x (state):" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" Width="80" />
                                        <Slider Grid.Column="1" Minimum="-2.5" Maximum="2.5"
                                                Value="{Binding CatastropheStateX, Mode=TwoWay}"
                                                Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding CatastropheStateX, StringFormat='{}{0:F3}'}"
                                                   FontFamily="Consolas, monospace" FontSize="11" Width="44" TextAlignment="Right" />
                                    </Grid>

                                    <CheckBox IsChecked="{Binding CatastropheShowBifurcationSet, Mode=TwoWay}" Content="Show Bifurcation Set (Neil's Parabola)" />
                                    <CheckBox IsChecked="{Binding CatastropheShowPotentialWell, Mode=TwoWay}" Content="Show Potential Energy Wells V(x)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding CatastropheShowEquilibriumSurface, Mode=TwoWay}" Content="Show 3D Pleated Equilibrium Manifold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="CATASTROPHE &amp; SINGULARITY RIGOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• René Thom's Theorem (1972):&#x0a;  Gradient dynamical system dx/dt = -∇V(x; c)&#x0a;  Up to 4 control parameters: at most 7 structurally stable elementary catastrophes.&#x0a;&#x0a;• Fold Catastrophe (A₂):&#x0a;  V(x) = ⅓x³ + ax&#x0a;  Bifurcation set: a = 0 (Saddle-Node Annihilation)&#x0a;&#x0a;• Cusp Catastrophe (A₃):&#x0a;  V(x) = ¼x⁴ + ½ax² + bx&#x0a;  Bifurcation set: 4a³ + 27b² = 0&#x0a;  Pleated S-manifold: x³ + ax + b = 0&#x0a;  Singularity condition: V'(x) = 0 and V''(x) = 0&#x0a;&#x0a;• Hysteresis &amp; Discontinuous Jump:&#x0a;  Moving control point (a, b) across fold line destroys local minimum, forcing an instantaneous jump to the alternative sheet."
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Mode 25 Controls: Clifford Geometric Algebra & Multivector Calculus -->
                        <StackPanel Spacing="16" IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Clifford Geometric Algebra'}">
                            <!-- Hero Title & Theory Capsule -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="CLIFFORD GEOMETRIC ALGEBRA G₃"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding CliffordFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CliffordFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Mode Selector Buttons -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="GEOMETRIC EXPERIMENT PRESET"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Content="Wedge (a ∧ b)"
                                                Classes="presetbtn"
                                                Margin="0,0,6,6"
                                                Command="{Binding SetCliffordPresetCommand}"
                                                CommandParameter="wedge" />
                                        <Button Content="Rotor Rotation"
                                                Classes="presetbtn"
                                                Margin="0,0,6,6"
                                                Command="{Binding SetCliffordPresetCommand}"
                                                CommandParameter="rotor" />
                                        <Button Content="Reflections"
                                                Classes="presetbtn"
                                                Margin="0,0,6,6"
                                                Command="{Binding SetCliffordPresetCommand}"
                                                CommandParameter="reflection" />
                                        <Button Content="Maxwell Bivector"
                                                Classes="presetbtn"
                                                Margin="0,0,6,6"
                                                Command="{Binding SetCliffordPresetCommand}"
                                                CommandParameter="maxwell" />
                                        <Button Content="Spacetime Boost"
                                                Classes="presetbtn"
                                                Margin="0,0,6,6"
                                                Command="{Binding SetCliffordPresetCommand}"
                                                CommandParameter="spacetime" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Vector & Parameter Sliders -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="VECTOR &amp; ROTOR CONTROLS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <!-- Vector A X -->
                                    <Grid ColumnDefinitions="90,*,45">
                                        <TextBlock Grid.Column="0" Text="Vector a.X:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <Slider Grid.Column="1" Minimum="-2.5" Maximum="2.5" SmallChange="0.05"
                                                Value="{Binding CliffordVectorAX, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CliffordVectorAX, StringFormat='{}{0:F2}'}"
                                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>

                                    <!-- Vector A Y -->
                                    <Grid ColumnDefinitions="90,*,45">
                                        <TextBlock Grid.Column="0" Text="Vector a.Y:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <Slider Grid.Column="1" Minimum="-2.5" Maximum="2.5" SmallChange="0.05"
                                                Value="{Binding CliffordVectorAY, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CliffordVectorAY, StringFormat='{}{0:F2}'}"
                                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>

                                    <!-- Vector B X -->
                                    <Grid ColumnDefinitions="90,*,45">
                                        <TextBlock Grid.Column="0" Text="Vector b.X:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <Slider Grid.Column="1" Minimum="-2.5" Maximum="2.5" SmallChange="0.05"
                                                Value="{Binding CliffordVectorBX, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CliffordVectorBX, StringFormat='{}{0:F2}'}"
                                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>

                                    <!-- Vector B Y -->
                                    <Grid ColumnDefinitions="90,*,45">
                                        <TextBlock Grid.Column="0" Text="Vector b.Y:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <Slider Grid.Column="1" Minimum="-2.5" Maximum="2.5" SmallChange="0.05"
                                                Value="{Binding CliffordVectorBY, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CliffordVectorBY, StringFormat='{}{0:F2}'}"
                                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    </Grid>

                                    <!-- Rotor Angle θ -->
                                    <Grid ColumnDefinitions="90,*,45">
                                        <TextBlock Grid.Column="0" Text="Rotor Angle θ:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="6.283" SmallChange="0.05"
                                                Value="{Binding CliffordRotorAngle, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CliffordRotorAngle, StringFormat='{}{0:F2}'}"
                                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>

                                    <!-- Reflection Angle -->
                                    <Grid ColumnDefinitions="90,*,45">
                                        <TextBlock Grid.Column="0" Text="Mirror Angle:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <Slider Grid.Column="1" Minimum="0.05" Maximum="1.57" SmallChange="0.05"
                                                Value="{Binding CliffordReflectionAngle, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CliffordReflectionAngle, StringFormat='{}{0:F2}'}"
                                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    </Grid>

                                    <CheckBox IsChecked="{Binding CliffordShowBivectorDisk, Mode=TwoWay}" Content="Show Oriented Bivector Parallelogram (a ∧ b)" />
                                    <CheckBox IsChecked="{Binding CliffordShowDualNormal, Mode=TwoWay}" Content="Show Hodge Dual Normal Vector n = -I(a ∧ b)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding CliffordShowRotorArc, Mode=TwoWay}" Content="Show Rotor Spherical Trajectory Arc" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding CliffordShowMultivectorGrades, Mode=TwoWay}" Content="Show Blade Decomposition Inspector" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="CLIFFORD ALGEBRA AXIOMS &amp; THEOREMS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Geometric Product:&#x0a;  ab = a · b + a ∧ b&#x0a;  Symmetric inner product + antisymmetric bivector.&#x0a;&#x0a;• Imaginary Unit Emergence:&#x0a;  (e₁₂)² = e₁ e₂ e₁ e₂ = -1&#x0a;  Imaginary units are geometric planar directions!&#x0a;&#x0a;• Cartan-Dieudonné Theorem:&#x0a;  Rotation = 2 Reflections: v'' = n₂ n₁ v n₁ n₂ = R v R†&#x0a;&#x0a;• Gimbal-Lock-Free Rotor:&#x0a;  R = exp(-B̂ θ/2) = cos(θ/2) - B̂ sin(θ/2)&#x0a;  Active sandwich product v' = R v R†&#x0a;&#x0a;• Maxwell Spacetime Unification:&#x0a;  ∇F = J where F = E + I c B"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Mode 26 Controls: Differential Geometry, Geodesics & Curvature -->
                        <StackPanel Spacing="16" IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Differential Geometry'}">
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="GAUSS-RIEMANN DIFFERENTIAL GEOMETRY"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               LetterSpacing="1" />
                                    <TextBlock Text="{Binding DiffGeomFormulaTitle}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextBrush}" />
                                    <TextBlock Text="{Binding DiffGeomFormulaDetail}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Surface Preset Quick Buttons -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="CANONICAL CURVED MANIFOLDS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Classes="presetbtn" Content="Torus"
                                                Command="{Binding SetDifferentialGeometrySurfaceCommand}"
                                                CommandParameter="torus" Margin="0,0,6,6" />
                                        <Button Classes="presetbtn" Content="Sphere (S²)"
                                                Command="{Binding SetDifferentialGeometrySurfaceCommand}"
                                                CommandParameter="sphere" Margin="0,0,6,6" />
                                        <Button Classes="presetbtn" Content="Pseudosphere (K = -1)"
                                                Command="{Binding SetDifferentialGeometrySurfaceCommand}"
                                                CommandParameter="pseudosphere" Margin="0,0,6,6" />
                                        <Button Classes="presetbtn" Content="Enneper Minimal (H = 0)"
                                                Command="{Binding SetDifferentialGeometrySurfaceCommand}"
                                                CommandParameter="enneper" Margin="0,0,6,6" />
                                        <Button Classes="presetbtn" Content="Bonnet Family"
                                                Command="{Binding SetDifferentialGeometrySurfaceCommand}"
                                                CommandParameter="bonnet" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Geodesic Initial Conditions & Parameters -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="GEODESIC INITIAL CONDITIONS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <!-- Start Coordinate u0 -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Start u₀:" FontSize="12" Foreground="{DynamicResource MathTextBrush}" VerticalAlignment="Center" Width="80" />
                                        <Slider Grid.Column="1" Minimum="-3.14" Maximum="3.14"
                                                Value="{Binding DiffGeomStartU, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DiffGeomStartU, StringFormat='{}{0:F2}'}"
                                                   FontSize="12" Foreground="{DynamicResource MathTextSecondaryBrush}" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Start Coordinate v0 -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Start v₀:" FontSize="12" Foreground="{DynamicResource MathTextBrush}" VerticalAlignment="Center" Width="80" />
                                        <Slider Grid.Column="1" Minimum="-3.14" Maximum="3.14"
                                                Value="{Binding DiffGeomStartV, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DiffGeomStartV, StringFormat='{}{0:F2}'}"
                                                   FontSize="12" Foreground="{DynamicResource MathTextSecondaryBrush}" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Heading Angle alpha0 -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Heading α₀:" FontSize="12" Foreground="{DynamicResource MathTextBrush}" VerticalAlignment="Center" Width="80" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="6.28"
                                                Value="{Binding DiffGeomHeadingAngle, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DiffGeomHeadingAngle, StringFormat='{}{0:F2} rad'}"
                                                   FontSize="12" Foreground="{DynamicResource MathTextPrimaryBrush}" Width="65" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Bonnet Angle theta -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Bonnet θ:" FontSize="12" Foreground="{DynamicResource MathTextBrush}" VerticalAlignment="Center" Width="80" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1.57"
                                                Value="{Binding DiffGeomDeformationAngle, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DiffGeomDeformationAngle, StringFormat='{}{0:F2} rad'}"
                                                   FontSize="12" Foreground="{DynamicResource MathTextSecondaryBrush}" Width="65" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Toggles -->
                                    <CheckBox IsChecked="{Binding DiffGeomShowCurvatureHeatmap, Mode=TwoWay}" Content="Show Gaussian Curvature Heatmap K" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding DiffGeomShowGeodesicRay, Mode=TwoWay}" Content="Show RK4 Geodesic Trajectory" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding DiffGeomShowNormalVector, Mode=TwoWay}" Content="Show Surface Normal Vector n" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding DiffGeomShowChristoffelMatrix, Mode=TwoWay}" Content="Show Christoffel Symbols &amp; Metric Tensor" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Intrinsic Curvature & Metric Tensor Probe Card -->
                            <Border Classes="builderbox">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="CURVATURE PROBE"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource MathSurfaceBrush}"
                                                CornerRadius="{DynamicResource MathRadiusSm}"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding DiffGeomCurvatureStatus}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- K and H Metrics -->
                                    <Grid ColumnDefinitions="*,*" Margin="0,2">
                                        <Border Grid.Column="0" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="8,4" Margin="0,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="GAUSSIAN CURVATURE" FontSize="8" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding DiffGeomGaussianCurvatureK}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource MathSurfaceBrush}" CornerRadius="{DynamicResource MathRadiusSm}" Padding="8,4" Margin="4,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="MEAN CURVATURE" FontSize="8" Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="{Binding DiffGeomMeanCurvatureH}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Manifold Geometry Preset Pills -->
                                    <TextBlock Text="CANONICAL CURVATURE MANIFOLDS:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,4,0,0" />
                                    <WrapPanel>
                                        <Button Classes="quickchip" Content="Sphere (K > 0)" Command="{Binding SetDiffGeomGeometryPresetCommand}" CommandParameter="sphere" />
                                        <Button Classes="quickchip" Content="Pseudosphere (K = -1)" Command="{Binding SetDiffGeomGeometryPresetCommand}" CommandParameter="pseudosphere" />
                                        <Button Classes="quickchip" Content="Enneper (H = 0)" Command="{Binding SetDiffGeomGeometryPresetCommand}" CommandParameter="enneper" />
                                        <Button Classes="quickchip" Content="Torus Outer (K > 0)" Command="{Binding SetDiffGeomGeometryPresetCommand}" CommandParameter="torus_outer" />
                                        <Button Classes="quickchip" Content="Torus Inner (K &lt; 0)" Command="{Binding SetDiffGeomGeometryPresetCommand}" CommandParameter="torus_inner" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="DIFFERENTIAL GEOMETRY THEOREMS &amp; AXIOMS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Gauss's Theorema Egregium:&#x0a;  Gaussian curvature K = (LN - M²)/(EG - F²) is an INTRINSIC invariant of the metric g_ij. Bending a surface without stretching preserves K.&#x0a;&#x0a;• Geodesic Equation (Euler-Lagrange):&#x0a;  d²u^k/ds² + Γ^k_ij (du^i/ds)(du^j/ds) = 0&#x0a;  Describes straightest possible paths in curved space.&#x0a;&#x0a;• Christoffel Symbols of 2nd Kind:&#x0a;  Γ^k_ij = ½ g^{kl} (∂_i g_{jl} + ∂_j g_{il} - ∂_l g_{ij})&#x0a;&#x0a;• Minimal Surfaces (H = 0):&#x0a;  Enneper &amp; Catenoid have zero mean curvature H = ½(κ₁ + κ₂) = 0, minimizing surface area locally.&#x0a;&#x0a;• Gauss-Bonnet Theorem:&#x0a;  ∬_M K dA + ∮_∂M κ_g ds = 2π χ(M)&#x0a;  Total curvature equals topological Euler characteristic!"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Mode 27 Controls: Knot Theory, Braids & 3D Topological Invariants -->
                        <StackPanel Spacing="16" IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Knot Theory &amp; Invariants'}">
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="KNOT THEORY &amp; TOPOLOGICAL INVARIANTS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               LetterSpacing="1" />
                                    <TextBlock Text="{Binding KnotFormulaTitle}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextBrush}" />
                                    <TextBlock Text="{Binding KnotFormulaDetail}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Canonical Knots & Links Quick Buttons -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="CANONICAL KNOTS &amp; LINKS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Classes="presetbtn" Content="Trefoil 3₁"
                                                Command="{Binding SetKnotTypeCommand}"
                                                CommandParameter="trefoil" Margin="0,0,6,6" />
                                        <Button Classes="presetbtn" Content="Figure-Eight 4₁"
                                                Command="{Binding SetKnotTypeCommand}"
                                                CommandParameter="figure8" Margin="0,0,6,6" />
                                        <Button Classes="presetbtn" Content="Cinquefoil 5₁"
                                                Command="{Binding SetKnotTypeCommand}"
                                                CommandParameter="cinquefoil" Margin="0,0,6,6" />
                                        <Button Classes="presetbtn" Content="Borromean Rings"
                                                Command="{Binding SetKnotTypeCommand}"
                                                CommandParameter="borromean" Margin="0,0,6,6" />
                                        <Button Classes="presetbtn" Content="Whitehead Link"
                                                Command="{Binding SetKnotTypeCommand}"
                                                CommandParameter="whitehead" Margin="0,0,6,6" />
                                        <Button Classes="presetbtn" Content="Hopf Link"
                                                Command="{Binding SetKnotTypeCommand}"
                                                CommandParameter="hopf" Margin="0,0,6,6" />
                                        <Button Classes="presetbtn" Content="Torus Knot"
                                                Command="{Binding SetKnotTypeCommand}"
                                                CommandParameter="torus" Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Geometry & Braid Controls -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="GEOMETRY &amp; BRAID GENERATOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <!-- Tube Radius -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Tube Radius:" FontSize="12" Foreground="{DynamicResource MathTextBrush}" VerticalAlignment="Center" Width="90" />
                                        <Slider Grid.Column="1" Minimum="0.05" Maximum="0.45"
                                                Value="{Binding KnotTubeRadius, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding KnotTubeRadius, StringFormat='{}{0:F2}'}"
                                                   FontSize="12" Foreground="{DynamicResource MathTextSecondaryBrush}" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Torus Knot P -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Torus P (Winding):" FontSize="12" Foreground="{DynamicResource MathTextBrush}" VerticalAlignment="Center" Width="90" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="9"
                                                Value="{Binding KnotTorusP, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding KnotTorusP}"
                                                   FontSize="12" Foreground="{DynamicResource MathTextPrimaryBrush}" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Torus Knot Q -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Torus Q (Meridian):" FontSize="12" Foreground="{DynamicResource MathTextBrush}" VerticalAlignment="Center" Width="90" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="7"
                                                Value="{Binding KnotTorusQ, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding KnotTorusQ}"
                                                   FontSize="12" Foreground="{DynamicResource MathTextSecondaryBrush}" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Braid Word Input -->
                                    <TextBlock Text="Artin Braid Word (e.g. s1 s2^-1 s1 s2^-1):" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <TextBox Text="{Binding KnotBraidWord, Mode=TwoWay}"
                                             FontFamily="Consolas, Menlo, monospace"
                                             FontSize="12"
                                             Foreground="{DynamicResource MathTextPrimaryBrush}"
                                             Background="{DynamicResource MathSurfaceBrush}"
                                             BorderBrush="{DynamicResource MathBorderBrush}"
                                             CornerRadius="4" Padding="8,5" />

                                    <!-- Quick Artin Generator Buttons -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,2,0,4">
                                        <Button Classes="quickchip" Command="{Binding AppendBraidGeneratorCommand}" CommandParameter="s1" Content="σ₁" ToolTip.Tip="Strand 1 over 2" />
                                        <Button Classes="quickchip" Command="{Binding AppendBraidGeneratorCommand}" CommandParameter="s2" Content="σ₂" ToolTip.Tip="Strand 2 over 3" />
                                        <Button Classes="quickchip" Command="{Binding AppendBraidGeneratorCommand}" CommandParameter="s1^-1" Content="σ₁⁻¹" ToolTip.Tip="Strand 1 under 2" />
                                        <Button Classes="quickchip" Command="{Binding AppendBraidGeneratorCommand}" CommandParameter="s2^-1" Content="σ₂⁻¹" ToolTip.Tip="Strand 2 under 3" />
                                        <Button Classes="actionpill" Command="{Binding ClearBraidWordCommand}" Content="Clear Word" Margin="4,0,0,0" />
                                    </WrapPanel>

                                    <!-- Torus Knot Coprime Presets -->
                                    <TextBlock Text="TORUS KNOT (p, q) COPRIME WINDINGS:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,4,0,2" />
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Classes="actionpill" Command="{Binding SetTorusKnotParamsCommand}" CommandParameter="2,3" Content="Trefoil (2,3)" Margin="0,0,4,4" />
                                        <Button Classes="actionpill" Command="{Binding SetTorusKnotParamsCommand}" CommandParameter="5,2" Content="Solomon (5,2)" Margin="0,0,4,4" />
                                        <Button Classes="actionpill" Command="{Binding SetTorusKnotParamsCommand}" CommandParameter="7,2" Content="Septafoil (7,2)" Margin="0,0,4,4" />
                                        <Button Classes="actionpill" Command="{Binding SetTorusKnotParamsCommand}" CommandParameter="4,3" Content="Torus (4,3)" Margin="0,0,4,4" />
                                    </WrapPanel>

                                    <!-- Toggles -->
                                    <CheckBox IsChecked="{Binding KnotShow3DTube, Mode=TwoWay}" Content="Render 3D Shaded Tube Geometry" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding KnotShowPolynomialCard, Mode=TwoWay}" Content="Show Jones &amp; Alexander Polynomials" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding KnotShowBraidDiagram, Mode=TwoWay}" Content="Show Artin Braid B₃ Inspector" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding KnotShowPlanarProjection, Mode=TwoWay}" Content="Show 2D Regular Planar Projection" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="KNOT THEORY THEOREMS &amp; AXIOMS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Vaughan Jones Skein Relation (1984):&#x0a;  t⁻¹ V(L₊) - t V(L₋) = (t^(1/2) - t^(-1/2)) V(L₀)&#x0a;  Distinguishes chiral knots from their mirror images!&#x0a;&#x0a;• Reidemeister Theorem (1927):&#x0a;  Two link diagrams represent equivalent knots iff related by a finite sequence of moves:&#x0a;  - Type I: Twist / untwist curl&#x0a;  - Type II: Poke / pull strands apart&#x0a;  - Type III: Slide strand over crossing&#x0a;&#x0a;• Artin Braid Group Bₙ (1925):&#x0a;  σᵢ σⱼ = σⱼ σᵢ  (|i - j| ≥ 2)&#x0a;  σᵢ σᵢ₊₁ σᵢ = σᵢ₊₁ σᵢ σᵢ₊₁  (Yang-Baxter)&#x0a;&#x0a;• Gauss Linking Number Formula:&#x0a;  Lk(K₁, K₂) = (1 / 4π) ∮∮ (r₁ - r₂) · (dr₁ × dr₂) / |r₁ - r₂|³&#x0a;&#x0a;• Alexander-Conway Polynomial:&#x0a;  Δ(t) = Δ(t⁻¹),  Δ(1) = 1"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Mode 28 Controls: Symplectic Geometry & Hamiltonian Mechanics -->
                        <StackPanel Spacing="16" IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Symplectic &amp; Hamiltonian'}">
                            <!-- Hero Title Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="LABORATORY 28"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding HamiltonFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding HamiltonFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Canonical Systems Quick Buttons -->
                            <TextBlock Text="CANONICAL HAMILTONIAN SYSTEMS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MathTextMutedBrush}" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,4">
                                <Button Grid.Row="0" Grid.Column="0" Classes="presetbtn" Content="Hénon-Heiles"
                                        Margin="0,0,3,4"
                                        Command="{Binding SetHamiltonianPresetCommand}"
                                        CommandParameter="henonheiles" />
                                <Button Grid.Row="0" Grid.Column="1" Classes="presetbtn" Content="Duffing Well"
                                        Margin="3,0,0,4"
                                        Command="{Binding SetHamiltonianPresetCommand}"
                                        CommandParameter="duffing" />
                                <Button Grid.Row="1" Grid.Column="0" Classes="presetbtn" Content="Nonlinear Pendulum"
                                        Margin="0,0,3,4"
                                        Command="{Binding SetHamiltonianPresetCommand}"
                                        CommandParameter="pendulum" />
                                <Button Grid.Row="1" Grid.Column="1" Classes="presetbtn" Content="Liouville Volume"
                                        Margin="3,0,0,4"
                                        Command="{Binding SetHamiltonianPresetCommand}"
                                        CommandParameter="liouville" />
                                <Button Grid.Row="2" Grid.ColumnSpan="2" Classes="presetbtn" Content="Yoshida Symplectic vs RK4"
                                        Command="{Binding SetHamiltonianPresetCommand}"
                                        CommandParameter="yoshida" />
                            </Grid>

                            <!-- Parameter Controls -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="HAMILTONIAN PARAMETERS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <!-- Integrator Mode -->
                                    <TextBlock Text="Symplectic Integrator:" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" />
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,4">
                                        <Button Grid.Column="0" Classes="presetbtn" Content="Yoshida 4th" Margin="0,0,2,0"
                                                Command="{Binding SetHamiltonianIntegratorCommand}"
                                                CommandParameter="yoshida" />
                                        <Button Grid.Column="1" Classes="presetbtn" Content="Verlet 2nd" Margin="2,0,2,0"
                                                Command="{Binding SetHamiltonianIntegratorCommand}"
                                                CommandParameter="verlet" />
                                        <Button Grid.Column="2" Classes="presetbtn" Content="Standard RK4" Margin="2,0,0,0"
                                                Command="{Binding SetHamiltonianIntegratorCommand}"
                                                CommandParameter="rk4" />
                                    </Grid>

                                    <!-- Energy Level Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Energy E:" FontSize="11" Width="80" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.01" Maximum="0.166"
                                                Value="{Binding HamiltonEnergyLevel, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding HamiltonEnergyLevel, StringFormat='{}{0:F3}'}"
                                                   FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Quick Energy Level Buttons -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,2,0,4">
                                        <Button Classes="quickchip" Command="{Binding SetHamiltonianEnergyLevelCommand}" CommandParameter="0.04" Content="E=0.04 (KAM Tori)" />
                                        <Button Classes="quickchip" Command="{Binding SetHamiltonianEnergyLevelCommand}" CommandParameter="0.08" Content="E=0.08 (Resonance)" />
                                        <Button Classes="quickchip" Command="{Binding SetHamiltonianEnergyLevelCommand}" CommandParameter="0.12" Content="E=0.12 (Mixed Chaos)" />
                                        <Button Classes="quickchip" Command="{Binding SetHamiltonianEnergyLevelCommand}" CommandParameter="0.16" Content="E=0.16 (Critical Escape)" />
                                    </WrapPanel>

                                    <!-- Duffing Double-Well Parameters -->
                                    <TextBlock Text="Duffing Potential V(x) = ½αx² + ¼βx⁴:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,4,0,0" />
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Linear α:" FontSize="11" Width="80" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="-2.0" Maximum="2.0"
                                                Value="{Binding HamiltonDuffingAlpha, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding HamiltonDuffingAlpha, StringFormat='{}{0:F2}'}"
                                                   FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Nonlinear β:" FontSize="11" Width="80" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.05" Maximum="2.0"
                                                Value="{Binding HamiltonDuffingBeta, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding HamiltonDuffingBeta, StringFormat='{}{0:F2}'}"
                                                   FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Time Step Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Time Step dt:" FontSize="11" Width="80" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.005" Maximum="0.1"
                                                Value="{Binding HamiltonTimeStep, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding HamiltonTimeStep, StringFormat='{}{0:F3}'}"
                                                   FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Toggles -->
                                    <CheckBox IsChecked="{Binding HamiltonShowPoincareSection, Mode=TwoWay}" Content="Show Poincaré Surface of Section" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding HamiltonShowPotentialContours, Mode=TwoWay}" Content="Show Configuration Space &amp; Contours" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding HamiltonShowEnergyErrorGraph, Mode=TwoWay}" Content="Show Symplectic Energy Error Graph" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding HamiltonShowLiouvilleDroplet, Mode=TwoWay}" Content="Show Liouville Phase Volume Droplet" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="HAMILTONIAN &amp; SYMPLECTIC RIGOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Hamilton's Canonical Equations (1834):&#x0a;  dq/dt = ∂H/∂p,   dp/dt = -∂H/∂q&#x0a;  Phase space coordinates z = (q, p)ᵀ evolve via J ∇H.&#x0a;&#x0a;• Symplectic Form &amp; Phase Volume:&#x0a;  ω = dq ∧ dp  (Canonical 2-form)&#x0a;  Mᵀ J M = J  (Symplectic Jacobian condition)&#x0a;&#x0a;• Liouville's Theorem (1838):&#x0a;  div(X_H) = ∂²H/∂q∂p - ∂²H/∂p∂q = 0&#x0a;  The phase space flow is incompressible!&#x0a;&#x0a;• Yoshida 4th-Order Symplectic Composition:&#x0a;  S₄(dt) = S₂(w₁dt) S₂(w₀dt) S₂(w₁dt)&#x0a;  w₁ = 1/(2 - 2^(1/3)),  w₀ = -2^(1/3)/(2 - 2^(1/3))&#x0a;  Preserves shadow Hamiltonian H̃ = H + O(dt⁴) exactly!&#x0a;&#x0a;• Poisson Bracket Invariant:&#x0a;  {f, g} = (∂f/∂q)(∂g/∂p) - (∂f/∂p)(∂g/∂q)&#x0a;  df/dt = {f, H} + ∂f/∂t"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Mode 29 Controls: Algebraic Topology & Simplicial Homology -->
                        <StackPanel Spacing="16" IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Algebraic Topology &amp; Homology'}">
                            <!-- Hero Title Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="LABORATORY 29"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding HomologyFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding HomologyFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Canonical Complexes Quick Buttons -->
                            <TextBlock Text="CANONICAL TOPOLOGICAL MANIFOLDS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MathTextMutedBrush}" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,4">
                                <Button Grid.Row="0" Grid.Column="0" Classes="presetbtn" Content="2-Torus T²"
                                        Margin="0,0,3,4"
                                        Command="{Binding SetHomologyPresetCommand}"
                                        CommandParameter="torus" />
                                <Button Grid.Row="0" Grid.Column="1" Classes="presetbtn" Content="2-Sphere S²"
                                        Margin="3,0,0,4"
                                        Command="{Binding SetHomologyPresetCommand}"
                                        CommandParameter="sphere" />
                                <Button Grid.Row="1" Grid.Column="0" Classes="presetbtn" Content="Klein Bottle K²"
                                        Margin="0,0,3,4"
                                        Command="{Binding SetHomologyPresetCommand}"
                                        CommandParameter="klein" />
                                <Button Grid.Row="1" Grid.Column="1" Classes="presetbtn" Content="Projective ℝP²"
                                        Margin="3,0,0,4"
                                        Command="{Binding SetHomologyPresetCommand}"
                                        CommandParameter="projective" />
                                <Button Grid.Row="2" Grid.Column="0" Classes="presetbtn" Content="Möbius Strip"
                                        Margin="0,0,3,0"
                                        Command="{Binding SetHomologyPresetCommand}"
                                        CommandParameter="mobius" />
                                <Button Grid.Row="2" Grid.Column="1" Classes="presetbtn" Content="TDA Filtration"
                                        Margin="3,0,0,0"
                                        Command="{Binding SetHomologyPresetCommand}"
                                        CommandParameter="persistence" />
                            </Grid>

                            <!-- Parameter Controls -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="HOMOLOGY PARAMETERS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <!-- Filtration Scale Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Filtration ε:" FontSize="11" Width="80" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.1" Maximum="2.0"
                                                Value="{Binding HomologyFiltrationRadius, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding HomologyFiltrationRadius, StringFormat='{}{0:F2}'}"
                                                   FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Quick Filtration Presets -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,2,0,4">
                                        <Button Classes="quickchip" Command="{Binding SetHomologyFiltrationCommand}" CommandParameter="0.25" Content="ε=0.25 (Birth)" />
                                        <Button Classes="quickchip" Command="{Binding SetHomologyFiltrationCommand}" CommandParameter="0.50" Content="ε=0.50" />
                                        <Button Classes="quickchip" Command="{Binding SetHomologyFiltrationCommand}" CommandParameter="0.80" Content="ε=0.80 (Annulus H₁)" />
                                        <Button Classes="quickchip" Command="{Binding SetHomologyFiltrationCommand}" CommandParameter="1.20" Content="ε=1.20" />
                                        <Button Classes="quickchip" Command="{Binding SetHomologyFiltrationCommand}" CommandParameter="1.50" Content="ε=1.50 (Death)" />
                                    </WrapPanel>

                                    <!-- Toggles -->
                                    <CheckBox IsChecked="{Binding HomologyShowGeneratorCycles, Mode=TwoWay}" Content="Highlight Independent 1-Cycles (H₁ Loops)" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding HomologyShowBoundaryMatrix, Mode=TwoWay}" Content="Show Boundary Matrix ∂₁ &amp; ∂₂ Inspector" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding HomologyShowPersistenceBarcodes, Mode=TwoWay}" Content="Show Persistence Barcode Diagram" Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding HomologyShowVertexLabels, Mode=TwoWay}" Content="Show Vertex Indices (v₀, v₁...)" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ALGEBRAIC TOPOLOGY THEOREMS &amp; AXIOMS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Fundamental Boundary Axiom (Poincaré):&#x0a;  ∂_{k-1} ∘ ∂_k ≡ 0&#x0a;  The boundary of a boundary is always zero!&#x0a;  Hence: im(∂_{k+1}) ⊆ ker(∂_k) => B_k ⊆ Z_k&#x0a;&#x0a;• Homology Groups (Noether 1926):&#x0a;  H_k = Z_k / B_k = ker(∂_k) / im(∂_{k+1})&#x0a;  Betti number β_k = dim(H_k) = rank(Z_k) - rank(B_k)&#x0a;&#x0a;• Euler-Poincaré Formula:&#x0a;  χ = V - E + F = β₀ - β₁ + β₂&#x0a;  Invariant under any homeomorphic subdivision!&#x0a;&#x0a;• Vietoris-Rips Filtration Complex K(ε):&#x0a;  [v₀, ..., v_k] ∈ K(ε)  iff  dist(v_i, v_j) ≤ ε  (∀ i, j)&#x0a;  Persistent Barcodes: [ε_birth, ε_death]&#x0a;  Topological signals have long bars; noise has short bars."
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Mode 30 Controls: Lie Algebras, Root Systems & Dynkin Diagrams -->
                        <StackPanel Spacing="16" IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Lie Algebras &amp; Dynkin'}">
                            <!-- Hero Title Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="LABORATORY 30"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding LieFormulaTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding LieFormulaDetail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Lie Algebra & Root Lattice Selector Buttons -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="SIMPLE LIE ALGEBRAS &amp; ROOT SYSTEMS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="A₂ ≅ su(3) [Hexagon]"
                                                Classes="preset-chip"
                                                Command="{Binding SetLieTypeCommand}"
                                                CommandParameter="a2"
                                                Margin="0,0,6,6" />
                                        <Button Content="B₂ ≅ so(5) [Octagon]"
                                                Classes="preset-chip"
                                                Command="{Binding SetLieTypeCommand}"
                                                CommandParameter="b2"
                                                Margin="0,0,6,6" />
                                        <Button Content="G₂ Exceptional [12-Star]"
                                                Classes="preset-chip"
                                                Command="{Binding SetLieTypeCommand}"
                                                CommandParameter="g2"
                                                Margin="0,0,6,6" />
                                        <Button Content="A₃ ≅ su(4) [Cuboctahedron]"
                                                Classes="preset-chip"
                                                Command="{Binding SetLieTypeCommand}"
                                                CommandParameter="a3"
                                                Margin="0,0,6,6" />
                                        <Button Content="B₃ ≅ so(7) [Rhombic Dodec]"
                                                Classes="preset-chip"
                                                Command="{Binding SetLieTypeCommand}"
                                                CommandParameter="b3"
                                                Margin="0,0,6,6" />
                                        <Button Content="E₈ Heterotic [240 Roots]"
                                                Classes="preset-chip"
                                                Command="{Binding SetLieTypeCommand}"
                                                CommandParameter="e8"
                                                Margin="0,0,6,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Display Overlays & HUD Toggles -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="VISUALIZATION OVERLAYS &amp; HUD"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <CheckBox IsChecked="{Binding LieShowDynkinDiagram, Mode=TwoWay}"
                                              Content="Show Dynkin Diagram Card (Top-Right)" />
                                    <CheckBox IsChecked="{Binding LieShowCartanMatrix, Mode=TwoWay}"
                                              Content="Show Cartan Matrix Aᵢⱼ HUD (Bottom-Left)"
                                              Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding LieShowCoxeterCircles, Mode=TwoWay}"
                                              Content="Show Concentric Coxeter Circles"
                                              Margin="0,4,0,0" />
                                    <CheckBox IsChecked="{Binding LieShowRootLabels, Mode=TwoWay}"
                                              Content="Show Root Coordinates &amp; Simple Highlights"
                                              Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 3D Orbit Camera Controls (for A3/B3) -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="3D ROOT LATTICE CAMERA ORBIT"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <!-- Camera Yaw Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Yaw Orbit:" FontSize="11" Width="80" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="-3.14" Maximum="3.14"
                                                Value="{Binding LieCameraYaw, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding LieCameraYaw, StringFormat='{}{0:F2}'}"
                                                   FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Camera Pitch Slider -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Pitch Orbit:" FontSize="11" Width="80" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="-1.5" Maximum="1.5"
                                                Value="{Binding LieCameraPitch, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding LieCameraPitch, StringFormat='{}{0:F2}'}"
                                                   FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Rigor Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="LIE ALGEBRAS &amp; ROOT SYSTEMS RIGOR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="• Lie Bracket Axioms:&#x0a;  [X, Y] = -[Y, X]  (Antisymmetry)&#x0a;  [X, [Y, Z]] + [Y, [Z, X]] + [Z, [X, Y]] = 0  (Jacobi Identity)&#x0a;&#x0a;• Cartan Subalgebra 𝔥 &amp; Root Decomposition:&#x0a;  𝔤 = 𝔥 ⊕ ⨁_{α ∈ Φ} 𝔤_α&#x0a;  [H, X_α] = α(H) X_α  (∀ H ∈ 𝔥, X_α ∈ 𝔤_α)&#x0a;&#x0a;• Cartan Matrix &amp; Simple Roots Δ:&#x0a;  A_{ij} = 2 ⟨α_i, α_j⟩ / ⟨α_j, α_j⟩ ∈ {0, -1, -2, -3}&#x0a;  Angle: cos(θ_{ij}) = -√(A_{ij} A_{ji}) / 2&#x0a;&#x0a;• Weyl Group Reflections:&#x0a;  s_α(v) = v - 2 ⟨v, α⟩ / ⟨α, α⟩ α&#x0a;  Generated by simple reflections s_i; preserves root system Φ!&#x0a;&#x0a;• Exceptional E₈ Geometry:&#x0a;  Rank 8, Dim 248, 240 roots in 8D with length √2.&#x0a;  Coxeter number h = 30; projects onto 8 concentric 30-gons&#x0a;  Fundamental to 10D Heterotic Superstring Theory E₈ × E₈."
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ======================================================== -->
                        <!-- DRAWER 31: CLAY MILLENNIUM PRIZE PROBLEMS & SOLUTIONS    -->
                        <!-- ======================================================== -->
                        <StackPanel IsVisible="{Binding ActiveLaboratory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Millennium Problems'}" Spacing="14">
                            <!-- 1. Header Banner & Clay Bounty Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="CLAY MILLENNIUM PRIZE PROBLEMS"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                        <WrapPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                                    CornerRadius="4"
                                                    Margin="0,0,6,0"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding ActiveMillenniumProblemInfo.Status}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="$7M Clay Foundation"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource MathTextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Millennium Problem Selector Tabs -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,4"
                                                Command="{Binding SelectMillenniumProblemCommand}" CommandParameter="poincare"
                                                ToolTip.Tip="Poincaré Conjecture (Solved by G. Perelman)">
                                            <TextBlock Text="1. Poincaré ✓" FontSize="10" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,4"
                                                Command="{Binding SelectMillenniumProblemCommand}" CommandParameter="riemann"
                                                ToolTip.Tip="Riemann Hypothesis (Non-trivial zeros Re(s)=1/2)">
                                            <TextBlock Text="2. Riemann $1M" FontSize="10" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,4"
                                                Command="{Binding SelectMillenniumProblemCommand}" CommandParameter="bsd"
                                                ToolTip.Tip="Birch &amp; Swinnerton-Dyer Conjecture (Elliptic Curves)">
                                            <TextBlock Text="3. BSD $1M" FontSize="10" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,4"
                                                Command="{Binding SelectMillenniumProblemCommand}" CommandParameter="navierstokes"
                                                ToolTip.Tip="Navier-Stokes Singularity &amp; Blow-Up (Solved by OpenAI / Lean 4)">
                                            <TextBlock Text="4. Navier-Stokes ✓" FontSize="10" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,4"
                                                Command="{Binding SelectMillenniumProblemCommand}" CommandParameter="yangmills"
                                                ToolTip.Tip="Yang-Mills Existence &amp; Mass Gap (Glueballs &amp; Wilson Loops)">
                                            <TextBlock Text="5. Yang-Mills $1M" FontSize="10" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,4"
                                                Command="{Binding SelectMillenniumProblemCommand}" CommandParameter="pvsnp"
                                                ToolTip.Tip="P versus NP (Cook-Levin 3-SAT Phase Transition)">
                                            <TextBlock Text="6. P vs NP $1M" FontSize="10" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,4"
                                                Command="{Binding SelectMillenniumProblemCommand}" CommandParameter="hodge"
                                                ToolTip.Tip="Hodge Conjecture (Algebraic Cycles &amp; Hodge Diamond)">
                                            <TextBlock Text="7. Hodge $1M" FontSize="10" FontWeight="SemiBold" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 2. Clay Statement & Core Formula Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="OFFICIAL CLAY STATEMENT &amp; CONJECTURE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="{Binding ActiveMillenniumProblemInfo.Title}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding ActiveMillenniumProblemInfo.ProposerOrSolver}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="{Binding ActiveMillenniumProblemInfo.ClayDescription}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="0,4,0,0">
                                        <TextBlock Text="{Binding ActiveMillenniumProblemInfo.CoreFormula}"
                                                   FontSize="11"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   Foreground="{DynamicResource MathTextPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 3. Interactive Parameter Builder & Laboratory Controls -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="INTERACTIVE SIMULATION PARAMETERS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <!-- Poincaré Controls -->
                                    <StackPanel IsVisible="{Binding SelectedMillenniumProblem, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static millennium:MillenniumProblemType.PoincareConjecture}}" Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="Ricci Time t:" FontSize="11" Width="85" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0.0" Maximum="5.2"
                                                    Value="{Binding MillenniumRicciTime, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding MillenniumRicciTime, StringFormat='{}{0:F2}'}"
                                                       FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="mathaction" Margin="0,0,6,4" Padding="8,4"
                                                    Command="{Binding ToggleRicciFlowAnimationCommand}"
                                                    ToolTip.Tip="Continuously scrub Ricci time t to watch neck pinch singularization and spherical uniformization">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="▶ Auto-Animate Flow" IsVisible="{Binding !IsRicciFlowAnimating}" FontSize="10" />
                                                    <TextBlock Text="⏸ Pause Flow" IsVisible="{Binding IsRicciFlowAnimating}" FontSize="10" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,6,4" Padding="8,4"
                                                    Command="{Binding StepRicciFlowCommand}" CommandParameter="0.5">
                                                <TextBlock Text="Step Flow (+0.5s)" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,0,4" Padding="8,4"
                                                    Command="{Binding TriggerRicciSurgeryCommand}">
                                                <TextBlock Text="Trigger Surgery (Cap D³)" FontSize="10" />
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Riemann Controls -->
                                    <StackPanel IsVisible="{Binding SelectedMillenniumProblem, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static millennium:MillenniumProblemType.RiemannHypothesis}}" Spacing="8">
                                        <!-- Attack Framework Selector -->
                                        <TextBlock Text="Solution Attack Frameworks &amp; Verification:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" FontWeight="SemiBold" />
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetRiemannAttackCommand}" CommandParameter="hilbert"
                                                    ToolTip.Tip="Hilbert-Pólya Connes-Berry-Keating quantum Hamiltonian H ψ = E ψ">
                                                <TextBlock Text="1. Hilbert-Pólya" FontSize="10" FontWeight="SemiBold" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetRiemannAttackCommand}" CommandParameter="debruijn"
                                                    ToolTip.Tip="de Bruijn-Newman heat evolution and Tao-Rodgers bound (Λ = 0)">
                                                <TextBlock Text="2. de Bruijn-Newman (Λ=0)" FontSize="10" FontWeight="SemiBold" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetRiemannAttackCommand}" CommandParameter="li"
                                                    ToolTip.Tip="Xian-Jin Li strictly positive coefficients λ_n > 0">
                                                <TextBlock Text="3. Li Positivity" FontSize="10" FontWeight="SemiBold" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetRiemannAttackCommand}" CommandParameter="hunter"
                                                    ToolTip.Tip="Automated Brent-Dekker zero hunter &amp; Turing verification count">
                                                <TextBlock Text="4. Zero Hunter &amp; Gram" FontSize="10" FontWeight="SemiBold" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetRiemannAttackCommand}" CommandParameter="gue"
                                                    ToolTip.Tip="Montgomery-Odlyzko GUE quantum chaos &amp; Wigner level repulsion">
                                                <TextBlock Text="5. GUE Chaos" FontSize="10" FontWeight="SemiBold" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetRiemannAttackCommand}" CommandParameter="music"
                                                    ToolTip.Tip="Music of the Primes zero harmonic reconstruction &amp; acoustic synthesizer">
                                                <TextBlock Text="6. Prime Harmonics" FontSize="10" FontWeight="SemiBold" />
                                            </Button>
                                        </WrapPanel>

                                        <!-- de Bruijn-Newman Slider (When in DeBruijnNewman) -->
                                        <StackPanel IsVisible="{Binding SelectedRiemannAttack, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static millennium:RiemannAttackFramework.DeBruijnNewman}}" Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="Newman t:" FontSize="11" Width="75" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" Minimum="-0.2" Maximum="0.2"
                                                        Value="{Binding RiemannDeBruijnT, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="2" Text="{Binding RiemannDeBruijnT, StringFormat='{}{0:F3}'}"
                                                           FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,2"
                                                        Command="{Binding SetDeBruijnTCommand}" CommandParameter="-0.1">
                                                    <TextBlock Text="t = -0.10 (Off-Axis Pairs)" FontSize="9" />
                                                </Button>
                                                <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,2"
                                                        Command="{Binding SetDeBruijnTCommand}" CommandParameter="0.0">
                                                    <TextBlock Text="t = 0.00 (Critical Ground State Λ=0)" FontSize="9" Foreground="{DynamicResource MathAccentCyanBrush}" FontWeight="SemiBold" />
                                                </Button>
                                                <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,2"
                                                        Command="{Binding SetDeBruijnTCommand}" CommandParameter="0.1">
                                                    <TextBlock Text="t = +0.10 (Hyperbolic Real)" FontSize="9" />
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Li Criterion Controls (When in LiCriterion) -->
                                        <StackPanel IsVisible="{Binding SelectedRiemannAttack, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static millennium:RiemannAttackFramework.LiCriterion}}" Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="Max Order N:" FontSize="11" Width="75" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" Minimum="4" Maximum="30"
                                                        Value="{Binding RiemannLiMaxN, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="2" Text="{Binding RiemannLiMaxN}"
                                                           FontSize="11" Width="30" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Zero Hunter Controls (When in ZeroHunter) -->
                                        <StackPanel IsVisible="{Binding SelectedRiemannAttack, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static millennium:RiemannAttackFramework.ZeroHunter}}" Spacing="6">
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="mathaction" Margin="0,0,4,4" Padding="8,4"
                                                        Command="{Binding HuntRiemannZerosCommand}">
                                                    <TextBlock Text="🎯 Scan Zeros in Range (Brent-Dekker)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MathAccentCyanBrush}" />
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Zero Teleport & Audio Controls -->
                                        <TextBlock Text="Zero Navigation &amp; Acoustic Sonification:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" Margin="0,4,0,0" />
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetZetaZeroTeleportCommand}" CommandParameter="1">
                                                <TextBlock Text="γ₁ = 14.13" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetZetaZeroTeleportCommand}" CommandParameter="2">
                                                <TextBlock Text="γ₂ = 21.02" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetZetaZeroTeleportCommand}" CommandParameter="5">
                                                <TextBlock Text="γ₅ = 32.93" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding PlayRiemannZeroCommand}" CommandParameter="1"
                                                    ToolTip.Tip="Sonify Montgomery-Odlyzko quantum GUE zero frequency (A3 = 220Hz @ γ₁)">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="🔊" FontSize="10" />
                                                    <TextBlock Text="Sonify γ₁" FontSize="10" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding PlayRiemannChordCommand}"
                                                    ToolTip.Tip="Synthesize simultaneous 4-zero harmonic chord (Music of the Primes)">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="🎵" FontSize="10" />
                                                    <TextBlock Text="Zero Chord" FontSize="10" Foreground="{DynamicResource MathAccentCyanBrush}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- BSD Controls -->
                                    <StackPanel IsVisible="{Binding SelectedMillenniumProblem, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static millennium:MillenniumProblemType.BirchSwinnertonDyer}}" Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="Param a:" FontSize="11" Width="85" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="-5.0" Maximum="5.0"
                                                    Value="{Binding MillenniumBsdParamA, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding MillenniumBsdParamA, StringFormat='{}{0:F1}'}"
                                                       FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="Param b:" FontSize="11" Width="85" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="-5.0" Maximum="5.0"
                                                    Value="{Binding MillenniumBsdParamB, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding MillenniumBsdParamB, StringFormat='{}{0:F1}'}"
                                                       FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetBsdCurvePresetCommand}" CommandParameter="rank0">
                                                <TextBlock Text="Rank 0 (Torsion)" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetBsdCurvePresetCommand}" CommandParameter="rank1">
                                                <TextBlock Text="Rank 1 (Heegner)" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetBsdCurvePresetCommand}" CommandParameter="rank2">
                                                <TextBlock Text="Rank 2 (Dual Gen)" FontSize="10" />
                                            </Button>
                                        </WrapPanel>

                                        <!-- Mordell-Weil Generator Point Stepper -->
                                        <Border Background="{DynamicResource MathSurfaceBrush}"
                                                BorderBrush="{DynamicResource MathBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8"
                                                Margin="0,4,0,0">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="MORDELL-WEIL GROUP LAW (CHORD &amp; TANGENT)"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource MathTextMutedBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ActiveBsdEllipticPoint}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                                </Grid>
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                            Command="{Binding StepBsdPointAdditionCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="➕" FontSize="9" />
                                                            <TextBlock Text="Step Multiplier (k·P₀)" FontSize="10" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                            Command="{Binding ResetBsdPointAdditionCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="↺" FontSize="9" />
                                                            <TextBlock Text="Reset P₀" FontSize="10" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                                <TextBlock Text="Doubling: m=(3x₁²+a)/(2y₁), x₂=m²-2x₁, y₂=m(x₁-x₂)-y₁. Chord: m=(y₂-y₁)/(x₂-x₁)."
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource MathTextMutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Navier-Stokes Controls -->
                                    <StackPanel IsVisible="{Binding SelectedMillenniumProblem, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static millennium:MillenniumProblemType.NavierStokesSmoothness}}" Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="Viscosity ν:" FontSize="11" Width="85" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0.00005" Maximum="0.005"
                                                    Value="{Binding MillenniumNavierViscosity, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding MillenniumNavierViscosity, StringFormat='{}{0:F5}'}"
                                                       FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="Time t:" FontSize="11" Width="85" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0.0" Maximum="3.0"
                                                    Value="{Binding MillenniumNavierTime, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding MillenniumNavierTime, StringFormat='{}{0:F2}'}"
                                                       FontSize="11" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetNavierRegimeCommand}" CommandParameter="openai"
                                                    ToolTip.Tip="OpenAI Verified Finite-Time Singularity Blow-up Profile (Lean 4 Formalization, 2026)">
                                                <TextBlock Text="⚡ OpenAI Lean Solution" FontSize="10" Foreground="{DynamicResource MathAccentCyanBrush}" FontWeight="SemiBold" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding ToggleNavierAnimationCommand}"
                                                    ToolTip.Tip="Continuously advance time to simulate vortex tube stretching and vorticity growth">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="▶ Animate Swirl" IsVisible="{Binding !IsNavierAnimating}" FontSize="10" />
                                                    <TextBlock Text="⏸ Pause Swirl" IsVisible="{Binding IsNavierAnimating}" FontSize="10" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetNavierRegimeCommand}" CommandParameter="viscous">
                                                <TextBlock Text="Viscous Smooth" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetNavierRegimeCommand}" CommandParameter="critical">
                                                <TextBlock Text="Critical Stretch" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetNavierRegimeCommand}" CommandParameter="turbulent_blowup">
                                                <TextBlock Text="Blow-Up Regime" FontSize="10" Foreground="{DynamicResource MathTextSecondaryBrush}" />
                                            </Button>
                                        </WrapPanel>

                                        <!-- OpenAI Lean 4 Verification Card -->
                                        <Border Background="{DynamicResource MathSurfaceHighBrush}"
                                                CornerRadius="4"
                                                Padding="8,6"
                                                Margin="0,4,0,0">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="⚡ OPENAI LEAN 4 PROOF FORMALIZATION (2026)"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource MathAccentCyanBrush}" />
                                                <TextBlock Text="• Status: Finite-time singularity (blow-up) proved with smooth force"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource MathTextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="• Self-Similar Profile: u(x,t) ~ (T* - t)^{-1/2} U((x - x₀)/√(T* - t))"
                                                           FontSize="8.5"
                                                           FontFamily="Consolas, Menlo, monospace"
                                                           Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                                <TextBlock Text="• Lean 4 verified computer-assisted rigorous interval bounds"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource MathTextMutedBrush}" />
                                                <TextBlock Text="• Foundations: Tristan Buckmaster &amp; Levent Alpöge (NYU Euler/NS work)"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource MathTextMutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Yang-Mills Controls -->
                                    <StackPanel IsVisible="{Binding SelectedMillenniumProblem, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static millennium:MillenniumProblemType.YangMillsMassGap}}" Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="Coupling β:" FontSize="11" Width="85" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0.5" Maximum="6.0"
                                                    Value="{Binding MillenniumYangMillsBeta, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding MillenniumYangMillsBeta, StringFormat='{}{0:F2}'}"
                                                       FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetYangMillsCouplingCommand}" CommandParameter="strong">
                                                <TextBlock Text="Strong (Confinement)" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetYangMillsCouplingCommand}" CommandParameter="scaling">
                                                <TextBlock Text="Physical Scaling" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetYangMillsCouplingCommand}" CommandParameter="asymptotic">
                                                <TextBlock Text="Asymptotic Plasma" FontSize="10" />
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- P vs NP Controls -->
                                    <StackPanel IsVisible="{Binding SelectedMillenniumProblem, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static millennium:MillenniumProblemType.PversusNP}}" Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="Clause Ratio α:" FontSize="11" Width="85" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="1.0" Maximum="8.0"
                                                    Value="{Binding MillenniumSatAlpha, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding MillenniumSatAlpha, StringFormat='{}{0:F3}'}"
                                                       FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetSatClauseRatioCommand}" CommandParameter="easy_sat">
                                                <TextBlock Text="Easy SAT (α=3.2)" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetSatClauseRatioCommand}" CommandParameter="critical">
                                                <TextBlock Text="Critical (α_c=4.267)" FontSize="10" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetSatClauseRatioCommand}" CommandParameter="unsat">
                                                <TextBlock Text="UNSAT (α=5.8)" FontSize="10" />
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Hodge Controls -->
                                    <StackPanel IsVisible="{Binding SelectedMillenniumProblem, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static millennium:MillenniumProblemType.HodgeConjecture}}" Spacing="8">
                                        <TextBlock Text="Algebraic Variety Type:" FontSize="10" Foreground="{DynamicResource MathTextMutedBrush}" />
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetHodgeVarietyCommand}" CommandParameter="curve">
                                                <TextBlock Text="Curve (Dim 1)" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetHodgeVarietyCommand}" CommandParameter="k3">
                                                <TextBlock Text="K3 Surface (Dim 2)" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetHodgeVarietyCommand}" CommandParameter="calabiyau">
                                                <TextBlock Text="Calabi-Yau (Dim 3)" FontSize="10" />
                                            </Button>
                                            <Button Classes="mathaction" Margin="0,0,4,4" Padding="6,3"
                                                    Command="{Binding SetHodgeVarietyCommand}" CommandParameter="fermat">
                                                <TextBlock Text="Fermat 4-Fold (Dim 4)" FontSize="10" />
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 4. Rigorous Clay Proof, Solution & Attack Card -->
                            <Border Background="{DynamicResource MathCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MathBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource MathRadiusMd}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="MATHEMATICAL RIGOR, DERIVATIONS &amp; SOLUTIONS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MathTextMutedBrush}" />

                                    <TextBlock Text="{Binding ActiveMillenniumProblemInfo.SolutionOrCurrentAttack}"
                                               FontSize="10"
                                               FontFamily="Consolas, Menlo, monospace"
                                               Foreground="{DynamicResource MathTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource MathSurfaceBrush}"
                BorderBrush="{DynamicResource MathBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Laboratory: " FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" />
                    <TextBlock Text="{Binding ActiveLaboratory}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MathTextPrimaryBrush}" />
                    <TextBlock Text="•  CAS Symbolic Engine: Online" FontSize="11" Foreground="{DynamicResource MathTextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="Scroll to Zoom  •  Drag to Pan  •  Hover to Probe  •  Drag Pills to Set Bounds"
                               FontSize="11"
                               Foreground="{DynamicResource MathTextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</UserControl>
